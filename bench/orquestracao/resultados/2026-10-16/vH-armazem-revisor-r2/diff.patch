+from decimal import ROUND_DOWN, ROUND_HALF_EVEN, Decimal
 
 CENTAVO = Decimal("0.01")
+TAXA = Decimal("0.0199")  # ao mês, a partir de MIN_PARCELAS_JUROS parcelas
+MIN_PARCELAS_JUROS = 4
 
 
 @dataclass
@@ -17,16 +20,31 @@ class Parcela:
 def vencimento(primeira: date, k: int) -> date:
     """Vencimento da parcela k (1 = primeira)."""
     m = primeira.month - 1 + (k - 1)
-    d = primeira.replace(year=primeira.year + m // 12, month=m % 12 + 1)
+    ano, mes = primeira.year + m // 12, m % 12 + 1
+    d = date(ano, mes, min(primeira.day, calendar.monthrange(ano, mes)[1]))
     if d.weekday() >= 5:
         d += timedelta(days=7 - d.weekday())
     return d
 
 
-def parcelar(total, n: int, primeira: date):
+def _valores(total, n: int):
     if not isinstance(n, int) or not 1 <= n <= 12:
         raise ValueError("n deve estar entre 1 e 12")
     total = Decimal(str(total))
-    base = (total / n).quantize(CENTAVO, ROUND_DOWN)
-    valores = [base + (total - base * n)] + [base] * (n - 1)
+    if n < MIN_PARCELAS_JUROS:
+        base = (total / n).quantize(CENTAVO, ROUND_DOWN)
+        return [base + (total - base * n)] + [base] * (n - 1)
+    # tabela Price; os centavos que sobram ficam na última parcela
+    pmt = total * TAXA / (1 - (1 + TAXA) ** -n)
+    parcela = pmt.quantize(CENTAVO, ROUND_HALF_EVEN)
+    ultima = (pmt * n).quantize(CENTAVO, ROUND_HALF_EVEN) - parcela * (n - 1)
