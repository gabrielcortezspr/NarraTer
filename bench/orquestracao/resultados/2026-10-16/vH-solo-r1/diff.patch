+"""Tabela de câmbio para reais (docs/PEDIDO-MULTIMOEDA.md)."""
+
+import bisect
+import csv
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+COLUNAS = ("data", "moeda", "taxa")
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+class TabelaCambio:
+    def __init__(self, taxas: dict[str, dict[date, Decimal]] | None = None):
+        self._taxas: dict[str, list[tuple[date, Decimal]]] = {
+            moeda.upper(): sorted(por_data.items()) for moeda, por_data in (taxas or {}).items()
+        }
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        taxas: dict[str, dict[date, Decimal]] = {}
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            faltando = [c for c in COLUNAS if c not in (leitor.fieldnames or [])]
+            if faltando:
+                raise ErroCambio(f"câmbio: colunas ausentes: {', '.join(faltando)}")
+            for n, l in enumerate(leitor, start=2):
+                texto_data, moeda, texto_taxa = ((l.get(c) or "").strip() for c in COLUNAS)
+                try:
+                    dia = datetime.strptime(texto_data, "%d/%m/%Y").date()
+                except ValueError:
+                    raise ErroCambio(f"câmbio, linha {n}: data inválida '{texto_data}'") from None
+                if not moeda:
+                    raise ErroCambio(f"câmbio, linha {n}: moeda vazia")
+                if "." in texto_taxa:
+                    raise ErroCambio(f"câmbio, linha {n}: use vírgula decimal ('{texto_taxa}')")
+                try:
+                    taxa = Decimal(texto_taxa.replace(",", "."))
+                except InvalidOperation:
+                    raise ErroCambio(f"câmbio, linha {n}: taxa inválida '{texto_taxa}'") from None
+                if not taxa.is_finite() or taxa <= 0:
+                    raise ErroCambio(f"câmbio, linha {n}: taxa inválida '{texto_taxa}'")
+                taxas.setdefault(moeda.upper(), {})[dia] = taxa
+        return cls(taxas)
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        """Taxa da data ou, se não houver, da data anterior mais recente. BRL é sempre 1."""
+        moeda = moeda.strip().upper()
+        if moeda == "BRL":
+            return Decimal(1)
+        serie = self._taxas.get(moeda, [])
+        i = bisect.bisect_right(serie, data, key=lambda par: par[0])
+        if i == 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} até {data:%d/%m/%Y}")
+        return serie[i - 1][1]
