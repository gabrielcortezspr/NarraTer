@@ -0,0 +1,166 @@
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+from datetime import date
+from decimal import Decimal as D
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+from pedidos.importa import ErroImportacao, ler_pedidos
+from pedidos.modelo import Item, Pedido
+from pedidos.preco import calcular
+from pedidos.relatorio import main
+
+from .util import CABECALHO, csv_temp
+
+CAB_MOEDA = CABECALHO.rstrip("\n") + ",moeda\n"
+
+
+def cambio_temp(conteudo: str) -> str:
+    fd, caminho = tempfile.mkstemp(suffix=".csv")
+    with os.fdopen(fd, "w", encoding="utf-8") as f:
+        f.write("data,moeda,taxa\n" + conteudo)
+    return caminho
+
+
+TABELA = cambio_temp(
+    '02/03/2026,USD,"5,0125"\n'
+    '02/03/2026,EUR,"5,4410"\n'
+    '05/03/2026,USD,"5,0870"\n'
+    '09/03/2026,EUR,"5,5005"\n'
+)
+
+
+def rodar(*args):
+    out, err = io.StringIO(), io.StringIO()
+    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+        codigo = main(list(args))
+    return codigo, out.getvalue(), err.getvalue()
+
+
+class TestTabelaCambio(unittest.TestCase):
+    def setUp(self):
+        self.t = TabelaCambio.carregar(TABELA)
+
+    def test_taxa_da_propria_data(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 5)), D("5.0870"))
+        self.assertEqual(self.t.taxa("EUR", date(2026, 3, 2)), D("5.4410"))
+
+    def test_taxa_da_data_anterior_mais_recente(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 4)), D("5.0125"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 12, 31)), D("5.0870"))
+        self.assertEqual(self.t.taxa("EUR", date(2026, 3, 8)), D("5.4410"))
+
+    def test_brl_sempre_um(self):
+        self.assertEqual(self.t.taxa("BRL", date(2000, 1, 1)), D(1))
+
+    def test_sem_taxa_ate_a_data(self):
+        with self.assertRaisesRegex(ErroCambio, "USD"):
+            self.t.taxa("USD", date(2026, 3, 1))
+        with self.assertRaisesRegex(ErroCambio, "EUR"):
+            TabelaCambio().taxa("EUR", date(2026, 3, 1))
+
+    def test_erro_cambio_e_value_error(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+    def test_arquivo_de_exemplo(self):
+        t = TabelaCambio.carregar(os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv"))
+        self.assertEqual(t.taxa("EUR", date(2026, 3, 9)), D("5.5005"))
+
+    def test_taxa_invalida(self):
+        with self.assertRaises(ErroCambio):
+            TabelaCambio.carregar(cambio_temp("02/03/2026,USD,5.01\n"))
+
+
+class TestImportaMoeda(unittest.TestCase):
+    def test_sem_coluna_e_brl(self):
+        p = ler_pedidos(csv_temp('P-1,Ana,01/03/2026,A,1,"10,00",x\n'))[0]
+        self.assertEqual(p.moeda, "BRL")
+
+    def test_celula_vazia_e_brl_e_minuscula_aceita(self):
+        ps = ler_pedidos(
+            csv_temp('P-1,Ana,01/03/2026,A,1,"10,00",x,\nP-2,Ana,01/03/2026,A,1,"10,00",x,usd\n', CAB_MOEDA)
+        )
+        self.assertEqual([p.moeda for p in ps], ["BRL", "USD"])
+
+    def test_moeda_invalida_cita_linha(self):
+        with self.assertRaisesRegex(ErroImportacao, "linha 3"):
+            ler_pedidos(csv_temp('P-1,Ana,01/03/2026,A,1,"1,00",x,EUR\nP-2,Ana,01/03/2026,A,1,"1,00",x,GBP\n', CAB_MOEDA))
+
+    def test_moedas_misturadas_cita_pedido(self):
+        with self.assertRaisesRegex(ErroImportacao, "P-77"):
+            ler_pedidos(
+                csv_temp('P-77,Ana,01/03/2026,A,1,"1,00",x,EUR\nP-77,Ana,01/03/2026,B,1,"1,00",x,\n', CAB_MOEDA)
+            )
+
+
+class TestPrecoMoeda(unittest.TestCase):
+    def pedido(self, moeda, *itens, data=date(2026, 3, 4)):
+        return Pedido(id="P", cliente="X", data=data, itens=[Item(*i) for i in itens], moeda=moeda)
+
+    def test_converte_cada_linha_e_aplica_regras_em_reais(self):
+        t = TabelaCambio.carregar(TABELA)
+        # USD em 04/03 usa 5,0125: 100 × 2,10 × 5,0125 = 1052,625 → 1052,62 (meio-para-par)
+        p = self.pedido("USD", ("A", 100, D("2.10"), "livros"), ("B", 1, D("10.00"), "eletronicos"))
+        r = calcular(p, t)
+        self.assertEqual(r.subtotal_original, D("220.00"))
+        self.assertEqual(r.subtotal, D("1052.62") + D("50.12"))  # 50,125 → 50,12
+        # desconto por faixas em reais: 25 + 8% × 102,74 = 33,22
+        self.assertEqual(r.desconto, D("33.22"))
+        self.assertEqual(r.frete, D("0.00"))
+        self.assertEqual(r.moeda, "USD")
+
+    def test_estrangeiro_sem_tabela(self):
+        with self.assertRaisesRegex(ErroCambio, "EUR"):
+            calcular(self.pedido("EUR", ("A", 1, D("1.00"), "x")))
+
+    def test_brl_sem_tabela(self):
+        r = calcular(self.pedido("BRL", ("A", 1, D("10.00"), "livros")))
+        self.assertEqual(r.subtotal, D("10.00"))
+        self.assertEqual(r.subtotal_original, D("10.00"))
+
+
+class TestRelatorioMoeda(unittest.TestCase):
+    def setUp(self):
+        self.csv = csv_temp(
+            'P-1,Ana,02/03/2026,A,1,"100,00",livros,EUR\n'
+            'P-2,Beto,02/03/2026,B,1,"100,00",livros,\n',
+            CAB_MOEDA,
+        )
+
+    def test_json_com_cambio(self):
+        codigo, out, _ = rodar(self.csv, "--json", "--cambio", TABELA)
+        self.assertEqual(codigo, 0)
+        d = json.loads(out)
+        self.assertEqual(d[0]["moeda"], "EUR")
+        self.assertEqual(d[0]["subtotal_original"], "100.00")
+        self.assertEqual(d[0]["subtotal"], "544.10")
+        self.assertEqual(d[1]["moeda"], "BRL")
+
+    def test_texto_tem_coluna_moeda(self):
+        codigo, out, _ = rodar(self.csv, "--cambio", TABELA)
+        self.assertEqual(codigo, 0)
+        self.assertIn("moeda", out.splitlines()[0])
+        self.assertIn(" EUR ", out.splitlines()[1])
+
+    def test_estrangeiro_sem_cambio_sai_com_2(self):
+        codigo, _, err = rodar(self.csv)
+        self.assertEqual(codigo, 2)
+        self.assertTrue(err.startswith("erro:"))
+
+    def test_taxa_inexistente_sai_com_2(self):
+        c = csv_temp('P-1,Ana,01/03/2026,A,1,"1,00",x,USD\n', CAB_MOEDA)
+        codigo, _, err = rodar(c, "--cambio", TABELA)
+        self.assertEqual(codigo, 2)
+        self.assertIn("USD", err)
+
+    def test_arquivo_cambio_ausente_sai_com_2(self):
+        codigo, _, err = rodar(self.csv, "--cambio", "/nao/existe.csv")
+        self.assertEqual(codigo, 2)
+        self.assertTrue(err.startswith("erro:"))
+
+
+if __name__ == "__main__":
+    unittest.main()
