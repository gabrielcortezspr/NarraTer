+def _valores(total: Decimal, n: int):
+    if n <= MAX_SEM_JUROS:
+        base = (total / n).quantize(CENTAVO, ROUND_DOWN)
+        return [base + (total - base * n)] + [base] * (n - 1)
+    pmt = total * TAXA_JUROS / (1 - (1 + TAXA_JUROS) ** -n)
+    parcela = pmt.quantize(CENTAVO, ROUND_HALF_EVEN)
+    ultima = (pmt * n).quantize(CENTAVO, ROUND_HALF_EVEN) - parcela * (n - 1)
+    return [parcela] * (n - 1) + [ultima]
+
+
+def parcelar(total, n: int, primeira: date):
+    _valida_n(n)
+    valores = _valores(Decimal(str(total)), n)
     return [Parcela(k, vencimento(primeira, k), v) for k, v in enumerate(valores, start=1)]
+
