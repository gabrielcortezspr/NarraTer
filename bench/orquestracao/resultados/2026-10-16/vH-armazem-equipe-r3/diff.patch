+        c = cotar("01310-100", D("1"), D("100.00"))
+        self.assertEqual(c.tarifa, D("15.00"))
+
+    def test_limites_inclusivos(self):
+        self.assertEqual(cotar("01310100", D("5"), D("10")).tarifa, D("22.00"))
+        self.assertEqual(cotar("01310100", D("10"), D("10")).tarifa, D("35.00"))
+        self.assertEqual(cotar("01310100", D("10.01"), D("10")).tarifa, D("38.00"))
+
+    def test_arredonda_para_meio_kg_sem_dimensoes(self):
+        self.assertEqual(cotar("01310100", D("1.0"), D("10")).peso_cobrado, D("1.0"))
+        c = cotar("01310100", D("1.01"), D("10"))
+        self.assertEqual((c.peso_cobrado, c.tarifa), (D("1.5"), D("22.00")))
+
+    def test_peso_cubico_maior(self):
+        c = cotar("01310100", D("1"), D("10"), dimensoes=(50, 40, 30))  # 10 kg cúbicos
+        self.assertEqual((c.peso_cobrado, c.tarifa), (D("10"), D("35.00")))
+
+    def test_peso_informado_maior(self):
+        c = cotar("01310100", D("7"), D("10"), dimensoes=(10, 10, 10))
+        self.assertEqual(c.peso_cobrado, D("7"))
+
+    def test_cubico_arredonda_para_cima(self):
