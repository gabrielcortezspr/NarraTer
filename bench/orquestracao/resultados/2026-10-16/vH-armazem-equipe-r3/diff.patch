+        self.assertEqual(c.peso_cobrado, D("1.5"))
+
+    def test_excedente_usa_peso_cobrado(self):
+        # 10,2 kg -> 10,5 cobrado -> 1 kg excedente
+        self.assertEqual(cotar("01310100", D("10.2"), D("10")).tarifa, D("38.00"))
+
+    def test_gratis_usa_peso_cobrado(self):
+        self.assertEqual(cotar("01310100", D("30"), D("300")).tarifa, D("0.00"))
+        self.assertEqual(cotar("01310100", D("30.01"), D("300")).tarifa, D("35.00") + 21 * D("3.00"))
+        # peso cúbico de 36 kg tira o frete grátis
