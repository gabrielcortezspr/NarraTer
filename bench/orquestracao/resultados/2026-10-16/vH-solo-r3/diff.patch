+
+    def test_json_converte_e_mostra_original(self):
+        codigo, out, err = rodar(self.csv, "--json", "--cambio", self.cambio)
+        self.assertEqual(codigo, 0, err)
+        dados = json.loads(out)
+        self.assertEqual(dados[0]["moeda"], "BRL")
