+        self.assertEqual(dados[0]["total"], "137.00")
+        p2 = dados[1]
+        self.assertEqual(p2["moeda"], "USD")
+        self.assertEqual(p2["subtotal_original"], "100.00")
+        # 2 × 50 × 5,0870 = 508,70; desconto 5% × 8,70 = 0,435 → 0,44 (meio-para-par)
+        self.assertEqual(p2["subtotal"], "508.70")
+        self.assertEqual(p2["desconto"], "0.44")
+        self.assertEqual(p2["imposto"], "0.00")
+        self.assertEqual(p2["frete"], "0.00")
+        self.assertEqual(p2["total"], "508.26")
