@@ -0,0 +1,106 @@
+import os
+import unittest
+from datetime import date
+from decimal import Decimal as D
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+from pedidos.modelo import Item, Pedido
+from pedidos.preco import calcular
+
+from .util import csv_temp
+
+CAB = "data,moeda,taxa\n"
+EXEMPLO = os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv")
+
+
+def pedido(moeda, data, *itens):
+    return Pedido(id="P-9", cliente="X", data=data, itens=[Item(*i) for i in itens], moeda=moeda)
+
+
+class TestTabelaCambio(unittest.TestCase):
+    def setUp(self):
+        self.tabela = TabelaCambio.carregar(EXEMPLO)
+
+    def test_taxa_da_propria_data(self):
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 2)), D("5.0125"))
+        self.assertEqual(self.tabela.taxa("EUR", date(2026, 3, 9)), D("5.5005"))
+
+    def test_taxa_da_data_anterior_mais_recente(self):
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 4)), D("5.0125"))
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 31)), D("5.0870"))
+        self.assertEqual(self.tabela.taxa("EUR", date(2026, 3, 8)), D("5.4410"))
+
+    def test_moeda_sem_diferenciar_maiusculas(self):
+        self.assertEqual(self.tabela.taxa("usd", date(2026, 3, 2)), D("5.0125"))
+
+    def test_brl_sempre_1(self):
+        self.assertEqual(self.tabela.taxa("BRL", date(1990, 1, 1)), D(1))
+
+    def test_sem_taxa_anterior(self):
+        with self.assertRaisesRegex(ErroCambio, "USD"):
+            self.tabela.taxa("USD", date(2026, 3, 1))
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+    def test_arquivo_fora_de_ordem(self):
+        t = TabelaCambio.carregar(csv_temp('09/03/2026,USD,"6,00"\n01/03/2026,USD,"5,00"\n', cabecalho=CAB))
+        self.assertEqual(t.taxa("USD", date(2026, 3, 5)), D("5.00"))
+        self.assertEqual(t.taxa("USD", date(2026, 3, 10)), D("6.00"))
+
+    def test_taxa_invalida(self):
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            TabelaCambio.carregar(csv_temp("01/03/2026,USD,5.00\n", cabecalho=CAB))
+
+
+class TestCalculoMultimoeda(unittest.TestCase):
+    def setUp(self):
+        self.tabela = TabelaCambio.carregar(EXEMPLO)
+
+    def test_brl_sem_tabela(self):
+        r = calcular(pedido("BRL", date(2026, 3, 1), ("A", 3, D("10.00"), "papelaria")))
+        self.assertEqual(r.total, D("58.60"))
+        self.assertEqual(r.subtotal_original, D("30.00"))
+
+    def test_estrangeiro_sem_tabela(self):
+        with self.assertRaisesRegex(ErroCambio, "EUR"):
+            calcular(pedido("EUR", date(2026, 3, 9), ("A", 1, D("1.00"), "x")))
+
+    def test_converte_cada_linha_e_arredonda(self):
+        # 3 × 1,25 × 5,0125 = 18,796875 → 18,80; 1 × 0,10 × 5,0125 = 0,50125 → 0,50
+        r = calcular(
+            pedido("USD", date(2026, 3, 3), ("A", 3, D("1.25"), "livros"), ("B", 1, D("0.10"), "livros")),
+            self.tabela,
+        )
+        self.assertEqual(r.subtotal, D("19.30"))
+        self.assertEqual(r.subtotal_original, D("3.85"))
+        self.assertEqual(r.moeda, "USD")
+
+    def test_arredonda_meio_para_par_na_conversao(self):
+        t = TabelaCambio.carregar(csv_temp('01/03/2026,USD,"5,0500"\n', cabecalho=CAB))
+        # 1 × 0,05 × 5,05 = 0,2525 → 0,25 ; 1 × 0,07 × 5,05 = 0,3535 → 0,35 (meio-para-par)
+        r = calcular(pedido("USD", date(2026, 3, 1), ("A", 1, D("0.05"), "livros"), ("B", 1, D("0.07"), "livros")), t)
+        self.assertEqual(r.subtotal, D("0.25") + D("0.35"))
+
+    def test_regras_em_reais_apos_conversao(self):
+        # 240 USD × 5,0000 = 1.200,00 BRL → desconto por faixas 41,00; frete grátis
+        t = TabelaCambio.carregar(csv_temp('01/03/2026,EUR,"5,0000"\n', cabecalho=CAB))
+        r = calcular(pedido("EUR", date(2026, 3, 1), ("A", 1, D("240.00"), "eletronicos")), t)
+        self.assertEqual(r.subtotal, D("1200.00"))
+        self.assertEqual(r.desconto, D("41.00"))
+        self.assertEqual(r.imposto, D("139.08"))  # 12% × 1159
+        self.assertEqual(r.frete, D("0.00"))
+        self.assertEqual(r.total, D("1298.08"))
+        self.assertEqual(r.subtotal_original, D("240.00"))
+
+    def test_frete_em_reais(self):
+        # 50 USD × 5,0125 = 250,625 → 250,62 (meio-para-par) < 300 → paga frete
+        r = calcular(pedido("USD", date(2026, 3, 2), ("A", 1, D("50.00"), "livros")), self.tabela)
+        self.assertEqual(r.subtotal, D("250.62"))
+        self.assertEqual(r.frete, D("25.00"))
+
+    def test_sem_taxa_para_data(self):
+        with self.assertRaises(ErroCambio):
+            calcular(pedido("USD", date(2026, 2, 1), ("A", 1, D("1.00"), "x")), self.tabela)
+
+
+if __name__ == "__main__":
+    unittest.main()
