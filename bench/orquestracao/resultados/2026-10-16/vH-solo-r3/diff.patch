+"""Tabela de câmbio (docs/PEDIDO-MULTIMOEDA.md): quantos reais vale 1 unidade de cada moeda."""
+
+import bisect
+import csv
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+MOEDAS = ("BRL", "USD", "EUR")
+COLUNAS = ("data", "moeda", "taxa")
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+class TabelaCambio:
+    def __init__(self, taxas=None):
+        """`taxas`: iterável de (moeda, data, taxa)."""
+        self._datas: dict[str, list[date]] = {}
+        self._taxas: dict[str, list[Decimal]] = {}
+        for moeda, dia, taxa in sorted(taxas or [], key=lambda t: (t[0].upper(), t[1])):
+            moeda = moeda.upper()
+            datas = self._datas.setdefault(moeda, [])
+            valores = self._taxas.setdefault(moeda, [])
+            if datas and datas[-1] == dia:
+                valores[-1] = Decimal(taxa)
+            else:
+                datas.append(dia)
+                valores.append(Decimal(taxa))
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            faltando = [c for c in COLUNAS if c not in (leitor.fieldnames or [])]
+            if faltando:
+                raise ErroCambio(f"câmbio: colunas ausentes: {', '.join(faltando)}")
+            taxas = []
+            for n, l in enumerate(leitor, start=2):
+                l = {k: (v or "") for k, v in l.items() if k is not None}
+                try:
+                    dia = datetime.strptime(l["data"].strip(), "%d/%m/%Y").date()
+                except ValueError:
+                    raise ErroCambio(f"câmbio, linha {n}: data inválida '{l['data']}'") from None
+                moeda = l["moeda"].strip().upper()
+                if moeda not in MOEDAS:
+                    raise ErroCambio(f"câmbio, linha {n}: moeda inválida '{l['moeda']}'")
+                t = l["taxa"].strip()
+                try:
+                    if "." in t:
+                        raise InvalidOperation
+                    taxa = Decimal(t.replace(",", "."))
+                except InvalidOperation:
+                    raise ErroCambio(f"câmbio, linha {n}: taxa inválida '{l['taxa']}'") from None
+                if not taxa.is_finite() or taxa <= 0:
+                    raise ErroCambio(f"câmbio, linha {n}: taxa inválida '{l['taxa']}'")
+                taxas.append((moeda, dia, taxa))
+        return cls(taxas)
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        """Taxa da data ou da data anterior mais recente; BRL é sempre 1."""
+        moeda = moeda.upper()
+        if moeda == "BRL":
+            return Decimal(1)
+        datas = self._datas.get(moeda, [])
+        i = bisect.bisect_right(datas, data)
+        if i == 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} até {data:%d/%m/%Y}")
+        return self._taxas[moeda][i - 1]
