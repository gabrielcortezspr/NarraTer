+"""Tabela de câmbio (docs/PEDIDO-MULTIMOEDA.md): quantos reais vale 1 unidade de cada moeda."""
+
+import bisect
+import csv
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+MOEDAS = ("BRL", "USD", "EUR")
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+class TabelaCambio:
+    def __init__(self, taxas=None):
+        # moeda -> lista ordenada de (data, taxa)
+        self._taxas: dict[str, list[tuple[date, Decimal]]] = {}
+        for (moeda, dia), taxa in (taxas or {}).items():
+            self.adicionar(moeda, dia, taxa)
+
+    def adicionar(self, moeda: str, dia: date, taxa: Decimal) -> None:
+        serie = self._taxas.setdefault(moeda.strip().upper(), [])
+        i = bisect.bisect_left(serie, dia, key=lambda t: t[0])
+        if i < len(serie) and serie[i][0] == dia:
+            serie[i] = (dia, taxa)
+        else:
+            serie.insert(i, (dia, taxa))
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        tabela = cls()
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            faltando = [c for c in ("data", "moeda", "taxa") if c not in (leitor.fieldnames or [])]
+            if faltando:
+                raise ErroCambio(f"{caminho}: colunas ausentes: {', '.join(faltando)}")
+            for n, l in enumerate(leitor, start=2):
+                texto_data, moeda, texto_taxa = ((l.get(c) or "").strip() for c in ("data", "moeda", "taxa"))
+                try:
+                    dia = datetime.strptime(texto_data, "%d/%m/%Y").date()
+                except ValueError:
+                    raise ErroCambio(f"{caminho}, linha {n}: data inválida '{texto_data}'") from None
+                if "." in texto_taxa:
+                    raise ErroCambio(f"{caminho}, linha {n}: use vírgula decimal ('{texto_taxa}')")
+                try:
+                    taxa = Decimal(texto_taxa.replace(",", "."))
+                except InvalidOperation:
+                    raise ErroCambio(f"{caminho}, linha {n}: taxa inválida '{texto_taxa}'") from None
+                if not taxa.is_finite() or taxa <= 0:
+                    raise ErroCambio(f"{caminho}, linha {n}: taxa inválida '{texto_taxa}'")
+                if not moeda:
+                    raise ErroCambio(f"{caminho}, linha {n}: moeda vazia")
+                tabela.adicionar(moeda, dia, taxa)
+        return tabela
+
+    def taxa(self, moeda: str, dia: date) -> Decimal:
+        """Taxa da data ou, se não houver, da data anterior mais recente. BRL é sempre 1."""
+        moeda = moeda.strip().upper()
+        if moeda == "BRL":
+            return Decimal(1)
+        serie = self._taxas.get(moeda, [])
+        i = bisect.bisect_right(serie, dia, key=lambda t: t[0])
+        if i == 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} em {dia:%d/%m/%Y} ou antes")
+        return serie[i - 1][1]
