+            cabecalho=CAB_MOEDA,
+        )
+
+    def test_json_com_moeda(self):
+        codigo, out, _ = rodar(self.csv, "--json", "--cambio", CAMBIO_EXEMPLO)
+        self.assertEqual(codigo, 0)
+        p1, p2 = json.loads(out)
+        self.assertEqual((p1["moeda"], p1["subtotal_original"], p1["total"]), ("BRL", "100.00", "137.00"))
+        self.assertEqual(p2["moeda"], "USD")
+        self.assertEqual(p2["subtotal_original"], "20.00")
+        self.assertEqual(p2["subtotal"], "100.25")  # 20 × 5,0125
+        self.assertEqual(p2["total"], "125.25")
