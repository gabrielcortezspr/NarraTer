+
+    def test_frete_gratis_usa_peso_cobrado(self):
+        # 30,2 kg informado vira 30,5 kg cobrado: acima do limite do frete grátis
+        self.assertEqual(cotar("01310100", D("30.2"), D("300.00")).tarifa, D("35.00") + 21 * D("3.00"))
