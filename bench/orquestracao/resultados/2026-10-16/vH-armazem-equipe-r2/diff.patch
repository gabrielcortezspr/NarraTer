+class TestPesoCubico(unittest.TestCase):
+    def test_limites_inclusivos_reclamacao_1kg(self):
+        # 1 kg exato é "até 1 kg" (SE: 15,00), não "até 5 kg"
+        self.assertEqual(cotar("01310-100", D("1"), D("100")).tarifa, D("15.00"))
+        self.assertEqual(cotar("01310-100", D("5"), D("100")).tarifa, D("22.00"))
+        self.assertEqual(cotar("01310-100", D("10"), D("100")).tarifa, D("35.00"))
+        self.assertEqual(cotar("01310-100", D("1.01"), D("100")).tarifa, D("22.00"))
+
+    def test_arredondamento_meio_kg_sem_dimensoes(self):
+        self.assertEqual(cotar("01310-100", D("1.01"), D("10")).peso_cobrado, D("1.5"))
+        self.assertEqual(cotar("01310-100", D("1.0"), D("10")).peso_cobrado, D("1.0"))
+        self.assertEqual(cotar("01310-100", D("0.2"), D("10")).peso_cobrado, D("0.5"))
+
+    def test_peso_cubico_maior(self):
+        # 50x40x30 / 6000 = 10 kg; peso real 2 kg
+        c = cotar("01310-100", D("2"), D("100"), (50, 40, 30))
+        self.assertEqual((c.peso_cobrado, c.tarifa), (D("10"), D("35.00")))
+
+    def test_peso_real_maior_que_cubico(self):
+        c = cotar("01310-100", D("4"), D("100"), (10, 10, 10))
+        self.assertEqual(c.peso_cobrado, D("4"))
+
+    def test_cubico_arredonda_para_cima(self):
+        # 30x20x11 / 6000 = 1.1 -> 1.5
+        self.assertEqual(cotar("01310-100", D("0.5"), D("10"), (30, 20, 11)).peso_cobrado, D("1.5"))
+
+    def test_excedente_usa_peso_cobrado(self):
+        # 60x50x30 / 6000 = 15 kg -> 35 + 5*3
+        self.assertEqual(cotar("01310-100", D("1"), D("100"), (60, 50, 30)).tarifa, D("50.00"))
+        # 10,2 kg -> 10,5 -> 1 kg excedente
+        self.assertEqual(cotar("01310-100", D("10.2"), D("100")).tarifa, D("38.00"))
+
+    def test_frete_gratis_usa_peso_cobrado(self):
+        # real 5 kg, cúbico 40x40x40/6000 = 10,67 -> 11 kg, ainda grátis
+        self.assertEqual(cotar("01310-100", D("5"), D("300"), (40, 40, 40)).tarifa, D("0.00"))
+        # cúbico 100x100x100/6000 = 166,67 kg > 30: pago
+        c = cotar("01310-100", D("5"), D("300"), (100, 100, 100))
+        self.assertEqual(c.peso_cobrado, D("167"))
+        self.assertGreater(c.tarifa, 0)
+        # limite: exatamente 30 kg é grátis; 30,01 não
+        self.assertEqual(cotar("01310-100", D("30"), D("300")).tarifa, D("0.00"))
+        self.assertGreater(cotar("01310-100", D("30.01"), D("300")).tarifa, 0)
+
+    def test_seguro_e_total(self):
+        c = cotar("01310-100", D("1"), D("300"), (10, 10, 10))
+        self.assertEqual((c.tarifa, c.seguro, c.total), (D("0.00"), D("1.50"), D("1.50")))
