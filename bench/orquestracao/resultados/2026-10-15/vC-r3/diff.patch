+
+class TestCalculoMultimoeda(unittest.TestCase):
+    def pedido(self, itens, moeda="USD"):
+        return Pedido("P", "A", date(2026, 3, 6), moeda, itens)
+
+    def test_conversao_por_linha_arredonda_cada_linha(self):
+        # 3 x 0,10 x 5,0870 = 1,5261 -> 1,53 ; 1 x 0,10 x 5,0870 = 0,5087 -> 0,51
+        itens = [Item("a", 3, Decimal("0.10"), "x"), Item("b", 1, Decimal("0.10"), "x")]
+        r = calcular(self.pedido(itens), tabela())
+        self.assertEqual(r.subtotal, Decimal("2.04"))
+
+    def test_meio_para_par(self):
+        t = TabelaCambio([(date(2026, 1, 1), "USD", Decimal("0.5"))])
+        r = calcular(self.pedido([Item("a", 1, Decimal("0.05"), "x"), Item("b", 1, Decimal("0.07"), "x")]), t)
+        # 0,025 -> 0,02 ; 0,035 -> 0,04
+        self.assertEqual(r.subtotal, Decimal("0.06"))
+
