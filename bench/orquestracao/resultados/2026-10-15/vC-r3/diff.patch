+        c = csv_temp(
+            'P-9,A,01/03/2026,X,1,"10,00",x,USD\nP-1,A,01/03/2026,X,1,"10,00",x,USD\n'
+            'P-9,A,01/03/2026,Y,1,"10,00",x,EUR\n',
