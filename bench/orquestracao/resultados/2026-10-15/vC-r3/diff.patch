+"""Tabela de câmbio (docs/PEDIDO-MULTIMOEDA.md). Taxas em reais por unidade da moeda."""
+
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+class TabelaCambio:
+    def __init__(self, taxas=None):
+        """`taxas`: iterável de (data, moeda, Decimal)."""
+        self._taxas: dict[str, list[tuple[date, Decimal]]] = {}
+        for data, moeda, taxa in taxas or ():
+            self._taxas.setdefault(moeda.upper(), []).append((data, taxa))
+        for lista in self._taxas.values():
+            lista.sort(key=lambda t: t[0])
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        taxas = []
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            faltando = [c for c in ("data", "moeda", "taxa") if c not in (leitor.fieldnames or [])]
+            if faltando:
+                raise ErroCambio(f"câmbio: colunas ausentes: {', '.join(faltando)}")
+            vistos = set()
+            for n, l in enumerate(leitor, start=2):
+                texto = (l["taxa"] or "").strip()
+                if "." in texto:
+                    raise ErroCambio(f"câmbio, linha {n}: use vírgula decimal na taxa ('{texto}')")
+                try:
+                    data = datetime.strptime((l["data"] or "").strip(), "%d/%m/%Y").date()
+                    taxa = Decimal(texto.replace(",", "."))
+                except (ValueError, InvalidOperation):
+                    raise ErroCambio(f"câmbio, linha {n}: data ou taxa inválida") from None
+                if not taxa.is_finite():
+                    raise ErroCambio(f"câmbio, linha {n}: taxa inválida")
+                if taxa <= 0:
+                    raise ErroCambio(f"câmbio, linha {n}: taxa deve ser positiva")
+                moeda = (l["moeda"] or "").strip().upper()
+                if (moeda, data) in vistos:
+                    raise ErroCambio(f"câmbio, linha {n}: taxa duplicada para {moeda} em {data:%d/%m/%Y}")
+                vistos.add((moeda, data))
+                taxas.append((data, moeda, taxa))
+        return cls(taxas)
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        moeda = moeda.upper()
+        if moeda == "BRL":
+            return Decimal(1)
+        lista = self._taxas.get(moeda, [])
+        i = bisect_right([d for d, _ in lista], data)
+        if i == 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} até {data:%d/%m/%Y}")
+        return lista[i - 1][1]
