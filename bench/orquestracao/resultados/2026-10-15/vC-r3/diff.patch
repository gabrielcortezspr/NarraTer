+        c = csv_temp(
+            'P-1,A,06/03/2026,X,1,"10,00",x,usd\nP-2,B,06/03/2026,X,1,"10,00",x,\n'
+            'P-1,A,06/03/2026,Y,1,"10,00",x,USD\n',
