+import json
+import os
+import tempfile
+import unittest
+from datetime import date
+from decimal import Decimal
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+from pedidos.importa import ErroImportacao, ler_pedidos
+from pedidos.modelo import Item, Pedido
+from pedidos.preco import calcular
+
+from .test_relatorio import rodar
+from .util import CABECALHO, csv_temp
+
+CAMBIO = (
+    "data,moeda,taxa\n"
+    '02/03/2026,USD,"5,0125"\n'
+    '05/03/2026,USD,"5,0870"\n'
+    '09/03/2026,EUR,"5,5005"\n'
+)
+CAB_MOEDA = CABECALHO.strip() + ",moeda\n"
+
+
+def tabela():
+    caminho = csv_temp("", cabecalho=CAMBIO)
+    return TabelaCambio.carregar(caminho)
+
+
+class TestImportaMoeda(unittest.TestCase):
+    def test_padrao_brl_sem_coluna(self):
+        p = ler_pedidos(csv_temp('P-1,A,01/03/2026,X,1,"10,00",x\n'))[0]
+        self.assertEqual(p.moeda, "BRL")
+
+    def test_celula_vazia_e_minuscula(self):
+        c = csv_temp('P-1,A,01/03/2026,X,1,"10,00",x,\nP-2,A,01/03/2026,X,1,"10,00",x,usd\n', CAB_MOEDA)
+        self.assertEqual([p.moeda for p in ler_pedidos(c)], ["BRL", "USD"])
+
+    def test_moeda_invalida_com_linha(self):
+        c = csv_temp('P-1,A,01/03/2026,X,1,"10,00",x,\nP-2,A,01/03/2026,X,1,"10,00",x,GBP\n', CAB_MOEDA)
+        with self.assertRaisesRegex(ErroImportacao, "linha 3"):
+            ler_pedidos(c)
+
+    def test_moedas_misturadas_no_pedido(self):
+        c = csv_temp('P-9,A,01/03/2026,X,1,"10,00",x,USD\nP-9,A,01/03/2026,Y,1,"10,00",x,EUR\n', CAB_MOEDA)
+        with self.assertRaisesRegex(ErroImportacao, "P-9"):
+            ler_pedidos(c)
+
+    def test_moeda_em_branco_numa_linha_difere_de_usd(self):
+        c = csv_temp('P-9,A,01/03/2026,X,1,"10,00",x,USD\nP-9,A,01/03/2026,Y,1,"10,00",x,\n', CAB_MOEDA)
+        with self.assertRaisesRegex(ErroImportacao, "P-9"):
+            ler_pedidos(c)
+
+
