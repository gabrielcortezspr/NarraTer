+import contextlib
+import io
+import json
+import unittest
+from datetime import date
+from decimal import Decimal as D
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+from pedidos.importa import ErroImportacao, ler_pedidos
+from pedidos.modelo import Item, Pedido
+from pedidos.preco import calcular
+from pedidos.relatorio import main
+
+from .util import CABECALHO, csv_temp
+
+CAB_MOEDA = CABECALHO.rstrip("\n") + ",moeda\n"
+CAMBIO = "data,moeda,taxa\n" '02/03/2026,USD,"5,0125"\n' '05/03/2026,USD,"5,0870"\n' '02/03/2026,EUR,"5,4410"\n'
+
+
+def tabela():
+    return TabelaCambio.carregar(csv_temp(CAMBIO[len("data,moeda,taxa\n"):], "data,moeda,taxa\n"))
+
+
+def rodar(*args):
+    out, err = io.StringIO(), io.StringIO()
+    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+        codigo = main(list(args))
+    return codigo, out.getvalue(), err.getvalue()
+
+
+class TestImportaMoeda(unittest.TestCase):
+    def test_sem_coluna_e_brl(self):
+        p = ler_pedidos(csv_temp('P-1,Ana,01/03/2026,A,1,"10,00",papelaria\n'))[0]
+        self.assertEqual(p.moeda, "BRL")
+
+    def test_celula_vazia_e_minusculas(self):
+        c = csv_temp(
+            'P-1,Ana,01/03/2026,A,1,"10,00",papelaria,\n'
+            'P-2,Ana,01/03/2026,A,1,"10,00",papelaria,usd\n',
+            CAB_MOEDA,
+        )
+        self.assertEqual([p.moeda for p in ler_pedidos(c)], ["BRL", "USD"])
+
+    def test_moeda_invalida_cita_linha(self):
+        c = csv_temp(
+            'P-1,Ana,01/03/2026,A,1,"10,00",papelaria,BRL\n'
+            'P-2,Ana,01/03/2026,A,1,"10,00",papelaria,GBP\n',
+            CAB_MOEDA,
+        )
+        with self.assertRaisesRegex(ErroImportacao, "linha 3"):
+            ler_pedidos(c)
+
+    def test_moedas_misturadas_no_pedido_citam_id(self):
+        c = csv_temp(
+            'P-9,Ana,01/03/2026,A,1,"10,00",papelaria,USD\n'
+            'P-2,Ana,01/03/2026,A,1,"10,00",papelaria,USD\n'
+            'P-9,Ana,01/03/2026,B,1,"10,00",papelaria,EUR\n',
+            CAB_MOEDA,
+        )
+        with self.assertRaisesRegex(ErroImportacao, "P-9"):
+            ler_pedidos(c)
+
+    def test_vazio_e_brl_explicito_sao_a_mesma_moeda(self):
+        c = csv_temp(
+            'P-1,Ana,01/03/2026,A,1,"10,00",papelaria,\n'
+            'P-1,Ana,01/03/2026,B,1,"10,00",papelaria,BRL\n',
+            CAB_MOEDA,
+        )
+        self.assertEqual(ler_pedidos(c)[0].moeda, "BRL")
+
+
+class TestCambio(unittest.TestCase):
+    def test_taxa_exata_e_anterior(self):
+        t = tabela()
+        self.assertEqual(t.taxa("USD", date(2026, 3, 2)), D("5.0125"))
+        self.assertEqual(t.taxa("USD", date(2026, 3, 4)), D("5.0125"))
+        self.assertEqual(t.taxa("USD", date(2026, 3, 5)), D("5.0870"))
+        self.assertEqual(t.taxa("usd", date(2026, 4, 1)), D("5.0870"))
+
+    def test_brl_sempre_um(self):
+        self.assertEqual(tabela().taxa("BRL", date(2000, 1, 1)), D(1))
+
+    def test_sem_taxa_ate_a_data(self):
+        with self.assertRaisesRegex(ErroCambio, "USD"):
+            tabela().taxa("USD", date(2026, 3, 1))
+        with self.assertRaisesRegex(ErroCambio, "EUR"):
+            tabela().taxa("EUR", date(2026, 3, 1))
+
+    def test_taxa_com_ponto_rejeitada_com_linha(self):
+        c = csv_temp('02/03/2026,USD,"5,00"\n05/03/2026,USD,"5.08"\n', "data,moeda,taxa\n")
+        with self.assertRaisesRegex(ErroCambio, "linha 3"):
+            TabelaCambio.carregar(c)
+
+    def test_data_moeda_duplicada_rejeitada(self):
+        c = csv_temp('02/03/2026,USD,"5,00"\n02/03/2026,usd,"5,10"\n', "data,moeda,taxa\n")
+        with self.assertRaisesRegex(ErroCambio, "linha 3"):
+            TabelaCambio.carregar(c)
+
+    def test_erro_cambio_e_value_error(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+    def test_moeda_vazia_ou_ausente_cita_linha(self):
+        vazia = csv_temp('02/03/2026,,"5,0"\n', "data,moeda,taxa\n")
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            TabelaCambio.carregar(vazia)
+        ausente = csv_temp("02/03/2026\n", "data,moeda,taxa\n")
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            TabelaCambio.carregar(ausente)
+
+    def test_exemplo_do_repositorio(self):
+        self.assertEqual(TabelaCambio.carregar("dados/cambio.csv").taxa("EUR", date(2026, 3, 10)), D("5.5005"))
+
+
+def pedido(moeda, *itens):
+    return Pedido("P", "Ana", date(2026, 3, 3), [Item("S", q, p, c) for q, p, c in itens], moeda)
+
+
+class TestCalculoMoeda(unittest.TestCase):
+    def test_conversao_por_linha_e_regras_em_reais(self):
+        p = pedido("USD", (3, D("100.10"), "eletronicos"), (2, D("10.00"), "livros"))
+        r = calcular(p, tabela())
+        l1 = (D("300.30") * D("5.0125")).quantize(D("0.01"))
+        l2 = (D("20.00") * D("5.0125")).quantize(D("0.01"))
+        self.assertEqual(r.subtotal, l1 + l2)
+        desc = (D(500) * D("0.05") + (r.subtotal - 1000) * D("0.08")).quantize(D("0.01"))
+        self.assertEqual(r.desconto, desc)
+        self.assertEqual(r.frete, D("0.00"))
+        imposto = (D("0.12") * l1 * (r.subtotal - desc) / r.subtotal).quantize(D("0.01"))
+        self.assertEqual(r.imposto, imposto)
+        self.assertEqual(r.total, r.subtotal - desc + imposto)
+
+    def test_arredonda_cada_linha_meio_para_par(self):
+        t = TabelaCambio({"USD": {date(2026, 3, 1): D("0.5")}})
+        # 1 × 0,05 × 0,5 = 0,025 -> 0,02 (par); 3 linhas = 0,06 (somar antes daria 0,08)
+        p = pedido("USD", *[(1, D("0.05"), "papelaria")] * 3)
+        self.assertEqual(calcular(p, t).subtotal, D("0.06"))
+
+    def test_moeda_minuscula_em_pedido_manual(self):
+        self.assertEqual(calcular(pedido("brl", (1, D("10.00"), "papelaria"))).subtotal, D("10.00"))
+        self.assertEqual(calcular(pedido("usd", (1, D("10.00"), "papelaria")), tabela()).subtotal, D("50.12"))
+
+    def test_sem_tabela_erro_e_brl_funciona(self):
+        with self.assertRaises(ErroCambio):
+            calcular(pedido("EUR", (1, D("10.00"), "papelaria")))
+        self.assertEqual(calcular(pedido("BRL", (1, D("10.00"), "papelaria"))).subtotal, D("10.00"))
+
+    def test_taxa_inexistente(self):
