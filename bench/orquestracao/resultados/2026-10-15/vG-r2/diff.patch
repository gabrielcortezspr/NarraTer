+"""Tabela de câmbio (docs/PEDIDO-MULTIMOEDA.md). Taxas em reais por unidade da moeda."""
+
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+class TabelaCambio:
+    def __init__(self, taxas: dict[str, dict[date, Decimal]] | None = None):
+        self._datas: dict[str, list[date]] = {}
+        self._taxas: dict[str, list[Decimal]] = {}
+        for moeda, por_data in (taxas or {}).items():
+            moeda = moeda.upper()
+            datas = sorted(por_data)
+            self._datas[moeda] = datas
+            self._taxas[moeda] = [por_data[d] for d in datas]
+
+    @classmethod
+    def carregar(cls, caminho: str) -> "TabelaCambio":
+        taxas: dict[str, dict[date, Decimal]] = {}
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            for numero, linha in enumerate(leitor, start=2):
+                try:
+                    data = datetime.strptime(linha["data"].strip(), "%d/%m/%Y").date()
+                    moeda = linha["moeda"].strip().upper()
+                    taxa = Decimal(linha["taxa"].strip().replace(",", "."))
+                except (KeyError, AttributeError, ValueError, InvalidOperation):
+                    raise ErroCambio(f"câmbio, linha {numero}: formato inválido") from None
+                if not moeda or not taxa.is_finite() or taxa <= 0:
+                    raise ErroCambio(f"câmbio, linha {numero}: formato inválido")
+                taxas.setdefault(moeda, {})[data] = taxa
+        return cls(taxas)
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        moeda = moeda.strip().upper()
+        if moeda == "BRL":
+            return Decimal(1)
+        datas = self._datas.get(moeda, [])
+        i = bisect_right(datas, data)
+        if i == 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} em {data:%d/%m/%Y}")
+        return self._taxas[moeda][i - 1]
