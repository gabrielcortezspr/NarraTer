+import unittest
+from datetime import date
+from decimal import Decimal
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+from tests.util import csv_temp
+
+CAB = "data,moeda,taxa\n"
+CONTEUDO = (
+    '02/03/2026,USD,"5,0125"\n'
+    '02/03/2026,EUR,"5,4410"\n'
+    '05/03/2026,USD,"5,0870"\n'
+    '09/03/2026,EUR,"5,5005"\n'
+)
+
+
+def tabela(conteudo=CONTEUDO):
+    return TabelaCambio.carregar(csv_temp(conteudo, CAB))
+
+
+class TestCambio(unittest.TestCase):
+    def test_data_exata(self):
+        self.assertEqual(tabela().taxa("USD", date(2026, 3, 5)), Decimal("5.0870"))
+
+    def test_data_anterior_mais_recente(self):
+        t = tabela()
+        self.assertEqual(t.taxa("USD", date(2026, 3, 4)), Decimal("5.0125"))
+        self.assertEqual(t.taxa("USD", date(2026, 12, 31)), Decimal("5.0870"))
+        self.assertEqual(t.taxa("EUR", date(2026, 3, 8)), Decimal("5.4410"))
+
+    def test_linhas_fora_de_ordem(self):
+        t = tabela('05/03/2026,USD,"5,0870"\n02/03/2026,USD,"5,0125"\n')
+        self.assertEqual(t.taxa("USD", date(2026, 3, 3)), Decimal("5.0125"))
+
+    def test_minusculas(self):
+        t = tabela('02/03/2026,usd,"5,0125"\n')
+        self.assertEqual(t.taxa("USD", date(2026, 3, 2)), Decimal("5.0125"))
+        self.assertEqual(t.taxa("usd", date(2026, 3, 2)), Decimal("5.0125"))
+
+    def test_brl_sempre_um(self):
+        self.assertEqual(tabela().taxa("BRL", date(2000, 1, 1)), Decimal(1))
+        self.assertEqual(TabelaCambio().taxa("BRL", date(2026, 1, 1)), Decimal(1))
+
+    def test_antes_da_primeira_taxa(self):
+        with self.assertRaises(ErroCambio) as ctx:
+            tabela().taxa("USD", date(2026, 3, 1))
+        self.assertIn("USD", str(ctx.exception))
+
+    def test_moeda_sem_taxa(self):
+        with self.assertRaises(ErroCambio) as ctx:
+            tabela().taxa("EUR", date(2026, 3, 1))
+        self.assertIn("EUR", str(ctx.exception))
+
+    def test_erro_e_value_error(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+    def test_arquivo_invalido(self):
+        for linha in ['xx/03/2026,USD,"5,0"\n', '02/03/2026,USD,"abc"\n', '02/03/2026,USD,"0"\n']:
+            with self.assertRaises(ErroCambio):
+                tabela(linha)
+
+    def test_arquivo_exemplo(self):
+        t = TabelaCambio.carregar("dados/cambio.csv")
+        self.assertEqual(t.taxa("EUR", date(2026, 3, 9)), Decimal("5.5005"))
+
+
+if __name__ == "__main__":
+    unittest.main()
