+import contextlib
+import io
+import json
+import unittest
+from datetime import date
+from decimal import Decimal as D
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+from pedidos.importa import ErroImportacao, ler_pedidos
+from pedidos.modelo import Item, Pedido
+from pedidos.preco import calcular
+from pedidos.relatorio import main
+
+from .util import CABECALHO, csv_temp
+
+CAMBIO = (
+    "data,moeda,taxa\n"
+    '02/03/2026,USD,"5,0125"\n'
+    '05/03/2026,USD,"5,0870"\n'
+    '02/03/2026,EUR,"5,4410"\n'
+)
+
+
+def rodar(*args):
+    out, err = io.StringIO(), io.StringIO()
+    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+        codigo = main(list(args))
+    return codigo, out.getvalue(), err.getvalue()
+
+
+def tabela():
+    return TabelaCambio.carregar(csv_temp("", cabecalho=CAMBIO))
+
+
+class TestImportacaoMoeda(unittest.TestCase):
+    def test_sem_coluna_e_brl(self):
+        p = ler_pedidos(csv_temp('P-1,A,01/03/2026,X,1,"10,00",livros\n'))[0]
+        self.assertEqual(p.moeda, "BRL")
+
+    def test_coluna_opcional_vazia_e_minuscula(self):
+        c = csv_temp(
+            'P-1,A,01/03/2026,X,1,"10,00",livros,\nP-2,A,01/03/2026,X,1,"10,00",livros,usd\n',
+            cabecalho=CABECALHO.strip() + ",moeda\n",
+        )
+        self.assertEqual([p.moeda for p in ler_pedidos(c)], ["BRL", "USD"])
+
+    def test_moeda_invalida_cita_linha(self):
+        c = csv_temp(
+            'P-1,A,01/03/2026,X,1,"10,00",livros,GBP\n', cabecalho=CABECALHO.strip() + ",moeda\n"
+        )
+        with self.assertRaisesRegex(ErroImportacao, "linha 2"):
+            ler_pedidos(c)
+
+    def test_moedas_misturadas_no_pedido(self):
+        c = csv_temp(
+            'P-9,A,01/03/2026,X,1,"10,00",livros,USD\n'
+            'P-8,A,01/03/2026,X,1,"10,00",livros,BRL\n'
+            'P-9,A,01/03/2026,Y,1,"10,00",livros,EUR\n',
+            cabecalho=CABECALHO.strip() + ",moeda\n",
+        )
+        with self.assertRaisesRegex(ErroImportacao, "P-9"):
+            ler_pedidos(c)
+
+
+class TestCambio(unittest.TestCase):
+    def test_taxa_da_data_e_anterior(self):
+        t = tabela()
+        self.assertEqual(t.taxa("USD", date(2026, 3, 5)), D("5.0870"))
+        self.assertEqual(t.taxa("usd", date(2026, 3, 4)), D("5.0125"))
+        self.assertEqual(t.taxa("USD", date(2026, 12, 1)), D("5.0870"))
+
+    def test_brl_sempre_um(self):
+        self.assertEqual(TabelaCambio({}).taxa("BRL", date(2000, 1, 1)), 1)
+
+    def test_sem_taxa_ate_a_data(self):
+        with self.assertRaisesRegex(ErroCambio, "USD"):
+            tabela().taxa("USD", date(2026, 3, 1))
+        with self.assertRaisesRegex(ErroCambio, "EUR"):
+            tabela().taxa("EUR", date(2026, 3, 1))
+
+    def test_taxa_com_ponto_recusada(self):
+        c = csv_temp('02/03/2026,USD,"5.0125"\n', cabecalho="data,moeda,taxa\n")
+        with self.assertRaisesRegex(ErroCambio, "linha 2.*vírgula"):
+            TabelaCambio.carregar(c)
+
+    def test_taxa_invalida(self):
+        c = csv_temp('02/03/2026,USD,abc\n', cabecalho="data,moeda,taxa\n")
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            TabelaCambio.carregar(c)
+
+    def test_dados_cambio_csv_valido(self):
+        self.assertEqual(TabelaCambio.carregar("dados/cambio.csv").taxa("EUR", date(2026, 3, 10)), D("5.5005"))
+
+    def test_relatorio_taxa_ponto_erro_2(self):
+        c = csv_temp('02/03/2026,USD,"5.0125"\n', cabecalho="data,moeda,taxa\n")
+        r = csv_temp('P-1,A,03/03/2026,X,1,"1,00",livros,USD\n', cabecalho=CABECALHO.strip() + ",moeda\n")
+        codigo, _, err = rodar(r, "--cambio", c)
+        self.assertEqual(codigo, 2)
+        self.assertIn("vírgula", err)
+
+    def test_erro_cambio_e_valueerror(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+
+class TestPrecoMoeda(unittest.TestCase):
+    def pedido(self, moeda, qtd=2, preco="100.00", data=date(2026, 3, 6)):
+        return Pedido("P", "X", data, [Item("A", qtd, D(preco), "papelaria")], moeda)
+
+    def test_converte_e_aplica_regras_em_reais(self):
+        r = calcular(self.pedido("USD"), tabela())  # 200 USD x 5,0870 = 1017,40
+        self.assertEqual(r.subtotal, D("1017.40"))
+        self.assertEqual(r.desconto, D("26.39"))  # 25,00 + 8% x 17,40
+        self.assertEqual(r.frete, D("0.00"))
+        self.assertEqual(r.imposto, D("118.92"))
+        self.assertEqual(r.total, D("1109.93"))
+
+    def test_arredonda_por_linha_meio_para_par(self):
+        # 1 x 0,50 x 5,0870 = 2,5435 -> 2,54 ; 1 x 0,10 x 5,0870 = 0,5087 -> 0,51
+        p = Pedido("P", "X", date(2026, 3, 6), [Item("A", 1, D("0.50"), "livros"), Item("B", 1, D("0.10"), "livros")], "USD")
+        self.assertEqual(calcular(p, tabela()).subtotal, D("3.05"))
+
+    def test_empate_na_conversao_vai_para_o_par(self):
+        # 0,10 x 5,1500 = 0,515 -> 0,52 (2 é par); 0,10 x 5,0500 = 0,505 -> 0,50 (0 é par)
+        def subtotal(taxa):
+            t = TabelaCambio({"USD": [(date(2026, 1, 1), D(taxa))]})
+            p = Pedido("P", "X", date(2026, 3, 6), [Item("A", 1, D("0.10"), "livros")], "USD")
+            return calcular(p, t).subtotal
+
+        self.assertEqual(subtotal("5.1500"), D("0.52"))
+        self.assertEqual(subtotal("5.0500"), D("0.50"))
+
+    def test_estrangeiro_sem_tabela(self):
+        with self.assertRaises(ErroCambio):
+            calcular(self.pedido("EUR"))
+
+    def test_brl_sem_tabela(self):
+        self.assertEqual(calcular(self.pedido("BRL")).subtotal, D("200.00"))
+
+
+class TestRelatorioMoeda(unittest.TestCase):
+    def setUp(self):
+        self.csv = csv_temp(
+            'P-1,A,06/03/2026,X,2,"100,00",papelaria,USD\n'
+            'P-2,B,06/03/2026,Y,1,"50,00",livros,\n',
+            cabecalho=CABECALHO.strip() + ",moeda\n",
+        )
+        self.cambio = csv_temp("", cabecalho=CAMBIO)
+
+    def test_json(self):
+        codigo, out, _ = rodar(self.csv, "--cambio", self.cambio, "--json")
+        self.assertEqual(codigo, 0)
+        d = json.loads(out)
+        self.assertEqual((d[0]["moeda"], d[0]["subtotal_original"], d[0]["subtotal"]), ("USD", "200.00", "1017.40"))
