+"""Tabela de câmbio: quantos reais vale 1 unidade de cada moeda, por data."""
+
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+def _taxa(texto: str, linha: int) -> Decimal:
+    """Mesma regra de número de preco_unit: vírgula decimal, sem ponto."""
+    t = texto.strip()
+    if "." in t:
+        raise ErroCambio(f"câmbio, linha {linha}: use vírgula decimal, sem separador de milhar ('{texto}')")
+    try:
+        return Decimal(t.replace(",", "."))
+    except InvalidOperation:
+        raise ErroCambio(f"câmbio, linha {linha}: taxa inválida '{texto}'") from None
+
+
+class TabelaCambio:
+    def __init__(self, taxas: dict[str, list[tuple[date, Decimal]]] | None = None):
+        self._taxas = {m: sorted(v) for m, v in (taxas or {}).items()}
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        taxas: dict[str, list[tuple[date, Decimal]]] = {}
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            faltando = [c for c in ("data", "moeda", "taxa") if c not in (leitor.fieldnames or [])]
+            if faltando:
+                raise ErroCambio(f"colunas ausentes na tabela de câmbio: {', '.join(faltando)}")
+            for n, l in enumerate(leitor, start=2):
+                try:
+                    d = datetime.strptime((l["data"] or "").strip(), "%d/%m/%Y").date()
+                except ValueError:
+                    raise ErroCambio(f"câmbio, linha {n}: data inválida '{l['data']}'") from None
+                t = _taxa(l["taxa"] or "", n)
+                if t <= 0:
+                    raise ErroCambio(f"câmbio, linha {n}: taxa deve ser positiva")
+                taxas.setdefault((l["moeda"] or "").strip().upper(), []).append((d, t))
+        return cls(taxas)
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        moeda = moeda.upper()
+        if moeda == "BRL":
+            return Decimal(1)
+        serie = self._taxas.get(moeda, [])
+        i = bisect_right([d for d, _ in serie], data)
+        if i == 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} até {data:%d/%m/%Y}")
+        return serie[i - 1][1]
