+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+from datetime import date
+from decimal import Decimal
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+from pedidos.importa import ErroImportacao, ler_pedidos
+from pedidos.modelo import Item, Pedido
+from pedidos.preco import calcular
+from pedidos.relatorio import main
+
+from .util import csv_temp
+
+CABECALHO_M = "id,cliente,data,sku,qtd,preco_unit,categoria,moeda\n"
+CAMBIO = 'data,moeda,taxa\n02/03/2026,USD,"5,0125"\n05/03/2026,USD,"5,0870"\n09/03/2026,EUR,"5,5005"\n'
+
+
+def cambio_temp(conteudo=CAMBIO):
+    fd, caminho = tempfile.mkstemp(suffix=".csv")
+    with os.fdopen(fd, "w", encoding="utf-8") as f:
+        f.write(conteudo)
+    return caminho
+
+
+def rodar(*args):
+    out, err = io.StringIO(), io.StringIO()
+    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+        codigo = main(list(args))
+    return codigo, out.getvalue(), err.getvalue()
+
+
+class TestImportaMoeda(unittest.TestCase):
+    def test_sem_coluna_e_brl(self):
+        p = ler_pedidos(csv_temp('P-1,A,01/03/2026,X,1,"1,00",papelaria\n'))[0]
+        self.assertEqual(p.moeda, "BRL")
+
+    def test_celula_vazia_e_minuscula(self):
+        ps = ler_pedidos(csv_temp(
+            'P-1,A,01/03/2026,X,1,"1,00",papelaria,\nP-2,A,01/03/2026,X,1,"1,00",papelaria,usd\n',
+            CABECALHO_M))
+        self.assertEqual([p.moeda for p in ps], ["BRL", "USD"])
+
+    def test_moeda_invalida(self):
+        c = csv_temp('P-1,A,01/03/2026,X,1,"1,00",papelaria,\nP-2,A,01/03/2026,X,1,"1,00",papelaria,GBP\n', CABECALHO_M)
+        with self.assertRaisesRegex(ErroImportacao, "linha 3"):
+            ler_pedidos(c)
+
+    def test_moedas_misturadas_no_pedido(self):
+        c = csv_temp('P-9,A,01/03/2026,X,1,"1,00",papelaria,USD\nP-9,A,01/03/2026,Y,1,"1,00",papelaria,EUR\n', CABECALHO_M)
+        with self.assertRaisesRegex(ErroImportacao, "P-9"):
+            ler_pedidos(c)
+
+    def test_brl_explicito_e_vazio_no_mesmo_pedido_sao_iguais(self):
+        c = csv_temp('P-9,A,01/03/2026,X,1,"1,00",papelaria,BRL\nP-9,A,01/03/2026,Y,1,"1,00",papelaria,\n', CABECALHO_M)
+        self.assertEqual(ler_pedidos(c)[0].moeda, "BRL")
+
+    def test_intercalado_mesma_moeda(self):
+        c = csv_temp(
+            'P-1,A,01/03/2026,X,1,"1,00",livros,USD\nP-2,B,01/03/2026,X,1,"1,00",livros,EUR\n'
+            'P-1,A,01/03/2026,Y,2,"1,00",livros,usd\n', CABECALHO_M)
+        ps = ler_pedidos(c)
+        self.assertEqual([(p.id, p.moeda, len(p.itens)) for p in ps], [("P-1", "USD", 2), ("P-2", "EUR", 1)])
+
+    def test_intercalado_moedas_diferentes(self):
+        c = csv_temp(
+            'P-1,A,01/03/2026,X,1,"1,00",livros,USD\nP-2,B,01/03/2026,X,1,"1,00",livros,EUR\n'
+            'P-1,A,01/03/2026,Y,2,"1,00",livros,EUR\n', CABECALHO_M)
+        with self.assertRaisesRegex(ErroImportacao, "P-1"):
+            ler_pedidos(c)
+
+
+class TestTabelaCambio(unittest.TestCase):
+    def setUp(self):
+        self.t = TabelaCambio.carregar(cambio_temp())
+
+    def test_data_exata_e_anterior(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 2)), Decimal("5.0125"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 4)), Decimal("5.0125"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 20)), Decimal("5.0870"))
+
+    def test_taxa_nao_finita(self):
+        for ruim in ("NaN", "Infinity", "-Infinity", "sNaN"):
+            c = cambio_temp(f'data,moeda,taxa\n02/03/2026,USD,"{ruim}"\n')
+            with self.assertRaises(ErroCambio, msg=ruim):
+                TabelaCambio.carregar(c)
+
+    def test_brl_sempre_um(self):
+        self.assertEqual(self.t.taxa("BRL", date(1990, 1, 1)), Decimal(1))
+
+    def test_sem_taxa(self):
+        with self.assertRaisesRegex(ErroCambio, "EUR"):
+            self.t.taxa("EUR", date(2026, 3, 8))
+        with self.assertRaises(ValueError):
+            self.t.taxa("USD", date(2026, 3, 1))
+
+    def test_exemplo_do_repositorio(self):
+        t = TabelaCambio.carregar("dados/cambio.csv")
+        self.assertEqual(t.taxa("EUR", date(2026, 3, 10)), Decimal("5.5005"))
+
+
+class TestCalculoMoeda(unittest.TestCase):
+    def pedido(self, moeda, itens, dia=5):
+        return Pedido("P", "A", date(2026, 3, dia), [Item(*i) for i in itens], moeda)
+
+    def test_sem_tabela(self):
+        with self.assertRaises(ErroCambio):
+            calcular(self.pedido("USD", [("X", 1, Decimal("1"), "papelaria")]))
+
+    def test_brl_sem_tabela(self):
+        r = calcular(self.pedido("BRL", [("X", 1, Decimal("100"), "papelaria")]))
+        self.assertEqual(r.total, Decimal("137.00"))
+
+    def test_conversao_por_linha_arredonda_meio_par(self):
+        t = TabelaCambio({"USD": {date(2026, 3, 1): Decimal("2.5")}})
+        # 1 x 0,01 x 2,5 = 0,025 -> 0,02 (par); duas linhas somam 0,04, não 0,05
+        r = calcular(self.pedido("USD", [("A", 1, Decimal("0.01"), "livros"), ("B", 1, Decimal("0.01"), "livros")]), t)
+        self.assertEqual(r.subtotal, Decimal("0.04"))
+
+    def test_faixas_em_reais_sobre_valor_convertido(self):
+        t = TabelaCambio({"USD": {date(2026, 3, 1): Decimal("5")}})
+        # 100 USD = 500 BRL: sem desconto; frete grátis (>= 300); imposto 12%
+        r = calcular(self.pedido("USD", [("A", 1, Decimal("100"), "papelaria")]), t)
+        self.assertEqual((r.subtotal, r.desconto, r.frete, r.imposto, r.total),
+                         (Decimal("500.00"), Decimal("0.00"), Decimal("0.00"), Decimal("60.00"), Decimal("560.00")))
+        # 200 USD = 1000 BRL: desconto 5% sobre 500 = 25
+        r = calcular(self.pedido("USD", [("A", 1, Decimal("200"), "livros")]), t)
+        self.assertEqual(r.desconto, Decimal("25.00"))
+
+    def test_conversao_alimenta_faixa_de_8_por_cento(self):
+        t = TabelaCambio({"USD": {date(2026, 3, 1): Decimal("5")}})
+        # 300 USD = 1500 BRL: 5% x 500 + 8% x 500 = 65
+        r = calcular(self.pedido("USD", [("A", 1, Decimal("300"), "livros")]), t)
+        self.assertEqual((r.subtotal, r.desconto), (Decimal("1500.00"), Decimal("65.00")))
+
+    def test_usa_taxa_da_data_do_pedido(self):
+        t = TabelaCambio.carregar(cambio_temp())
+        r = calcular(self.pedido("USD", [("A", 10, Decimal("10"), "livros")], dia=3), t)
+        self.assertEqual(r.subtotal, Decimal("501.25"))
+
+
+class TestRelatorioMoeda(unittest.TestCase):
+    def setUp(self):
+        self.csv = csv_temp(
+            'P-1,A,06/03/2026,X,3,"10,00",livros,usd\nP-2,B,06/03/2026,Y,1,"100,00",livros,\n',
+            CABECALHO_M)
+        self.cambio = cambio_temp()
