+"""Tabela de câmbio: taxa em reais de 1 unidade da moeda, por data."""
+
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+class TabelaCambio:
+    def __init__(self, taxas: dict[str, dict[date, Decimal]] | None = None):
+        self._taxas = {m.upper(): dict(d) for m, d in (taxas or {}).items()}
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        taxas: dict[str, dict[date, Decimal]] = {}
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            faltando = [c for c in ("data", "moeda", "taxa") if c not in (leitor.fieldnames or [])]
+            if faltando:
+                raise ErroCambio(f"câmbio: colunas ausentes: {', '.join(faltando)}")
+            for n, l in enumerate(leitor, start=2):
+                try:
+                    data = datetime.strptime((l["data"] or "").strip(), "%d/%m/%Y").date()
+                    taxa = Decimal((l["taxa"] or "").strip().replace(",", "."))
+                except (ValueError, InvalidOperation):
+                    raise ErroCambio(f"câmbio linha {n}: data ou taxa inválida") from None
+                if not taxa.is_finite() or taxa <= 0:
+                    raise ErroCambio(f"câmbio linha {n}: taxa deve ser positiva")
+                taxas.setdefault((l["moeda"] or "").strip().upper(), {})[data] = taxa
+        return cls(taxas)
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        moeda = moeda.upper()
+        if moeda == "BRL":
+            return Decimal(1)
+        por_data = self._taxas.get(moeda, {})
+        datas = sorted(por_data)
+        i = bisect_right(datas, data)
+        if i == 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} até {data:%d/%m/%Y}")
+        return por_data[datas[i - 1]]
