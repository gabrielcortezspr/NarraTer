+"""Tabela de câmbio: quantos reais vale 1 unidade de cada moeda, por data.
+
+Ver docs/PEDIDO-MULTIMOEDA.md, seção Câmbio.
+"""
+
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+MOEDA_BASE = "BRL"
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+def _data(texto: str, linha: int) -> date:
+    try:
+        return datetime.strptime(texto.strip(), "%d/%m/%Y").date()
+    except ValueError:
+        raise ErroCambio(f"linha {linha}: data inválida '{texto}'") from None
+
+
+def _taxa(texto: str, linha: int) -> Decimal:
+    try:
+        valor = Decimal(texto.strip().replace(",", "."))
+    except InvalidOperation:
+        raise ErroCambio(f"linha {linha}: taxa inválida '{texto}'") from None
+    if valor <= 0:
+        raise ErroCambio(f"linha {linha}: taxa deve ser positiva '{texto}'")
+    return valor
+
+
+class TabelaCambio:
+    def __init__(self):
+        # moeda -> datas ordenadas, e taxas na mesma ordem
+        self._datas: dict[str, list[date]] = {}
+        self._taxas: dict[str, list[Decimal]] = {}
+
+    def _adicionar(self, moeda: str, data: date, taxa: Decimal) -> None:
+        datas = self._datas.setdefault(moeda, [])
+        taxas = self._taxas.setdefault(moeda, [])
+        pos = bisect_right(datas, data)
+        datas.insert(pos, data)
+        taxas.insert(pos, taxa)
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        tabela = cls()
+        vistos = set()
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            faltando = [c for c in ("data", "moeda", "taxa") if c not in (leitor.fieldnames or [])]
+            if faltando:
+                raise ErroCambio(f"colunas ausentes: {', '.join(faltando)}")
+            for n, linha in enumerate(leitor, start=2):
+                data = _data(linha["data"] or "", n)
+                moeda = (linha["moeda"] or "").strip().upper()
+                if not moeda:
+                    raise ErroCambio(f"linha {n}: moeda vazia")
+                if (moeda, data) in vistos:
+                    raise ErroCambio(f"linha {n}: taxa duplicada para {moeda} em {data:%d/%m/%Y}")
+                vistos.add((moeda, data))
+                tabela._adicionar(moeda, data, _taxa(linha["taxa"] or "", n))
+        return tabela
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        """Taxa da data, ou da data anterior mais recente. BRL é sempre 1."""
+        moeda = moeda.strip().upper()
+        if moeda == MOEDA_BASE:
+            return Decimal(1)
+        datas = self._datas.get(moeda, [])
+        pos = bisect_right(datas, data)
+        if pos == 0:
+            raise ErroCambio(f"sem taxa de {moeda} até {data:%d/%m/%Y}")
+        return self._taxas[moeda][pos - 1]
