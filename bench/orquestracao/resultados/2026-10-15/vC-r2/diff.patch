@@ -0,0 +1,95 @@
+import os
+import unittest
+from datetime import date
+from decimal import Decimal as D
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+
+from .util import csv_temp
+
+CABECALHO_CAMBIO = "data,moeda,taxa\n"
+
+
+def tabela(conteudo: str) -> TabelaCambio:
+    caminho = csv_temp(conteudo, cabecalho=CABECALHO_CAMBIO)
+    try:
+        return TabelaCambio.carregar(caminho)
+    finally:
+        os.remove(caminho)
+
+
+CAMBIO = (
+    '02/03/2026,USD,"5,0125"\n'
+    '02/03/2026,EUR,"5,4410"\n'
+    '05/03/2026,USD,"5,0870"\n'
+    '09/03/2026,EUR,"5,5005"\n'
+)
+
+
+class TestCarregar(unittest.TestCase):
+    def test_le_arquivo_de_exemplo(self):
+        t = TabelaCambio.carregar(os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv"))
+        self.assertEqual(t.taxa("USD", date(2026, 3, 2)), D("5.0125"))
+        self.assertEqual(t.taxa("EUR", date(2026, 3, 9)), D("5.5005"))
+
+    def test_coluna_ausente(self):
+        caminho = csv_temp('02/03/2026,USD,"5,01"\n', cabecalho="data,moeda\n")
+        try:
+            with self.assertRaisesRegex(ErroCambio, "taxa"):
+                TabelaCambio.carregar(caminho)
+        finally:
+            os.remove(caminho)
+
+    def test_data_invalida_tem_numero_da_linha(self):
+        with self.assertRaisesRegex(ErroCambio, "linha 3"):
+            tabela('02/03/2026,USD,"5,01"\n2026-03-05,USD,"5,08"\n')
+
+    def test_taxa_invalida(self):
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            tabela('02/03/2026,USD,abc\n')
+
+    def test_taxa_nao_positiva(self):
+        with self.assertRaises(ErroCambio):
+            tabela('02/03/2026,USD,"0"\n')
+
+    def test_taxa_duplicada_na_mesma_data(self):
+        with self.assertRaisesRegex(ErroCambio, "duplicada"):
+            tabela('02/03/2026,USD,"5,01"\n02/03/2026,usd,"5,02"\n')
+
+    def test_ordem_do_arquivo_nao_importa(self):
+        t = tabela('09/03/2026,USD,"5,50"\n02/03/2026,USD,"5,01"\n05/03/2026,USD,"5,08"\n')
+        self.assertEqual(t.taxa("USD", date(2026, 3, 6)), D("5.08"))
+
+
+class TestTaxa(unittest.TestCase):
+    def setUp(self):
+        self.t = tabela(CAMBIO)
+
+    def test_taxa_da_propria_data(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 5)), D("5.0870"))
+
+    def test_usa_data_anterior_mais_recente(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 4)), D("5.0125"))
+        self.assertEqual(self.t.taxa("EUR", date(2026, 3, 30)), D("5.5005"))
+
+    def test_moeda_case_insensitive(self):
+        self.assertEqual(self.t.taxa("usd", date(2026, 3, 5)), D("5.0870"))
+        self.assertEqual(self.t.taxa(" Eur ", date(2026, 3, 2)), D("5.4410"))
+
+    def test_brl_e_sempre_um(self):
+        self.assertEqual(self.t.taxa("BRL", date(2020, 1, 1)), D(1))
+        self.assertEqual(TabelaCambio().taxa("brl", date(2026, 3, 2)), D(1))
+
+    def test_brl_retorna_decimal(self):
+        self.assertIsInstance(TabelaCambio().taxa("BRL", date(2026, 3, 2)), D)
+
+    def test_sem_taxa_ate_a_data(self):
+        with self.assertRaisesRegex(ErroCambio, "USD"):
+            self.t.taxa("USD", date(2026, 3, 1))
+
+    def test_moeda_desconhecida(self):
+        with self.assertRaisesRegex(ErroCambio, "GBP"):
+            self.t.taxa("GBP", date(2026, 3, 5))
+
+    def test_erro_cambio_e_value_error(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
