@@ -0,0 +1,93 @@
+import os
+import tempfile
+import unittest
+from datetime import date
+from decimal import Decimal as D
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+
+CAMBIO = os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv")
+
+
+def tabela_temp(conteudo: str) -> str:
+    fd, caminho = tempfile.mkstemp(suffix=".csv")
+    with os.fdopen(fd, "w", encoding="utf-8") as f:
+        f.write("data,moeda,taxa\n" + conteudo)
+    return caminho
+
+
+class TestTabelaCambio(unittest.TestCase):
+    def setUp(self):
+        self.tabela = TabelaCambio.carregar(CAMBIO)
+
+    def test_carrega_arquivo_de_exemplo(self):
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 2)), D("5.0125"))
+        self.assertEqual(self.tabela.taxa("EUR", date(2026, 3, 9)), D("5.5005"))
+
+    def test_data_exata(self):
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 5)), D("5.0870"))
+
+    def test_data_anterior_mais_recente(self):
+        # Não há taxa em 04/03; vale a de 02/03.
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 4)), D("5.0125"))
+        # Depois da última data, vale a última.
+        self.assertEqual(self.tabela.taxa("EUR", date(2026, 12, 31)), D("5.5005"))
+
+    def test_brl_e_sempre_1(self):
+        self.assertEqual(self.tabela.taxa("BRL", date(1990, 1, 1)), D(1))
+
+    def test_moeda_sem_maiusculas(self):
+        self.assertEqual(self.tabela.taxa("usd", date(2026, 3, 2)), D("5.0125"))
+
+    def test_sem_taxa_ate_a_data(self):
+        with self.assertRaises(ErroCambio) as ctx:
+            self.tabela.taxa("USD", date(2026, 3, 1))
+        self.assertIn("USD", str(ctx.exception))
+
+    def test_moeda_desconhecida(self):
+        with self.assertRaises(ErroCambio) as ctx:
+            self.tabela.taxa("GBP", date(2026, 3, 2))
+        self.assertIn("GBP", str(ctx.exception))
+
+    def test_erro_de_cambio_e_value_error(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+    def test_taxa_com_ponto_e_recusada(self):
+        caminho = tabela_temp('02/03/2026,USD,"5.0125"\n')
+        with self.assertRaises(ErroCambio) as ctx:
+            TabelaCambio.carregar(caminho)
+        self.assertIn("linha 2", str(ctx.exception))
+
+    def test_data_invalida_informa_linha(self):
+        caminho = tabela_temp('02/03/2026,USD,"5,0125"\n2026-03-05,USD,"5,0870"\n')
+        with self.assertRaises(ErroCambio) as ctx:
+            TabelaCambio.carregar(caminho)
+        self.assertIn("linha 3", str(ctx.exception))
+
+    def test_taxa_nao_positiva_e_recusada(self):
+        caminho = tabela_temp('02/03/2026,USD,"0,00"\n')
+        with self.assertRaises(ErroCambio):
+            TabelaCambio.carregar(caminho)
+
+    def test_colunas_ausentes(self):
+        fd, caminho = tempfile.mkstemp(suffix=".csv")
+        with os.fdopen(fd, "w", encoding="utf-8") as f:
+            f.write("data,taxa\n02/03/2026,\"5,0\"\n")
+        with self.assertRaises(ErroCambio) as ctx:
+            TabelaCambio.carregar(caminho)
+        self.assertIn("moeda", str(ctx.exception))
+
+    def test_taxa_duplicada(self):
+        caminho = tabela_temp('02/03/2026,USD,"5,0"\n02/03/2026,usd,"5,1"\n')
+        with self.assertRaises(ErroCambio):
+            TabelaCambio.carregar(caminho)
+
+    def test_tabela_vazia_so_tem_brl(self):
+        vazia = TabelaCambio()
+        self.assertEqual(vazia.taxa("BRL", date(2026, 1, 1)), D(1))
+        with self.assertRaises(ErroCambio):
+            vazia.taxa("USD", date(2026, 1, 1))
+
+
+if __name__ == "__main__":
+    unittest.main()
