+"""Tabela de câmbio (docs/PEDIDO-MULTIMOEDA.md, seção Câmbio). Taxa = reais por 1 unidade da moeda."""
+
+import csv
+from bisect import bisect_right
+from collections.abc import Iterable
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+MOEDA_BASE = "BRL"
+COLUNAS = ("data", "moeda", "taxa")
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+def _data(texto: str, linha: int) -> date:
+    try:
+        return datetime.strptime(texto.strip(), "%d/%m/%Y").date()
+    except ValueError:
+        raise ErroCambio(f"linha {linha}: data inválida '{texto}'") from None
+
+
+def _taxa(texto: str, linha: int) -> Decimal:
+    t = texto.strip()
+    if "." in t:
+        raise ErroCambio(f"linha {linha}: use vírgula decimal, sem separador de milhar ('{texto}')")
+    try:
+        valor = Decimal(t.replace(",", "."))
+    except InvalidOperation:
+        raise ErroCambio(f"linha {linha}: taxa inválida '{texto}'") from None
+    if valor <= 0:
+        raise ErroCambio(f"linha {linha}: taxa deve ser positiva ('{texto}')")
+    return valor
+
+
+class TabelaCambio:
+    def __init__(self, registros: Iterable[tuple[date, str, Decimal]] = ()):
+        por_moeda: dict[str, dict[date, Decimal]] = {}
+        for data, moeda, taxa in registros:
+            moeda = moeda.strip().upper()
+            taxas = por_moeda.setdefault(moeda, {})
+            if data in taxas:
+                raise ErroCambio(f"taxa duplicada para {moeda} em {data:%d/%m/%Y}")
+            taxas[data] = taxa
+        # Por moeda: datas em ordem crescente e as taxas na mesma ordem, para busca binária.
+        self._datas: dict[str, list[date]] = {}
+        self._taxas: dict[str, list[Decimal]] = {}
+        for moeda, taxas in por_moeda.items():
+            datas = sorted(taxas)
+            self._datas[moeda] = datas
+            self._taxas[moeda] = [taxas[d] for d in datas]
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            faltando = [c for c in COLUNAS if c not in (leitor.fieldnames or [])]
+            if faltando:
+                raise ErroCambio(f"colunas ausentes: {', '.join(faltando)}")
+            registros = []
+            for n, linha in enumerate(leitor, start=2):
+                registros.append(
+                    (
+                        _data(linha["data"] or "", n),
+                        (linha["moeda"] or "").strip(),
+                        _taxa(linha["taxa"] or "", n),
+                    )
+                )
+        return cls(registros)
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        """Taxa da data exata ou da data anterior mais recente."""
+        moeda = moeda.strip().upper()
+        if moeda == MOEDA_BASE:
+            return Decimal(1)
+        datas = self._datas.get(moeda)
+        idx = bisect_right(datas, data) - 1 if datas else -1
+        if idx < 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} até {data:%d/%m/%Y}")
+        return self._taxas[moeda][idx]
