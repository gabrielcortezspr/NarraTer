+        t = TabelaCambio.carregar(os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv"))
+        # data 04/03 -> taxa de 02/03 (5,0125); 200 × 5,0125 = 1002,50
+        r = calcular(ped("USD", ("a", 2, D("100.00"), "eletronicos"), data=date(2026, 3, 4)), t)
+        self.assertEqual(r.subtotal, D("1002.50"))
+        self.assertEqual(r.desconto, D("25.20"))
+        self.assertEqual(r.frete, D("0.00"))
+        self.assertEqual(r.imposto, D("117.28"))  # 12% × 1002,50 × 977,30/1002,50
+        self.assertEqual(r.total, D("1094.58"))
+
+
+class TestConversao(unittest.TestCase):
+    def test_converte_por_linha_com_taxa_anterior(self):
+        # 3 × 10,00 × 5,0125 = 150,375 -> 150,38 (par: 150,38); 1 × 0,10 × 5,0125 = 0,50125 -> 0,50
+        r = calcular(ped("USD", ("a", 3, D("10.00"), "livros"), ("b", 1, D("0.10"), "livros")), TABELA)
+        self.assertEqual(r.subtotal, D("150.88"))
+
+    def test_meio_para_par_na_linha(self):
+        t = TabelaCambio({("USD", date(2026, 1, 1)): D("0.5")})
+        r = calcular(ped("USD", ("a", 1, D("0.05"), "livros"), ("b", 1, D("0.07"), "livros")), t)
+        # 0.025 -> 0.02 ; 0.035 -> 0.04
+        self.assertEqual(r.subtotal, D("0.06"))
+
+    def test_regras_em_reais(self):
+        # 200 USD × 5,0125 = 1002,50 -> desconto 5%×500 + 8%×2,50 = 25,20; frete grátis
+        r = calcular(ped("USD", ("a", 2, D("100.00"), "livros")), TABELA)
+        self.assertEqual((r.subtotal, r.desconto, r.imposto, r.frete), (D("1002.50"), D("25.20"), D("0.00"), D("0.00")))
+        self.assertEqual(r.total, D("977.30"))
+
+    def test_estrangeiro_sem_tabela(self):
+        with self.assertRaises(ErroCambio):
+            calcular(ped("EUR", ("a", 1, D("1.00"), "livros")))
+
+    def test_brl_sem_tabela(self):
+        self.assertEqual(calcular(ped("BRL", ("a", 1, D("10.00"), "livros"))).subtotal, D("10.00"))
+
+    def test_taxa_inexistente(self):
+        with self.assertRaises(ErroCambio):
+            calcular(ped("USD", ("a", 1, D("1.00"), "livros"), data=date(2026, 3, 1)), TABELA)
+
+    def test_subtotal_original(self):
+        p = ped("USD", ("a", 1, D("0.125"), "livros"), ("b", 1, D("0.135"), "livros"))
+        self.assertEqual(subtotal_original(p), D("0.12") + D("0.14"))
+
+
+if __name__ == "__main__":
+    unittest.main()
