+"""Tabela de câmbio: quantos reais vale 1 unidade de cada moeda, por data."""
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+class TabelaCambio:
+    def __init__(self, taxas=None):
+        # {moeda: [(data, taxa), ...]} ordenado por data
+        self._taxas = {}
+        for (moeda, data), taxa in (taxas or {}).items():
+            self._taxas.setdefault(moeda.strip().upper(), []).append((data, Decimal(taxa)))
+        for lista in self._taxas.values():
+            lista.sort()
+
+    @classmethod
+    def carregar(cls, caminho):
+        taxas = {}
+        with open(caminho, newline="", encoding="utf-8") as f:
+            for n, linha in enumerate(csv.DictReader(f), start=2):
+                try:
+                    data = datetime.strptime(linha["data"].strip(), "%d/%m/%Y").date()
+                    moeda = linha["moeda"].strip().upper()
+                    taxa = Decimal(linha["taxa"].strip().replace(",", "."))
+                    if not moeda or not taxa.is_finite() or taxa <= 0:
+                        raise ValueError
+                except (KeyError, AttributeError, ValueError, InvalidOperation):
+                    raise ErroCambio(f"linha {n}: câmbio inválido em {caminho}") from None
+                taxas[(moeda, data)] = taxa
+        return cls(taxas)
+
+    def taxa(self, moeda, data):
+        moeda = moeda.strip().upper()
+        if moeda == "BRL":
+            return Decimal(1)
+        if isinstance(data, datetime):
+            data = data.date()
+        lista = self._taxas.get(moeda, [])
+        i = bisect_right(lista, (data, Decimal("Infinity")))
+        if i == 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} até {data.strftime('%d/%m/%Y')}")
+        return lista[i - 1][1]
