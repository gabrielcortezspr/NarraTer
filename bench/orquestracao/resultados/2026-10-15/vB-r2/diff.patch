+import os
+import tempfile
+import unittest
+from datetime import date
+from decimal import Decimal as D
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+
+CSV = os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv")
+
+
+class TestCambio(unittest.TestCase):
+    def setUp(self):
+        self.t = TabelaCambio.carregar(CSV)
+
+    def test_data_exata(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 2)), D("5.0125"))
+        self.assertEqual(self.t.taxa("EUR", date(2026, 3, 9)), D("5.5005"))
+
+    def test_usa_data_anterior_mais_recente(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 4)), D("5.0125"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 12, 31)), D("5.0870"))
+        self.assertEqual(self.t.taxa("EUR", date(2026, 3, 8)), D("5.4410"))
+
+    def test_antes_da_primeira_taxa(self):
+        with self.assertRaises(ErroCambio) as c:
+            self.t.taxa("USD", date(2026, 3, 1))
+        self.assertIn("USD", str(c.exception))
+
+    def test_moeda_desconhecida(self):
+        with self.assertRaises(ErroCambio) as c:
+            self.t.taxa("JPY", date(2026, 3, 5))
+        self.assertIn("JPY", str(c.exception))
+
+    def test_brl_sempre_um(self):
+        self.assertEqual(self.t.taxa("BRL", date(1990, 1, 1)), D(1))
+        self.assertEqual(TabelaCambio().taxa("BRL", date(2026, 1, 1)), D(1))
+
+    def test_erro_e_value_error(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+    def test_moeda_minuscula(self):
+        self.assertEqual(self.t.taxa("usd", date(2026, 3, 5)), D("5.0870"))
+
+    def test_arquivo_fora_de_ordem_e_invalido(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = os.path.join(d, "c.csv")
+            with open(p, "w", encoding="utf-8") as f:
+                f.write('data,moeda,taxa\n09/03/2026,USD,"5,10"\n02/03/2026,USD,"5,00"\n')
+            t = TabelaCambio.carregar(p)
+            self.assertEqual(t.taxa("USD", date(2026, 3, 5)), D("5.00"))
+            self.assertEqual(t.taxa("USD", date(2026, 3, 9)), D("5.10"))
+            with open(p, "w", encoding="utf-8") as f:
+                f.write('data,moeda,taxa\n2026-03-02,USD,"5,00"\n')
+            with self.assertRaises(ErroCambio):
+                TabelaCambio.carregar(p)
+
+
+if __name__ == "__main__":
+    unittest.main()
