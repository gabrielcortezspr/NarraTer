diff --git a/tests/test_relatorio_multimoeda.py b/tests/test_relatorio_multimoeda.py
new file mode 100644
index 0000000..5f9b169
--- /dev/null
+++ b/tests/test_relatorio_multimoeda.py
@@ -0,0 +1,82 @@
+import contextlib
+import io
+import json
+import os
+import unittest
+
+from pedidos.relatorio import main
+
+from .util import csv_temp
+
+CABECALHO = "id,cliente,data,sku,qtd,preco_unit,categoria,moeda\n"
+CAMBIO = os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv")
+
+
+def rodar(*args):
+    out, err = io.StringIO(), io.StringIO()
+    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+        codigo = main(list(args))
+    return codigo, out.getvalue(), err.getvalue()
+
+
+class TestRelatorioMultimoeda(unittest.TestCase):
+    def setUp(self):
+        # P-USD: 02/03, 2 × 10,00 USD; taxa de 02/03 = 5,0125 -> 100,25 BRL
+        # P-EUR: 06/03, 1 × 10,00 EUR; não há taxa de EUR em 06/03, vale a de 02/03 = 5,4410 -> 54,41 BRL
+        # P-BRL: 03/03, 1 × 50,00 BRL
+        self.csv = csv_temp(
+            'P-USD,Acme,02/03/2026,A,2,"10,00",papelaria,USD\n'
+            'P-BRL,Bruna,03/03/2026,B,1,"50,00",papelaria,\n'
+            'P-EUR,Beto,06/03/2026,C,1,"10,00",papelaria,eur\n',
+            cabecalho=CABECALHO,
+        )
+
+    def test_json_traz_moeda_e_subtotal_original(self):
+        codigo, out, _ = rodar(self.csv, "--cambio", CAMBIO, "--json")
+        self.assertEqual(codigo, 0)
+        dados = {d["id"]: d for d in json.loads(out)}
+        self.assertEqual(dados["P-USD"]["moeda"], "USD")
+        self.assertEqual(dados["P-USD"]["subtotal_original"], "20.00")
+        self.assertEqual(dados["P-USD"]["subtotal"], "100.25")
+        self.assertEqual(dados["P-USD"]["total"], "137.28")
+        self.assertEqual(dados["P-BRL"]["moeda"], "BRL")
+        self.assertEqual(dados["P-BRL"]["subtotal_original"], "50.00")
+        self.assertEqual(dados["P-BRL"]["subtotal"], "50.00")
+
+    def test_taxa_da_data_anterior_mais_recente(self):
+        # 06/03 não tem taxa de EUR; a de 02/03 (5,4410) vale: 10,00 × 5,4410 = 54,41
+        _, out, _ = rodar(self.csv, "--cambio", CAMBIO, "--json")
+        dados = {d["id"]: d for d in json.loads(out)}
+        self.assertEqual(dados["P-EUR"]["subtotal"], "54.41")
+        self.assertEqual(dados["P-EUR"]["subtotal_original"], "10.00")
+
+    def test_estrangeiro_sem_cambio_erra(self):
+        codigo, out, err = rodar(self.csv)
+        self.assertEqual(codigo, 2)
+        self.assertEqual(out, "")
+        self.assertTrue(err.startswith("erro:"))
+
+    def test_taxa_inexistente_erra(self):
+        # o CSV de câmbio só começa em 02/03; pedido de 01/03 em USD não tem taxa
+        pedidos = csv_temp('P-0,Ana,01/03/2026,A,1,"10,00",papelaria,USD\n', cabecalho=CABECALHO)
+        codigo, _, err = rodar(pedidos, "--cambio", CAMBIO)
+        self.assertEqual(codigo, 2)
+        self.assertTrue(err.startswith("erro:"))
+        self.assertIn("USD", err)
+
+    def test_cambio_inexistente_erra(self):
+        codigo, _, err = rodar(self.csv, "--cambio", "/nao/existe.csv")
+        self.assertEqual(codigo, 2)
+        self.assertTrue(err.startswith("erro:"))
+
+    def test_texto_tem_coluna_moeda(self):
+        _, out, _ = rodar(self.csv, "--cambio", CAMBIO)
+        linhas = out.splitlines()
+        self.assertIn("moeda", linhas[0])
+        usd = next(l for l in linhas if l.startswith("P-USD"))
+        self.assertIn(" USD ", usd)
+        self.assertIn("137.28", usd)
+
+
+if __name__ == "__main__":
+    unittest.main()
