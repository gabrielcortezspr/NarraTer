@@ -0,0 +1,107 @@
+import os
+import unittest
+from datetime import date
+from decimal import Decimal
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+
+from .util import csv_temp
+
+CABECALHO_CAMBIO = "data,moeda,taxa\n"
+DADOS = os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv")
+
+
+class TestCarregar(unittest.TestCase):
+    def test_carrega_arquivo_de_dados(self):
+        t = TabelaCambio.carregar(DADOS)
+        self.assertEqual(t.taxa("USD", date(2026, 3, 2)), Decimal("5.0125"))
+        self.assertEqual(t.taxa("EUR", date(2026, 3, 9)), Decimal("5.5005"))
+
+    def test_arquivo_de_dados_usa_data_anterior(self):
+        t = TabelaCambio.carregar(DADOS)
+        # 03/03 não tem taxa: vale a de 02/03
+        self.assertEqual(t.taxa("USD", date(2026, 3, 3)), Decimal("5.0125"))
+        self.assertEqual(t.taxa("USD", date(2026, 3, 30)), Decimal("5.0870"))
+
+    def test_moeda_case_insensitive(self):
+        c = csv_temp('02/03/2026,usd,"5,0125"\n', CABECALHO_CAMBIO)
+        t = TabelaCambio.carregar(c)
+        self.assertEqual(t.taxa("Usd", date(2026, 3, 2)), Decimal("5.0125"))
+
+    def test_colunas_ausentes(self):
+        c = csv_temp('02/03/2026,USD,"5,0125"\n', "data,moeda\n")
+        with self.assertRaisesRegex(ErroCambio, "taxa"):
+            TabelaCambio.carregar(c)
+
+    def test_data_invalida_cita_linha(self):
+        c = csv_temp('02/03/2026,USD,"5,0125"\n2026-03-05,USD,"5,0870"\n', CABECALHO_CAMBIO)
+        with self.assertRaisesRegex(ErroCambio, "linha 3"):
+            TabelaCambio.carregar(c)
+
+    def test_taxa_com_ponto_recusada(self):
+        c = csv_temp("02/03/2026,USD,5.0125\n", CABECALHO_CAMBIO)
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            TabelaCambio.carregar(c)
+
+    def test_taxa_invalida(self):
+        c = csv_temp('02/03/2026,USD,"abc"\n', CABECALHO_CAMBIO)
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            TabelaCambio.carregar(c)
+
+    def test_taxa_zero_ou_negativa(self):
+        for valor in ('"0,00"', '"-1,00"'):
+            with self.subTest(valor=valor):
+                c = csv_temp(f"02/03/2026,USD,{valor}\n", CABECALHO_CAMBIO)
+                with self.assertRaisesRegex(ErroCambio, "linha 2"):
+                    TabelaCambio.carregar(c)
+
+    def test_moeda_vazia_cita_linha(self):
+        c = csv_temp('02/03/2026,,"5,0125"\n', CABECALHO_CAMBIO)
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            TabelaCambio.carregar(c)
+
+    def test_brl_no_arquivo_recusado(self):
+        c = csv_temp('02/03/2026,BRL,"1,00"\n', CABECALHO_CAMBIO)
+        with self.assertRaisesRegex(ErroCambio, "BRL"):
+            TabelaCambio.carregar(c)
+
+    def test_taxa_duplicada_cita_linha(self):
+        c = csv_temp('02/03/2026,USD,"5,0125"\n02/03/2026,usd,"5,2000"\n', CABECALHO_CAMBIO)
+        with self.assertRaisesRegex(ErroCambio, "linha 3"):
+            TabelaCambio.carregar(c)
+
+
+class TestTaxa(unittest.TestCase):
+    def setUp(self):
+        c = csv_temp(
+            '02/03/2026,USD,"5,0000"\n'
+            '10/03/2026,USD,"5,2000"\n',
+            CABECALHO_CAMBIO,
+        )
+        self.tabela = TabelaCambio.carregar(c)
+
+    def test_taxa_da_propria_data(self):
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 10)), Decimal("5.2000"))
+
+    def test_taxa_da_data_anterior_mais_recente(self):
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 9)), Decimal("5.0000"))
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 20)), Decimal("5.2000"))
+
+    def test_brl_sempre_um(self):
+        self.assertEqual(self.tabela.taxa("BRL", date(1990, 1, 1)), Decimal(1))
+        self.assertEqual(self.tabela.taxa("brl", date(2026, 3, 1)), Decimal(1))
+
+    def test_sem_taxa_ate_a_data(self):
+        with self.assertRaisesRegex(ErroCambio, "USD"):
+            self.tabela.taxa("USD", date(2026, 3, 1))
+
+    def test_moeda_sem_nenhuma_taxa(self):
+        with self.assertRaisesRegex(ErroCambio, "EUR"):
+            self.tabela.taxa("EUR", date(2026, 3, 10))
+
+    def test_erro_de_cambio_e_value_error(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+
+if __name__ == "__main__":
+    unittest.main()
