@@ -0,0 +1,94 @@
+import contextlib
+import io
+import json
+import os
+import unittest
+
+from pedidos.relatorio import main
+
+from .util import csv_temp, CABECALHO
+
+CABECALHO_MOEDA = CABECALHO.rstrip("\n") + ",moeda\n"
+CAMBIO = os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv")
+
+
+def rodar(*args):
+    out, err = io.StringIO(), io.StringIO()
+    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+        codigo = main(list(args))
+    return codigo, out.getvalue(), err.getvalue()
+
+
+class TestRelatorioCambio(unittest.TestCase):
+    def setUp(self):
+        # P-1: BRL; P-3: USD 2 × 100,00 em 02/03 (taxa 5,0125); P-4: EUR 1 × 20,00 em 09/03 (taxa 5,5005), livros
+        self.csv = csv_temp(
+            'P-1,Acme Ltda,01/03/2026,A,1,"100,00",papelaria,BRL\n'
+            'P-3,Carla,02/03/2026,B,2,"100,00",papelaria,USD\n'
+            'P-4,Dani,09/03/2026,C,1,"20,00",livros,eur\n',
+            CABECALHO_MOEDA,
+        )
+        self.csv_brl = csv_temp('P-1,Acme Ltda,01/03/2026,A,1,"100,00",papelaria,\n', CABECALHO_MOEDA)
+
+    def test_json_com_cambio_traz_moeda_e_subtotal_original(self):
+        codigo, out, _ = rodar(self.csv, "--json", "--cambio", CAMBIO)
+        self.assertEqual(codigo, 0)
+        dados = {d["id"]: d for d in json.loads(out)}
+        self.assertEqual(dados["P-3"]["moeda"], "USD")
+        self.assertEqual(dados["P-3"]["subtotal_original"], "200.00")
+        self.assertEqual(dados["P-3"]["subtotal"], "1002.50")
+        self.assertEqual(dados["P-3"]["total"], "1094.58")
+        self.assertEqual(dados["P-4"]["moeda"], "EUR")
+        self.assertEqual(dados["P-4"]["subtotal_original"], "20.00")
+        self.assertEqual(dados["P-4"]["subtotal"], "110.01")
+        self.assertEqual(dados["P-4"]["total"], "135.01")
+
+    def test_json_brl_sem_cambio_funciona(self):
+        codigo, out, _ = rodar(self.csv_brl, "--json")
+        self.assertEqual(codigo, 0)
+        d = json.loads(out)[0]
+        self.assertEqual(d["moeda"], "BRL")
+        self.assertEqual(d["subtotal_original"], "100.00")
+        self.assertEqual(d["total"], "137.00")
+
+    def test_brl_com_cambio_nao_muda_valores(self):
+        codigo, out, _ = rodar(self.csv_brl, "--json", "--cambio", CAMBIO)
+        self.assertEqual(codigo, 0)
+        self.assertEqual(json.loads(out)[0]["total"], "137.00")
+
+    def test_texto_tem_coluna_moeda(self):
+        codigo, out, _ = rodar(self.csv, "--cambio", CAMBIO)
+        self.assertEqual(codigo, 0)
+        self.assertIn("moeda", out.splitlines()[0])
+        linha_p3 = next(l for l in out.splitlines() if l.startswith("P-3"))
+        self.assertIn(" USD ", linha_p3)
+
+    def test_moeda_estrangeira_sem_cambio_sai_com_2(self):
+        codigo, out, err = rodar(self.csv, "--json")
+        self.assertEqual(codigo, 2)
+        self.assertEqual(out, "")
+        self.assertTrue(err.startswith("erro:"))
+        self.assertIn("USD", err)
+
+    def test_taxa_inexistente_sai_com_2(self):
+        # USD em 01/03 é anterior à primeira taxa (02/03)
+        csv_antes = csv_temp('P-5,Eva,01/03/2026,A,1,"10,00",papelaria,USD\n', CABECALHO_MOEDA)
+        codigo, _, err = rodar(csv_antes, "--cambio", CAMBIO)
+        self.assertEqual(codigo, 2)
+        self.assertTrue(err.startswith("erro:"))
+        self.assertIn("USD", err)
+
+    def test_cambio_ausente_sai_com_2(self):
+        codigo, _, err = rodar(self.csv, "--cambio", "/nao/existe.csv")
+        self.assertEqual(codigo, 2)
+        self.assertTrue(err.startswith("erro:"))
+
+    def test_cambio_malformado_sai_com_2(self):
+        ruim = csv_temp('02/03/2026,USD,5.0125\n', "data,moeda,taxa\n")
+        codigo, _, err = rodar(self.csv, "--cambio", ruim)
+        self.assertEqual(codigo, 2)
+        self.assertIn("linha 2", err)
+
+
+if __name__ == "__main__":
+    unittest.main()
