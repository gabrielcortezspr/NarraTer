+class TestMultimoeda(unittest.TestCase):
+    def tabela(self):
+        return TabelaCambio(
+            {"USD": {date(2026, 3, 2): D("5.0125"), date(2026, 3, 5): D("5.0870")}, "EUR": {date(2026, 3, 2): D("5.4410")}}
+        )
+
+    def em(self, moeda, dia, *itens):
+        return Pedido(id="P", cliente="X", data=date(2026, 3, dia), itens=[Item(*i) for i in itens], moeda=moeda)
+
+    def test_estrangeiro_sem_tabela(self):
+        with self.assertRaises(ErroCambio):
+            calcular(self.em("USD", 2, ("A", 1, D("10.00"), "papelaria")))
+
+    def test_brl_sem_tabela_e_com_tabela(self):
+        p = self.em("BRL", 2, ("A", 1, D("10.00"), "papelaria"))
+        self.assertEqual(calcular(p), calcular(p, self.tabela()))
+
+    def test_converte_com_taxa_da_data_anterior(self):
+        # 04/03 -> usa a taxa de 02/03 (5.0125)
+        r = calcular(self.em("USD", 4, ("A", 2, D("10.00"), "papelaria")), self.tabela())
+        self.assertEqual(r.subtotal, D("100.25"))
+        self.assertEqual(r.imposto, D("12.03"))
+        self.assertEqual(r.frete, D("25.00"))
+
+    def test_usa_taxa_da_propria_data(self):
+        r = calcular(self.em("USD", 5, ("A", 1, D("10.00"), "papelaria")), self.tabela())
+        self.assertEqual(r.subtotal, D("50.87"))
+
+    def test_sem_taxa_ate_a_data(self):
+        with self.assertRaises(ErroCambio) as ctx:
+            calcular(self.em("EUR", 1, ("A", 1, D("10.00"), "papelaria")), self.tabela())
+        self.assertIn("EUR", str(ctx.exception))
+
+    def test_frete_gratis_avaliado_em_reais(self):
+        # 60 USD (< 300 na moeda original) = 300.75 BRL: frete grátis
+        r = calcular(self.em("USD", 2, ("A", 1, D("60.00"), "livros")), self.tabela())
+        self.assertEqual(r.subtotal, D("300.75"))
+        self.assertEqual(r.frete, D("0.00"))
+        # 59 USD = 295.7375 -> 295.74 BRL: paga frete
+        r = calcular(self.em("USD", 2, ("A", 1, D("59.00"), "livros")), self.tabela())
+        self.assertEqual(r.frete, D("25.00"))
+
+    def test_faixas_de_desconto_em_reais(self):
+        # 100 EUR x 5.4410 = 544.10 BRL (> 500): 5% sobre 44.10 = 2.205 -> 2.20
+        r = calcular(self.em("EUR", 2, ("A", 1, D("100.00"), "papelaria")), self.tabela())
+        self.assertEqual(r.subtotal, D("544.10"))
+        self.assertEqual(r.desconto, D("2.20"))
+
+    def test_arredonda_cada_linha_convertida_meio_para_par(self):
+        t = TabelaCambio({"USD": {date(2026, 3, 1): D("0.125")}})
+        # cada linha: 0.125 -> 0.12 (par); somar antes daria 0.25
+        r = calcular(self.em("USD", 1, ("A", 1, D("1.00"), "livros"), ("B", 1, D("1.00"), "livros")), t)
+        self.assertEqual(r.subtotal, D("0.24"))
+        # 0.375 -> 0.38 (par)
+        r = calcular(self.em("USD", 1, ("A", 1, D("3.00"), "livros")), t)
+        self.assertEqual(r.subtotal, D("0.38"))
+
