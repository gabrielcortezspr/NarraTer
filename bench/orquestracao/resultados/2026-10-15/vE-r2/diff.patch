+"""Tabela de câmbio (docs/PEDIDO-MULTIMOEDA.md): quantos reais vale 1 unidade da moeda."""
+
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+COLUNAS = ("data", "moeda", "taxa")
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+class TabelaCambio:
+    def __init__(self, taxas: dict[str, dict[date, Decimal]] | None = None):
+        # moeda -> (datas ordenadas, taxas na mesma ordem)
+        self._series = {}
+        for moeda, por_data in (taxas or {}).items():
+            datas = sorted(por_data)
+            self._series[moeda.upper()] = (datas, [por_data[d] for d in datas])
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        taxas: dict[str, dict[date, Decimal]] = {}
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            faltando = [c for c in COLUNAS if c not in (leitor.fieldnames or [])]
+            if faltando:
+                raise ErroCambio(f"câmbio: colunas ausentes: {', '.join(faltando)}")
+            for n, bruto in enumerate(leitor, start=2):
+                moeda = (bruto.get("moeda") or "").strip().upper()
+                if not moeda:
+                    raise ErroCambio(f"câmbio, linha {n}: moeda ausente")
+                try:
+                    data = datetime.strptime((bruto.get("data") or "").strip(), "%d/%m/%Y").date()
+                except ValueError:
+                    raise ErroCambio(f"câmbio, linha {n}: data inválida '{bruto.get('data')}'") from None
+                texto = (bruto.get("taxa") or "").strip()
+                if "." in texto:
+                    raise ErroCambio(f"câmbio, linha {n}: use vírgula decimal ('{texto}')")
+                try:
+                    taxa = Decimal(texto.replace(",", "."))
+                except InvalidOperation:
+                    raise ErroCambio(f"câmbio, linha {n}: taxa inválida '{texto}'") from None
+                if not taxa.is_finite() or taxa <= 0:
+                    raise ErroCambio(f"câmbio, linha {n}: taxa deve ser positiva ('{texto}')")
+                if data in taxas.get(moeda, {}):
+                    raise ErroCambio(f"câmbio, linha {n}: taxa repetida para {moeda} em {data:%d/%m/%Y}")
+                taxas.setdefault(moeda, {})[data] = taxa
+        return cls(taxas)
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        """Taxa da data ou da data anterior mais recente; BRL é sempre 1."""
+        moeda = moeda.upper()
+        if moeda == "BRL":
+            return Decimal(1)
+        datas, valores = self._series.get(moeda, ([], []))
+        i = bisect_right(datas, data)
+        if i == 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} até {data:%d/%m/%Y}")
+        return valores[i - 1]
