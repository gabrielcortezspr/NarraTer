@@ -0,0 +1,115 @@
+import os
+import tempfile
+import unittest
+from datetime import date
+from decimal import Decimal
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+from pedidos.modelo import Pedido
+
+
+def tabela_temp(conteudo: str) -> str:
+    fd, caminho = tempfile.mkstemp(suffix=".csv")
+    with os.fdopen(fd, "w", encoding="utf-8") as f:
+        f.write(conteudo)
+    return caminho
+
+
+CSV = (
+    "data,moeda,taxa\n"
+    '02/03/2026,USD,"5,0125"\n'
+    '09/03/2026,EUR,"5,5005"\n'
+    '05/03/2026,USD,"5,0870"\n'
+)
+
+
+class TestTabelaCambio(unittest.TestCase):
+    def setUp(self):
+        self.t = TabelaCambio.carregar(tabela_temp(CSV))
+
+    def test_taxa_da_propria_data(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 2)), Decimal("5.0125"))
+
+    def test_usa_data_anterior_mais_recente(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 4)), Decimal("5.0125"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 20)), Decimal("5.0870"))
+
+    def test_arquivo_fora_de_ordem(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 5)), Decimal("5.0870"))
+
+    def test_moeda_minuscula(self):
+        self.assertEqual(self.t.taxa("usd", date(2026, 3, 2)), Decimal("5.0125"))
+
+    def test_brl_e_sempre_um(self):
+        self.assertEqual(self.t.taxa("BRL", date(1990, 1, 1)), Decimal(1))
+
+    def test_sem_taxa_ate_a_data(self):
+        with self.assertRaises(ErroCambio) as ctx:
+            self.t.taxa("EUR", date(2026, 3, 8))
+        self.assertIn("EUR", str(ctx.exception))
+
+    def test_moeda_desconhecida(self):
+        with self.assertRaises(ErroCambio):
+            self.t.taxa("USD", date(2026, 3, 1))
+        with self.assertRaises(ErroCambio):
+            self.t.taxa("JPY", date(2026, 3, 9))
+
+    def test_erro_cambio_e_value_error(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+    def test_exemplo_do_repositorio(self):
+        t = TabelaCambio.carregar(os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv"))
+        self.assertEqual(t.taxa("EUR", date(2026, 3, 10)), Decimal("5.5005"))
+
+
+class TestCargaInvalida(unittest.TestCase):
+    def assertErro(self, conteudo, trecho=None):
+        with self.assertRaises(ErroCambio) as ctx:
+            TabelaCambio.carregar(tabela_temp(conteudo))
+        if trecho:
+            self.assertIn(trecho, str(ctx.exception))
+
+    def test_coluna_ausente(self):
+        self.assertErro("data,moeda\n02/03/2026,USD\n", "taxa")
+
+    def test_data_invalida(self):
+        self.assertErro('data,moeda,taxa\n2026-03-02,USD,"5,0"\n', "linha 2")
+
+    def test_taxa_invalida(self):
+        self.assertErro('data,moeda,taxa\n02/03/2026,USD,abc\n', "linha 2")
+
+    def test_taxa_com_ponto(self):
+        self.assertErro('data,moeda,taxa\n02/03/2026,USD,"5.01"\n', "linha 2")
+
+    def test_taxa_nao_positiva(self):
+        self.assertErro('data,moeda,taxa\n02/03/2026,USD,"0"\n', "linha 2")
+
+    def test_duplicada(self):
+        self.assertErro('data,moeda,taxa\n02/03/2026,USD,"5,0"\n02/03/2026,USD,"5,1"\n', "linha 3")
+
+    def test_moeda_ausente(self):
+        self.assertErro('data,moeda,taxa\n02/03/2026,,"5,0"\n', "linha 2")
+
+    def test_taxa_infinita_ou_nan(self):
+        for t in ("inf", "Infinity", "-inf", "nan", "NaN", "sNaN"):
+            with self.subTest(taxa=t):
+                self.assertErro(f"data,moeda,taxa\n02/03/2026,USD,{t}\n", "linha 2")
+
+    def test_taxa_vazia(self):
+        self.assertErro('data,moeda,taxa\n02/03/2026,USD,\n', "linha 2")
+
+    def test_arquivo_ausente(self):
+        with self.assertRaises(OSError):
+            TabelaCambio.carregar("/nao/existe.csv")
+
+
+class TestModelo(unittest.TestCase):
+    def test_moeda_padrao_brl(self):
+        self.assertEqual(Pedido(id="P", cliente="c", data=date(2026, 1, 1)).moeda, "BRL")
+
+    def test_moeda_normalizada_para_maiusculas(self):
+        self.assertEqual(Pedido(id="P", cliente="c", data=date(2026, 1, 1), moeda="usd").moeda, "USD")
+
+
+if __name__ == "__main__":
+    unittest.main()
