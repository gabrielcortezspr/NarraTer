@@ -0,0 +1,83 @@
+import os
+import unittest
+from datetime import date
+from decimal import Decimal as D
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+
+from .util import csv_temp
+
+CABECALHO = "data,moeda,taxa\n"
+CAMBIO_CSV = os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv")
+
+
+class TestCambio(unittest.TestCase):
+    def setUp(self):
+        self.tabela = TabelaCambio.carregar(CAMBIO_CSV)
+
+    def test_taxa_da_propria_data(self):
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 2)), D("5.0125"))
+        self.assertEqual(self.tabela.taxa("EUR", date(2026, 3, 2)), D("5.4410"))
+
+    def test_taxa_da_data_anterior_mais_recente(self):
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 4)), D("5.0125"))
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 5)), D("5.0870"))
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 31)), D("5.0870"))
+        self.assertEqual(self.tabela.taxa("EUR", date(2026, 3, 8)), D("5.4410"))
+        self.assertEqual(self.tabela.taxa("EUR", date(2026, 3, 9)), D("5.5005"))
+
+    def test_brl_vale_sempre_1(self):
+        self.assertEqual(self.tabela.taxa("BRL", date(2026, 3, 2)), D(1))
+        self.assertEqual(self.tabela.taxa("BRL", date(1990, 1, 1)), D(1))
+
+    def test_moeda_sem_maiusculas(self):
+        self.assertEqual(self.tabela.taxa("usd", date(2026, 3, 2)), D("5.0125"))
+
+    def test_data_antes_da_primeira_taxa_erro(self):
+        with self.assertRaisesRegex(ErroCambio, "USD"):
+            self.tabela.taxa("USD", date(2026, 3, 1))
+
+    def test_moeda_desconhecida_erro(self):
+        with self.assertRaisesRegex(ErroCambio, "GBP"):
+            self.tabela.taxa("GBP", date(2026, 3, 2))
+
+    def test_erro_cambio_e_value_error(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+    def test_taxa_com_ponto_recusada(self):
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            TabelaCambio.carregar(csv_temp('02/03/2026,USD,"5.0125"\n', CABECALHO))
+
+    def test_taxa_nao_positiva_recusada(self):
+        with self.assertRaises(ErroCambio):
+            TabelaCambio.carregar(csv_temp('02/03/2026,USD,"0"\n', CABECALHO))
+
+    def test_data_invalida_cita_linha(self):
+        with self.assertRaisesRegex(ErroCambio, "linha 3"):
+            TabelaCambio.carregar(csv_temp('02/03/2026,USD,"5,0"\n2026-03-03,USD,"5,1"\n', CABECALHO))
+
+    def test_taxa_duplicada_recusada(self):
+        with self.assertRaisesRegex(ErroCambio, "duplicada"):
+            TabelaCambio.carregar(csv_temp('02/03/2026,USD,"5,0"\n02/03/2026,usd,"5,1"\n', CABECALHO))
+
+    def test_linha_curta_cita_linha(self):
+        with self.assertRaisesRegex(ErroCambio, "linha 3"):
+            TabelaCambio.carregar(csv_temp('02/03/2026,USD,"5,0"\n02/03/2026,EUR\n', CABECALHO))
+
+    def test_coluna_ausente(self):
+        with self.assertRaisesRegex(ErroCambio, "taxa"):
+            TabelaCambio.carregar(csv_temp("02/03/2026,USD\n", "data,moeda\n"))
+
+    def test_arquivo_ausente_levanta_os_error(self):
+        with self.assertRaises(OSError):
+            TabelaCambio.carregar("/nao/existe.csv")
+
+    def test_tabela_vazia_so_tem_brl(self):
+        t = TabelaCambio()
+        self.assertEqual(t.taxa("BRL", date(2026, 1, 1)), D(1))
+        with self.assertRaises(ErroCambio):
+            t.taxa("USD", date(2026, 1, 1))
+
+
+if __name__ == "__main__":
+    unittest.main()
