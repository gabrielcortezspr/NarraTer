+"""Tabela de câmbio (docs/PEDIDO-MULTIMOEDA.md, seção Câmbio).
+
+O CSV tem as colunas `data, moeda, taxa`: `taxa` é quantos reais vale 1 unidade da moeda.
+"""
+
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+MOEDA_BASE = "BRL"
+COLUNAS = ("data", "moeda", "taxa")
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+def _data(texto: str, linha: int) -> date:
+    try:
+        return datetime.strptime(texto.strip(), "%d/%m/%Y").date()
+    except ValueError:
+        raise ErroCambio(f"linha {linha}: data inválida '{texto}'") from None
+
+
+def _taxa(texto: str, linha: int) -> Decimal:
+    t = texto.strip()
+    if "." in t:
+        raise ErroCambio(f"linha {linha}: use vírgula decimal na taxa ('{texto}')")
+    try:
+        valor = Decimal(t.replace(",", "."))
+    except InvalidOperation:
+        raise ErroCambio(f"linha {linha}: taxa inválida '{texto}'") from None
+    if valor <= 0:
+        raise ErroCambio(f"linha {linha}: taxa deve ser positiva '{texto}'")
+    return valor
+
+
+class TabelaCambio:
+    def __init__(self, taxas: dict[str, dict[date, Decimal]] | None = None):
+        # moeda -> datas ordenadas e taxas na mesma ordem, para busca por data anterior
+        self._datas: dict[str, list[date]] = {}
+        self._taxas: dict[str, list[Decimal]] = {}
+        for moeda, por_data in (taxas or {}).items():
+            itens = sorted(por_data.items())
+            self._datas[moeda] = [d for d, _ in itens]
+            self._taxas[moeda] = [t for _, t in itens]
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            faltando = [c for c in COLUNAS if c not in (leitor.fieldnames or [])]
+            if faltando:
+                raise ErroCambio(f"colunas ausentes: {', '.join(faltando)}")
+            taxas: dict[str, dict[date, Decimal]] = {}
+            for n, linha in enumerate(leitor, start=2):
+                if any(linha.get(c) is None for c in COLUNAS):
+                    raise ErroCambio(f"linha {n}: campos faltando")
+                moeda = linha["moeda"].strip().upper()
+                data = _data(linha["data"], n)
+                if data in taxas.get(moeda, {}):
+                    raise ErroCambio(f"linha {n}: taxa duplicada de {moeda} em {data:%d/%m/%Y}")
+                taxas.setdefault(moeda, {})[data] = _taxa(linha["taxa"], n)
+        return cls(taxas)
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        """Taxa da data, ou da data anterior mais recente. BRL vale sempre 1."""
+        moeda = moeda.strip().upper()
+        if moeda == MOEDA_BASE:
+            return Decimal(1)
+        datas = self._datas.get(moeda, [])
+        i = bisect_right(datas, data)
+        if i == 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} até {data:%d/%m/%Y}")
+        return self._taxas[moeda][i - 1]
