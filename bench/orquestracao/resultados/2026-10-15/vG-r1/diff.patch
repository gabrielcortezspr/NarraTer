@@ -0,0 +1,117 @@
+import os
+import unittest
+from datetime import date
+from decimal import Decimal as D
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+
+from .util import csv_temp
+
+CABECALHO_CAMBIO = "data,moeda,taxa\n"
+EXEMPLO = os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv")
+
+
+def tabela(conteudo: str) -> TabelaCambio:
+    caminho = csv_temp(conteudo, cabecalho=CABECALHO_CAMBIO)
+    try:
+        return TabelaCambio.carregar(caminho)
+    finally:
+        os.remove(caminho)
+
+
+class TestCambio(unittest.TestCase):
+    def setUp(self):
+        self.t = tabela(
+            '02/03/2026,USD,"5,0125"\n'
+            '02/03/2026,EUR,"5,4410"\n'
+            '05/03/2026,USD,"5,0870"\n'
+            '09/03/2026,EUR,"5,5005"\n'
+        )
+
+    def test_taxa_da_propria_data(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 2)), D("5.0125"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 5)), D("5.0870"))
+
+    def test_taxa_usa_data_anterior_mais_recente(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 4)), D("5.0125"))
+        self.assertEqual(self.t.taxa("EUR", date(2026, 3, 20)), D("5.5005"))
+
+    def test_taxa_e_decimal_exato(self):
+        self.assertIsInstance(self.t.taxa("USD", date(2026, 3, 2)), D)
+
+    def test_brl_sempre_um(self):
+        self.assertEqual(self.t.taxa("BRL", date(2020, 1, 1)), D(1))
+        self.assertEqual(self.t.taxa("brl", date(2026, 3, 2)), D(1))
+
+    def test_moeda_case_insensitive(self):
+        self.assertEqual(self.t.taxa("usd", date(2026, 3, 2)), D("5.0125"))
+        self.assertEqual(self.t.taxa("Eur", date(2026, 3, 9)), D("5.5005"))
+
+    def test_sem_taxa_ate_a_data_erro_com_moeda(self):
+        with self.assertRaises(ErroCambio) as cm:
+            self.t.taxa("USD", date(2026, 3, 1))
+        self.assertIn("USD", str(cm.exception))
+
+    def test_moeda_desconhecida_erro_com_moeda(self):
+        with self.assertRaises(ErroCambio) as cm:
+            self.t.taxa("GBP", date(2026, 3, 9))
+        self.assertIn("GBP", str(cm.exception))
+
+    def test_erro_cambio_e_value_error(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+    def test_carrega_linhas_fora_de_ordem(self):
+        t = tabela('09/03/2026,USD,"5,2000"\n02/03/2026,USD,"5,0000"\n')
+        self.assertEqual(t.taxa("USD", date(2026, 3, 5)), D("5.0000"))
+        self.assertEqual(t.taxa("USD", date(2026, 3, 9)), D("5.2000"))
+
+    def test_carrega_exemplo_do_repositorio(self):
+        t = TabelaCambio.carregar(EXEMPLO)
+        self.assertEqual(t.taxa("USD", date(2026, 3, 2)), D("5.0125"))
+        self.assertEqual(t.taxa("EUR", date(2026, 3, 8)), D("5.4410"))
+
+    def test_moeda_do_csv_em_minusculas(self):
+        t = tabela('02/03/2026,usd,"5,0125"\n')
+        self.assertEqual(t.taxa("USD", date(2026, 3, 2)), D("5.0125"))
+
+    def test_taxa_com_ponto_decimal_erro(self):
+        with self.assertRaises(ErroCambio) as cm:
+            tabela('02/03/2026,USD,"5.0125"\n')
+        self.assertIn("linha 2", str(cm.exception))
+
+    def test_taxa_nao_positiva_erro(self):
+        with self.assertRaises(ErroCambio):
+            tabela('02/03/2026,USD,"0"\n')
+        with self.assertRaises(ErroCambio):
+            tabela('02/03/2026,USD,"-1,00"\n')
+
+    def test_data_invalida_erro(self):
+        with self.assertRaises(ErroCambio) as cm:
+            tabela('2026-03-02,USD,"5,0125"\n')
+        self.assertIn("linha 2", str(cm.exception))
+
+    def test_taxa_duplicada_erro(self):
+        with self.assertRaises(ErroCambio):
+            tabela('02/03/2026,USD,"5,0125"\n02/03/2026,usd,"5,0200"\n')
+
+    def test_linha_curta_erro_com_numero_da_linha(self):
+        with self.assertRaises(ErroCambio) as cm:
+            tabela('02/03/2026,USD,"5,0125"\n02/03/2026,USD\n')
+        self.assertIn("linha 3", str(cm.exception))
+
+    def test_linha_com_campo_extra_erro_com_numero_da_linha(self):
+        with self.assertRaises(ErroCambio) as cm:
+            tabela('02/03/2026,USD,"5,0125",extra\n')
+        self.assertIn("linha 2", str(cm.exception))
+
+    def test_cabecalho_faltando_coluna_erro(self):
+        caminho = csv_temp('02/03/2026,USD\n', cabecalho="data,moeda\n")
+        try:
+            with self.assertRaises(ErroCambio):
+                TabelaCambio.carregar(caminho)
+        finally:
+            os.remove(caminho)
+
+
+if __name__ == "__main__":
+    unittest.main()
