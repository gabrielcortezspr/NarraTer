+"""Tabela de câmbio (ver docs/PEDIDO-MULTIMOEDA.md, seção Câmbio).
+
+CSV com colunas `data, moeda, taxa`: `data` em dd/mm/aaaa, `taxa` com vírgula decimal
+(quantos reais vale 1 unidade da moeda).
+"""
+
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+MOEDA_BASE = "BRL"
+COLUNAS = ("data", "moeda", "taxa")
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+class TabelaCambio:
+    def __init__(self):
+        # moeda -> (datas ordenadas, taxas na mesma ordem)
+        self._datas: dict[str, list[date]] = {}
+        self._taxas: dict[str, list[Decimal]] = {}
+
+    @classmethod
+    def carregar(cls, caminho: str) -> "TabelaCambio":
+        tabela = cls()
+        with open(caminho, newline="", encoding="utf-8-sig") as f:
+            leitor = csv.DictReader(f)
+            if not leitor.fieldnames or not set(COLUNAS) <= set(leitor.fieldnames):
+                raise ErroCambio(f"cabeçalho do câmbio deve conter {', '.join(COLUNAS)}")
+            vistos = set()
+            for linha in leitor:
+                n = leitor.line_num
+                # DictReader põe None nas colunas que faltam na linha (linha curta)
+                if None in linha.values() or None in linha:
+                    raise ErroCambio(f"linha {n}: número de campos diferente do cabeçalho")
+                data = _data(linha["data"], n)
+                moeda = linha["moeda"].strip().upper()
+                taxa = _taxa(linha["taxa"], n)
+                if (data, moeda) in vistos:
+                    raise ErroCambio(f"linha {n}: taxa duplicada de {moeda} em {linha['data'].strip()}")
+                vistos.add((data, moeda))
+                tabela._datas.setdefault(moeda, []).append(data)
+                tabela._taxas.setdefault(moeda, []).append(taxa)
+        for moeda, datas in tabela._datas.items():
+            pares = sorted(zip(datas, tabela._taxas[moeda]))
+            tabela._datas[moeda] = [d for d, _ in pares]
+            tabela._taxas[moeda] = [t for _, t in pares]
+        return tabela
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        """Taxa da própria data ou da data anterior mais recente; BRL é sempre 1."""
+        moeda = moeda.strip().upper()
+        if moeda == MOEDA_BASE:
+            return Decimal(1)
+        datas = self._datas.get(moeda, [])
+        i = bisect_right(datas, data) - 1
+        if i < 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} até {data:%d/%m/%Y}")
+        return self._taxas[moeda][i]
+
+
+def _data(texto: str, linha: int) -> date:
+    try:
+        return datetime.strptime(texto.strip(), "%d/%m/%Y").date()
+    except ValueError:
+        raise ErroCambio(f"linha {linha}: data inválida '{texto}'") from None
+
+
+def _taxa(texto: str, linha: int) -> Decimal:
+    t = texto.strip()
+    if "." in t:
+        raise ErroCambio(f"linha {linha}: use vírgula decimal na taxa ('{texto}')")
+    try:
+        valor = Decimal(t.replace(",", "."))
+    except InvalidOperation:
+        raise ErroCambio(f"linha {linha}: taxa inválida '{texto}'") from None
+    if not valor.is_finite() or valor <= 0:
+        raise ErroCambio(f"linha {linha}: taxa deve ser positiva ('{texto}')")
+    return valor
