+import unittest
+from datetime import date
+from decimal import Decimal
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+from pedidos.importa import ErroImportacao, ler_pedidos
+from pedidos.modelo import Item, Pedido
+from pedidos.preco import calcular
+
+from .test_relatorio import rodar
+from .util import csv_temp
+
+CAB = "id,cliente,data,sku,qtd,preco_unit,categoria,moeda\n"
+CAMBIO = csv_temp('02/03/2026,USD,"5,0125"\n05/03/2026,USD,"5,0870"\n09/03/2026,EUR,"5,5005"\n',
+                  cabecalho="data,moeda,taxa\n")
+
+
+class TestImportaMoeda(unittest.TestCase):
+    def test_padrao_brl_sem_coluna(self):
+        p = ler_pedidos(csv_temp('P,A,01/03/2026,x,1,"1,00",l\n'))[0]
+        self.assertEqual(p.moeda, "BRL")
+
+    def test_vazia_e_minuscula(self):
+        ps = ler_pedidos(csv_temp('P,A,01/03/2026,x,1,"1,00",l,\nQ,A,01/03/2026,x,1,"1,00",l,usd\n', CAB))
+        self.assertEqual([p.moeda for p in ps], ["BRL", "USD"])
+
+    def test_invalida_com_linha(self):
+        with self.assertRaisesRegex(ErroImportacao, "linha 3"):
+            ler_pedidos(csv_temp('P,A,01/03/2026,x,1,"1,00",l,USD\nQ,A,01/03/2026,x,1,"1,00",l,GBP\n', CAB))
+
+    def test_moedas_misturadas(self):
+        with self.assertRaisesRegex(ErroImportacao, "P-9"):
+            ler_pedidos(csv_temp('P-9,A,01/03/2026,x,1,"1,00",l,USD\nP-9,A,01/03/2026,x,1,"1,00",l,EUR\n', CAB))
+
+
+class TestTabela(unittest.TestCase):
+    def setUp(self):
+        self.t = TabelaCambio.carregar(CAMBIO)
+
+    def test_exata_e_anterior(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 5)), Decimal("5.0870"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 4)), Decimal("5.0125"))
+        self.assertEqual(self.t.taxa("usd", date(2026, 4, 1)), Decimal("5.0870"))
+
+    def test_brl(self):
+        self.assertEqual(self.t.taxa("BRL", date(2000, 1, 1)), 1)
+
+    def test_sem_taxa(self):
+        with self.assertRaisesRegex(ErroCambio, "USD"):
+            self.t.taxa("USD", date(2026, 3, 1))
+        with self.assertRaisesRegex(ErroCambio, "EUR"):
+            self.t.taxa("EUR", date(2026, 3, 8))
+
+
+class TestCalculo(unittest.TestCase):
+    def pedido(self, moeda):
+        return Pedido("P", "A", date(2026, 3, 6), [Item("x", 3, Decimal("33.33"), "papelaria")], moeda)
+
+    def test_conversao(self):
+        r = calcular(self.pedido("USD"), TabelaCambio.carregar(CAMBIO))
+        self.assertEqual(r.subtotal, Decimal("508.65"))  # 3*33.33*5.0870
+        self.assertEqual(r.desconto, Decimal("0.43"))  # 5% de 8,65
+
+    def test_sem_tabela(self):
+        with self.assertRaises(ErroCambio):
+            calcular(self.pedido("USD"))
+        self.assertEqual(calcular(self.pedido("BRL")).subtotal, Decimal("99.99"))
+
+
+class TestRelatorioMoeda(unittest.TestCase):
+    def setUp(self):
+        self.csv = csv_temp('P,A,06/03/2026,x,3,"33,33",papelaria,usd\n', CAB)
+
+    def test_json(self):
+        import json
+        c, out, _ = rodar(self.csv, "--cambio", CAMBIO, "--json")
+        d = json.loads(out)[0]
+        self.assertEqual((c, d["moeda"], d["subtotal_original"], d["subtotal"]), (0, "USD", "99.99", "508.65"))
+
+    def test_texto_tem_moeda(self):
+        c, out, _ = rodar(self.csv, "--cambio", CAMBIO)
+        self.assertEqual(c, 0)
+        self.assertIn("USD", out)
+
+    def test_sem_cambio(self):
+        c, _, err = rodar(self.csv)
+        self.assertEqual((c, err.startswith("erro:")), (2, True))
+
+    def test_taxa_inexistente(self):
+        c, _, err = rodar(csv_temp('P,A,01/03/2026,x,1,"1,00",l,USD\n', CAB), "--cambio", CAMBIO)
+        self.assertEqual((c, err.startswith("erro:")), (2, True))
+
+    def test_cambio_ausente(self):
+        self.assertEqual(rodar(self.csv, "--cambio", "/nao/existe.csv")[0], 2)
+
+
+class TestRegrasSobreValorConvertido(unittest.TestCase):
+    """Taxa USD em 06/03/2026 = 5,0870; limites de REGRAS.md valem em reais convertidos."""
+
+    def calc(self, preco):
+        p = Pedido("P", "A", date(2026, 3, 6), [Item("x", 1, Decimal(preco), "papelaria")], "USD")
+        return calcular(p, TabelaCambio.carregar(CAMBIO))
+
+    def test_frete_abaixo_de_300(self):
+        r = self.calc("58.97")  # 299,97 BRL
+        self.assertEqual((r.subtotal, r.frete), (Decimal("299.98"), Decimal("25.00")))
+
+    def test_frete_gratis_acima_de_300(self):
+        r = self.calc("58.98")  # 300,03 BRL, embora 58,98 < 300 na moeda original
+        self.assertEqual((r.subtotal, r.frete), (Decimal("300.03"), Decimal("0.00")))
+
+    def test_sem_desconto_abaixo_de_500(self):
+        r = self.calc("98.28")  # 499,95 BRL
+        self.assertEqual((r.subtotal, r.desconto), (Decimal("499.95"), Decimal("0.00")))
+
+    def test_desconto_acima_de_500(self):
+        r = self.calc("98.40")  # 500,56 BRL; 5% de 0,56 = 0,03
+        self.assertEqual((r.subtotal, r.desconto), (Decimal("500.56"), Decimal("0.03")))
+
+
+class TestErrosCarregar(unittest.TestCase):
+    def carregar(self, conteudo, cab="data,moeda,taxa\n"):
+        return TabelaCambio.carregar(csv_temp(conteudo, cabecalho=cab))
+
+    def test_coluna_ausente(self):
+        with self.assertRaisesRegex(ErroCambio, "taxa"):
+            self.carregar('02/03/2026,USD\n', cab="data,moeda\n")
+
+    def test_taxa_invalida(self):
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            self.carregar('02/03/2026,USD,"abc"\n')
+
+    def test_taxa_zero_e_negativa(self):
+        for t in ('"0,00"', '"-5,00"'):
+            with self.assertRaisesRegex(ErroCambio, "linha 2"):
+                self.carregar(f'02/03/2026,USD,{t}\n')
+
+    def test_data_repetida_vale_a_ultima(self):
+        t = self.carregar('02/03/2026,USD,"5,00"\n02/03/2026,USD,"6,00"\n')
+        self.assertEqual(t.taxa("USD", date(2026, 3, 2)), Decimal("6.00"))
+
+
+class TestIntercaladas(unittest.TestCase):
+    def test_moedas_diferentes(self):
+        c = csv_temp('P-1,A,01/03/2026,x,1,"1,00",l,USD\nP-2,B,01/03/2026,x,1,"1,00",l,BRL\n'
+                     'P-1,A,01/03/2026,y,1,"1,00",l,EUR\n', CAB)
+        with self.assertRaisesRegex(ErroImportacao, "P-1"):
+            ler_pedidos(c)
