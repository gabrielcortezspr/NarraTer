@@ -0,0 +1,125 @@
+import os
+import unittest
+from datetime import date
+from decimal import Decimal as D
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+from tests.util import csv_temp
+
+CABECALHO_CAMBIO = "data,moeda,taxa\n"
+CSV_EXEMPLO = os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv")
+
+
+def tabela_temp(conteudo: str) -> TabelaCambio:
+    caminho = csv_temp(conteudo, cabecalho=CABECALHO_CAMBIO)
+    try:
+        return TabelaCambio.carregar(caminho)
+    finally:
+        os.remove(caminho)
+
+
+class TestCarregar(unittest.TestCase):
+    def test_carrega_arquivo_de_exemplo(self):
+        tabela = TabelaCambio.carregar(CSV_EXEMPLO)
+        self.assertEqual(tabela.taxa("USD", date(2026, 3, 2)), D("5.0125"))
+        self.assertEqual(tabela.taxa("EUR", date(2026, 3, 9)), D("5.5005"))
+
+    def test_virgula_decimal_vira_decimal_exato(self):
+        tabela = tabela_temp('02/03/2026,USD,"5,0125"\n')
+        self.assertEqual(tabela.taxa("USD", date(2026, 3, 2)), D("5.0125"))
+
+    def test_linha_em_branco_e_ignorada(self):
+        tabela = tabela_temp('02/03/2026,USD,"5,0125"\n\n')
+        self.assertEqual(tabela.taxa("USD", date(2026, 3, 2)), D("5.0125"))
+
+    def test_cabecalho_errado(self):
+        caminho = csv_temp("", cabecalho="data,moeda,valor\n")
+        self.addCleanup(os.remove, caminho)
+        with self.assertRaisesRegex(ErroCambio, "linha 1"):
+            TabelaCambio.carregar(caminho)
+
+    def test_data_invalida_com_numero_da_linha(self):
+        caminho = csv_temp('02/03/2026,USD,"5,0125"\n31/02/2026,USD,"5,1"\n',
+                           cabecalho=CABECALHO_CAMBIO)
+        self.addCleanup(os.remove, caminho)
+        with self.assertRaisesRegex(ErroCambio, "linha 3"):
+            TabelaCambio.carregar(caminho)
+
+    def test_taxa_invalida_com_numero_da_linha(self):
+        caminho = csv_temp('02/03/2026,USD,"abc"\n', cabecalho=CABECALHO_CAMBIO)
+        self.addCleanup(os.remove, caminho)
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            TabelaCambio.carregar(caminho)
+
+    def test_taxa_nao_positiva(self):
+        for taxa in ['"0,00"', '"-5,0"']:
+            with self.subTest(taxa=taxa):
+                caminho = csv_temp(f"02/03/2026,USD,{taxa}\n", cabecalho=CABECALHO_CAMBIO)
+                self.addCleanup(os.remove, caminho)
+                with self.assertRaisesRegex(ErroCambio, "linha 2"):
+                    TabelaCambio.carregar(caminho)
+
+    def test_numero_de_colunas_errado(self):
+        caminho = csv_temp("02/03/2026,USD\n", cabecalho=CABECALHO_CAMBIO)
+        self.addCleanup(os.remove, caminho)
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            TabelaCambio.carregar(caminho)
+
+    def test_moeda_vazia(self):
+        caminho = csv_temp('02/03/2026,,"5,0"\n', cabecalho=CABECALHO_CAMBIO)
+        self.addCleanup(os.remove, caminho)
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            TabelaCambio.carregar(caminho)
+
+    def test_taxa_repetida_na_mesma_data(self):
+        caminho = csv_temp('02/03/2026,USD,"5,0"\n02/03/2026,usd,"5,1"\n',
+                           cabecalho=CABECALHO_CAMBIO)
+        self.addCleanup(os.remove, caminho)
+        with self.assertRaisesRegex(ErroCambio, "linha 3"):
+            TabelaCambio.carregar(caminho)
+
+    def test_erro_cambio_e_value_error(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+
+class TestTaxa(unittest.TestCase):
+    def setUp(self):
+        self.tabela = TabelaCambio.carregar(CSV_EXEMPLO)
+
+    def test_taxa_da_propria_data(self):
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 5)), D("5.0870"))
+
+    def test_usa_data_anterior_mais_recente(self):
+        # 03/03 e 04/03 não têm taxa de USD: vale a de 02/03
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 3, 4)), D("5.0125"))
+        # depois de 05/03 continua valendo a última
+        self.assertEqual(self.tabela.taxa("USD", date(2026, 12, 31)), D("5.0870"))
+
+    def test_moeda_case_insensitive(self):
+        self.assertEqual(self.tabela.taxa("usd", date(2026, 3, 2)), D("5.0125"))
+        self.assertEqual(self.tabela.taxa("Eur", date(2026, 3, 2)), D("5.4410"))
+
+    def test_brl_sempre_um(self):
+        self.assertEqual(self.tabela.taxa("BRL", date(1990, 1, 1)), D(1))
+        self.assertEqual(self.tabela.taxa("brl", date(2030, 1, 1)), D(1))
+
+    def test_brl_sem_tabela_vazia(self):
+        self.assertEqual(TabelaCambio().taxa("BRL", date(2026, 1, 1)), D(1))
+
+    def test_antes_da_primeira_taxa_erro_com_moeda(self):
+        with self.assertRaises(ErroCambio) as ctx:
+            self.tabela.taxa("USD", date(2026, 3, 1))
+        self.assertIn("USD", str(ctx.exception))
+
+    def test_moeda_desconhecida_erro_com_moeda(self):
+        with self.assertRaises(ErroCambio) as ctx:
+            self.tabela.taxa("GBP", date(2026, 3, 2))
+        self.assertIn("GBP", str(ctx.exception))
+
+    def test_erro_cambio_capturavel_como_value_error(self):
+        with self.assertRaises(ValueError):
+            self.tabela.taxa("USD", date(2025, 1, 1))
+
+
+if __name__ == "__main__":
+    unittest.main()
