+                     self.tabela)
+        self.assertEqual(r.subtotal, D("501.25"))
+        self.assertEqual(r.desconto, D("0.06"))
+        self.assertEqual(r.frete, D("0.00"))
+
+    def test_resumo_traz_moeda_e_subtotal_original(self):
+        r = calcular(pedido_em("USD", date(2026, 3, 2), ("A", 2, D("10.00"), "papelaria")),
