+"""Tabela de câmbio: quantos reais vale 1 unidade de cada moeda, por data."""
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+MOEDA_BASE = "BRL"
+CABECALHO = ["data", "moeda", "taxa"]
+
+
+class ErroCambio(ValueError):
+    """Taxa inexistente ou CSV de câmbio malformado."""
+
+
+class TabelaCambio:
+    def __init__(self, taxas: dict[str, list[tuple[date, Decimal]]] | None = None):
+        # moeda -> [(data, taxa)] ordenado por data
+        self._taxas = taxas or {}
+
+    @classmethod
+    def carregar(cls, caminho: str) -> "TabelaCambio":
+        taxas: dict[str, dict[date, Decimal]] = {}
+        with open(caminho, encoding="utf-8", newline="") as f:
+            leitor = csv.reader(f)
+            cabecalho = next(leitor, None)
+            if cabecalho is None or [c.strip() for c in cabecalho] != CABECALHO:
+                raise ErroCambio(f"linha 1: cabeçalho deve ser {','.join(CABECALHO)}")
+            for linha in leitor:
+                numero = leitor.line_num
+                if not any(c.strip() for c in linha):
+                    continue
+                if len(linha) != 3:
+                    raise ErroCambio(f"linha {numero}: esperado 3 colunas, veio {len(linha)}")
+                data_txt, moeda, taxa_txt = (c.strip() for c in linha)
+                data = _data(data_txt, numero)
+                moeda = _moeda(moeda, numero)
+                taxa = _taxa(taxa_txt, numero)
+                por_data = taxas.setdefault(moeda, {})
+                if data in por_data:
+                    raise ErroCambio(f"linha {numero}: taxa de {moeda} repetida em {data_txt}")
+                por_data[data] = taxa
+        return cls({m: sorted(d.items()) for m, d in taxas.items()})
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        """Taxa da data ou da data anterior mais recente."""
+        moeda = moeda.strip().upper()
+        if moeda == MOEDA_BASE:
+            return Decimal(1)
+        historico = self._taxas.get(moeda, [])
+        # índice do primeiro registro posterior a `data`
+        i = bisect_right(historico, (data, Decimal("Infinity")))
+        if i == 0:
+            raise ErroCambio(f"sem taxa de {moeda} até {data.strftime('%d/%m/%Y')}")
+        return historico[i - 1][1]
+
+
+def _data(texto: str, numero: int) -> date:
+    try:
+        return datetime.strptime(texto, "%d/%m/%Y").date()
+    except ValueError:
+        raise ErroCambio(f"linha {numero}: data inválida {texto!r} (use dd/mm/aaaa)") from None
+
+
+def _moeda(texto: str, numero: int) -> str:
+    if not texto:
+        raise ErroCambio(f"linha {numero}: moeda vazia")
+    return texto.upper()
+
+
+def _taxa(texto: str, numero: int) -> Decimal:
+    try:
+        valor = Decimal(texto.replace(",", "."))
+    except InvalidOperation:
+        raise ErroCambio(f"linha {numero}: taxa inválida {texto!r}") from None
+    if not valor.is_finite() or valor <= 0:
+        raise ErroCambio(f"linha {numero}: taxa deve ser positiva, veio {texto!r}")
+    return valor
