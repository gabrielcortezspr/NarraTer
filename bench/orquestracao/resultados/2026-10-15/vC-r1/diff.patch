@@ -0,0 +1,164 @@
+import contextlib
+import io
+import json
+import os
+import unittest
+from datetime import date
+from decimal import Decimal
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+from pedidos.importa import ErroImportacao, ler_pedidos
+from pedidos.modelo import Item, Pedido
+from pedidos.preco import calcular
+from pedidos.relatorio import main
+
+from .util import csv_temp
+
+CAB = "id,cliente,data,sku,qtd,preco_unit,categoria,moeda\n"
+CAMBIO = os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv")
+
+
+def rodar(*args):
+    out, err = io.StringIO(), io.StringIO()
+    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+        codigo = main(list(args))
+    return codigo, out.getvalue(), err.getvalue()
+
+
+class TestImportaMoeda(unittest.TestCase):
+    def test_padrao_brl_sem_coluna(self):
+        p = ler_pedidos(csv_temp('P,A,01/03/2026,X,1,"10,00",x\n'))[0]
+        self.assertEqual(p.moeda, "BRL")
+
+    def test_celula_vazia_e_minuscula(self):
+        ps = ler_pedidos(csv_temp('P,A,01/03/2026,X,1,"10,00",x,\nQ,A,01/03/2026,X,1,"10,00",x,usd\n', CAB))
+        self.assertEqual([p.moeda for p in ps], ["BRL", "USD"])
+
+    def test_moeda_invalida_cita_linha(self):
+        with self.assertRaisesRegex(ErroImportacao, "linha 2"):
+            ler_pedidos(csv_temp('P,A,01/03/2026,X,1,"10,00",x,GBP\n', CAB))
+
+    def test_moedas_mistas_citam_id(self):
+        c = csv_temp('P-9,A,01/03/2026,X,1,"10,00",x,USD\nP-9,A,01/03/2026,Y,1,"10,00",x,EUR\n', CAB)
+        with self.assertRaises(ErroImportacao) as ctx:
+            ler_pedidos(c)
+        self.assertIn("linha 3", str(ctx.exception))
+        self.assertIn("P-9", str(ctx.exception))
+
+
+class TestTabela(unittest.TestCase):
+    def setUp(self):
+        self.t = TabelaCambio.carregar(CAMBIO)
+
+    def test_data_exata_e_anterior(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 2)), Decimal("5.0125"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 4)), Decimal("5.0125"))
+        self.assertEqual(self.t.taxa("usd", date(2026, 3, 10)), Decimal("5.0870"))
+        self.assertEqual(self.t.taxa("EUR", date(2026, 3, 8)), Decimal("5.4410"))
+
+    def test_brl_e_um(self):
+        self.assertEqual(self.t.taxa("BRL", date(2000, 1, 1)), Decimal(1))
+
+    def test_sem_taxa(self):
+        with self.assertRaisesRegex(ErroCambio, "USD"):
+            self.t.taxa("USD", date(2026, 3, 1))
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+
+class TestCalculo(unittest.TestCase):
+    def pedido(self, moeda, qtd=3, preco="100.00", data=date(2026, 3, 2)):
+        return Pedido("P", "A", data, [Item("X", qtd, Decimal(preco), "x")], moeda)
+
+    def test_conversao_e_regras_em_reais(self):
+        t = TabelaCambio.carregar(CAMBIO)
+        r = calcular(self.pedido("USD"), t)  # 3 x 100 x 5,0125 = 1503,75
+        self.assertEqual(r.subtotal, Decimal("1503.75"))
+        self.assertEqual(r.desconto, Decimal("65.30"))  # 5% x 500 + 8% x 503,75
+        self.assertEqual(r.frete, Decimal("0.00"))
+
+    def test_arredondamento_meio_par(self):
+        t = TabelaCambio([(date(2026, 1, 1), "USD", Decimal("0.5"))])
+        self.assertEqual(calcular(self.pedido("USD", 1, "0.05"), t).subtotal, Decimal("0.02"))
+
+    def test_sem_tabela(self):
+        with self.assertRaises(ErroCambio):
+            calcular(self.pedido("EUR"))
+        self.assertEqual(calcular(self.pedido("BRL")).subtotal, Decimal("300.00"))
+
+
+class TestRegrasEmReais(unittest.TestCase):
+    T = TabelaCambio([(date(2026, 1, 1), "USD", Decimal("5.0125"))])
+
+    def pedido(self, qtd, categoria="x", moeda="USD"):
+        return Pedido("P", "A", date(2026, 3, 2), [Item("X", qtd, Decimal("1"), categoria)], moeda)
+
+    def test_frete_depois_da_conversao(self):
+        r = calcular(self.pedido(60), self.T)  # 300,75
+        self.assertEqual((r.subtotal, r.frete), (Decimal("300.75"), Decimal("0.00")))
+        r = calcular(self.pedido(59), self.T)  # 295,74
+        self.assertEqual((r.subtotal, r.frete), (Decimal("295.74"), Decimal("25.00")))
+
+    def test_livros_isentos_em_usd(self):
+        self.assertEqual(calcular(self.pedido(10, "livros"), self.T).imposto, Decimal("0.00"))
+
+    def test_moeda_minuscula_no_modelo(self):
+        self.assertEqual(calcular(self.pedido(1, moeda="brl")).subtotal, Decimal("1.00"))
+        self.assertEqual(calcular(self.pedido(1, moeda=" usd "), self.T).subtotal, Decimal("5.01"))
+
+
+class TestArquivoCambioInvalido(unittest.TestCase):
+    def carregar(self, taxa):
+        return TabelaCambio.carregar(csv_temp(f"02/03/2026,USD,{taxa}\n", "data,moeda,taxa\n"))
+
+    def test_taxa_vazia(self):
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            self.carregar("")
+
+    def test_taxa_negativa(self):
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            self.carregar('"-5,0"')
+
+    def test_taxa_com_ponto(self):
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            self.carregar("5.0125")
+
+
+class TestRelatorioCambio(unittest.TestCase):
+    def setUp(self):
+        self.csv = csv_temp(
+            'P-1,Acme,02/03/2026,A,2,"10,00",x,USD\nP-2,Bia,02/03/2026,B,1,"10,00",x,\n', CAB
+        )
+
+    def test_json(self):
+        codigo, out, _ = rodar(self.csv, "--cambio", CAMBIO, "--json")
+        self.assertEqual(codigo, 0)
+        d = json.loads(out)
+        self.assertEqual((d[0]["moeda"], d[0]["subtotal_original"], d[0]["subtotal"]), ("USD", "20.00", "100.25"))
+        self.assertEqual((d[1]["moeda"], d[1]["subtotal"]), ("BRL", "10.00"))
+
+    def test_texto_tem_moeda(self):
+        _, out, _ = rodar(self.csv, "--cambio", CAMBIO)
+        self.assertIn("moeda", out)
+        self.assertIn("USD", out)
+
+    def test_sem_cambio(self):
+        codigo, _, err = rodar(self.csv)
+        self.assertEqual(codigo, 2)
+        self.assertTrue(err.startswith("erro:"))
+
+    def test_taxa_inexistente(self):
+        c = csv_temp('P,A,01/01/2020,A,1,"10,00",x,USD\n', CAB)
+        codigo, _, err = rodar(c, "--cambio", CAMBIO)
+        self.assertEqual(codigo, 2)
+        self.assertIn("USD", err)
+
+    def test_cambio_ausente(self):
+        self.assertEqual(rodar(self.csv, "--cambio", "/nao/existe.csv")[0], 2)
+
+    def test_so_brl_sem_cambio(self):
+        c = csv_temp('P,A,01/03/2026,A,1,"10,00",x\n')
+        self.assertEqual(rodar(c)[0], 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
