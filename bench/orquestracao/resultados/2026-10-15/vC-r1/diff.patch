+"""Tabela de câmbio: CSV com colunas data, moeda, taxa (reais por 1 unidade da moeda)."""
+
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+class TabelaCambio:
+    def __init__(self, taxas=None):
+        """`taxas`: iterável de (data, moeda, Decimal)."""
+        self._por_moeda: dict[str, list[tuple[date, Decimal]]] = {}
+        for data, moeda, taxa in taxas or ():
+            self._por_moeda.setdefault(moeda.upper(), []).append((data, taxa))
+        for lista in self._por_moeda.values():
+            lista.sort(key=lambda t: t[0])
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        taxas = []
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            faltando = [c for c in ("data", "moeda", "taxa") if c not in (leitor.fieldnames or [])]
+            if faltando:
+                raise ErroCambio(f"colunas ausentes no câmbio: {', '.join(faltando)}")
+            for n, l in enumerate(leitor, start=2):
+                if "." in (l["taxa"] or ""):
+                    raise ErroCambio(f"câmbio, linha {n}: use vírgula decimal ('{l['taxa']}')")
+                try:
+                    data = datetime.strptime((l["data"] or "").strip(), "%d/%m/%Y").date()
+                    taxa = Decimal((l["taxa"] or "").strip().replace(",", "."))
+                except (ValueError, InvalidOperation):
+                    raise ErroCambio(f"câmbio, linha {n}: data ou taxa inválida") from None
+                if not taxa.is_finite() or taxa <= 0:
+                    raise ErroCambio(f"câmbio, linha {n}: taxa inválida")
+                taxas.append((data, (l["moeda"] or "").strip().upper(), taxa))
+        return cls(taxas)
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        moeda = moeda.upper()
+        if moeda == "BRL":
+            return Decimal(1)
+        lista = self._por_moeda.get(moeda, [])
+        i = bisect_right([d for d, _ in lista], data)
+        if i == 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} até {data:%d/%m/%Y}")
+        return lista[i - 1][1]
