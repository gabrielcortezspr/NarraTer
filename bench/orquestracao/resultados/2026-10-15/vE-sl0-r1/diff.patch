+"""Tabela de câmbio: quantos reais vale 1 unidade de cada moeda, por data."""
+
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+MOEDA_BASE = "BRL"
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+class TabelaCambio:
+    def __init__(self, taxas: dict[str, dict[date, Decimal]] | None = None):
+        self._taxas = {m.upper(): dict(t) for m, t in (taxas or {}).items()}
+        self._datas = {m: sorted(t) for m, t in self._taxas.items()}
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        taxas: dict[str, dict[date, Decimal]] = {}
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            faltando = [c for c in ("data", "moeda", "taxa") if c not in (leitor.fieldnames or [])]
+            if faltando:
+                raise ErroCambio(f"câmbio: colunas ausentes: {', '.join(faltando)}")
+            for n, linha in enumerate(leitor, start=2):
+                try:
+                    data = datetime.strptime((linha["data"] or "").strip(), "%d/%m/%Y").date()
+                except ValueError:
+                    raise ErroCambio(f"câmbio, linha {n}: data inválida '{linha['data']}'") from None
+                texto = (linha["taxa"] or "").strip()
+                try:
+                    taxa = Decimal(texto.replace(",", "."))
+                except InvalidOperation:
+                    raise ErroCambio(f"câmbio, linha {n}: taxa inválida '{texto}'") from None
+                if not taxa.is_finite() or taxa <= 0:
+                    raise ErroCambio(f"câmbio, linha {n}: taxa inválida '{texto}'")
+                moeda = (linha["moeda"] or "").strip().upper()
+                taxas.setdefault(moeda, {})[data] = taxa
+        return cls(taxas)
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        """Taxa da data ou da data anterior mais recente; BRL é sempre 1."""
+        moeda = moeda.upper()
+        if moeda == MOEDA_BASE:
+            return Decimal(1)
+        datas = self._datas.get(moeda, [])
+        i = bisect_right(datas, data)
+        if i == 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} até {data:%d/%m/%Y}")
+        return self._taxas[moeda][datas[i - 1]]
