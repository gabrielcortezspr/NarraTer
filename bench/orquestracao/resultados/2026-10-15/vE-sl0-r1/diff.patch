+class TestCalculoMoeda(unittest.TestCase):
+    def setUp(self):
+        self.t = TabelaCambio.carregar(CAMBIO)
+
+    def test_brl_sem_tabela(self):
+        self.assertEqual(calcular(pedido("BRL", [(1, "100.00", "x")])).total, Decimal("137.00"))
+
+    def test_estrangeiro_sem_tabela(self):
+        with self.assertRaises(ErroCambio):
+            calcular(pedido("USD", [(1, "10.00", "x")]))
+
+    def test_conversao_por_linha_arredonda_cada_linha(self):
+        # 3 × 1,10 × 5,0125 = 16,54125 -> 16,54 ; 1 × 2,00 × 5,0125 = 10,025 -> 10,02 (meio-para-par)
+        r = calcular(pedido("USD", [(3, "1.10", "x"), (1, "2.00", "x")]), self.t)
+        self.assertEqual(r.subtotal, Decimal("26.56"))
+
+    def test_meio_para_par(self):
+        t = TabelaCambio({"USD": {date(2026, 1, 1): Decimal("2.5")}})
+        r = calcular(pedido("USD", [(1, "0.01", "x"), (1, "0.03", "x")]), t)
+        self.assertEqual(r.subtotal, Decimal("0.10"))  # 0,02 + 0,08
+
+    def test_regras_em_reais_sobre_valor_convertido(self):
+        # 150 × 5,0125 = 751,875 -> 751,88 ; desconto 5% × 251,88 = 12,59 ; frete grátis
+        # imposto 12% × (751,88 − 12,59) = 88,71 ; total 751,88 − 12,59 + 88,71
+        r = calcular(pedido("USD", [(1, "150.00", "x")], date(2026, 3, 2)), self.t)
+        self.assertEqual(r.subtotal, Decimal("751.88"))
+        self.assertEqual(r.desconto, Decimal("12.59"))
+        self.assertEqual(r.frete, Decimal("0.00"))
+        self.assertEqual(r.imposto, Decimal("88.71"))
+        self.assertEqual(r.total, Decimal("828.00"))
+
+    def test_desconto_por_faixas_acima_de_mil_em_reais(self):
