+
+from .util import csv_temp
+
+CABECALHO_MOEDA = "id,cliente,data,sku,qtd,preco_unit,categoria,moeda\n"
+CAMBIO = os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv")
+
+
+def rodar(*args):
+    out, err = io.StringIO(), io.StringIO()
+    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+        codigo = main(list(args))
+    return codigo, out.getvalue(), err.getvalue()
+
+
+def pedido(moeda, itens, dia=date(2026, 3, 3)):
+    return Pedido(id="X", cliente="c", data=dia, moeda=moeda,
+                  itens=[Item("s", q, Decimal(p), cat) for q, p, cat in itens])
+
+
+class TestImportacaoMoeda(unittest.TestCase):
+    def test_sem_coluna_e_brl(self):
+        caminho = csv_temp('P-1,A,01/03/2026,S,1,"1,00",x\n')
+        self.assertEqual(ler_pedidos(caminho)[0].moeda, "BRL")
+
+    def test_celula_vazia_e_brl_e_minusculas(self):
+        caminho = csv_temp(
+            'P-1,A,01/03/2026,S,1,"1,00",x,\nP-2,A,01/03/2026,S,1,"1,00",x,usd\n',
+            CABECALHO_MOEDA,
+        )
+        self.assertEqual([p.moeda for p in ler_pedidos(caminho)], ["BRL", "USD"])
+
+    def test_moeda_invalida_cita_linha(self):
+        caminho = csv_temp(
+            'P-1,A,01/03/2026,S,1,"1,00",x,BRL\nP-2,A,01/03/2026,S,1,"1,00",x,GBP\n',
+            CABECALHO_MOEDA,
+        )
+        with self.assertRaisesRegex(ErroImportacao, "linha 3"):
+            ler_pedidos(caminho)
+
+    def test_moedas_diferentes_no_mesmo_pedido(self):
+        caminho = csv_temp(
+            'P-9,A,01/03/2026,S,1,"1,00",x,USD\nP-9,A,01/03/2026,T,1,"1,00",x,EUR\n',
+            CABECALHO_MOEDA,
+        )
+        with self.assertRaisesRegex(ErroImportacao, "P-9"):
+            ler_pedidos(caminho)
+
+    def test_vazio_e_moeda_estrangeira_no_mesmo_pedido_conflitam(self):
+        caminho = csv_temp(
+            'P-9,A,01/03/2026,S,1,"1,00",x,USD\nP-9,A,01/03/2026,T,1,"1,00",x,\n',
+            CABECALHO_MOEDA,
+        )
+        with self.assertRaisesRegex(ErroImportacao, "P-9"):
+            ler_pedidos(caminho)
+
+    def test_intercalado_mesma_moeda(self):
+        caminho = csv_temp(
+            'P-1,A,01/03/2026,S,1,"1,00",x,USD\n'
+            'P-2,B,02/03/2026,S,1,"2,00",x,EUR\n'
+            'P-1,A,09/09/2026,T,2,"3,00",x,usd\n',
+            CABECALHO_MOEDA,
+        )
+        ps = ler_pedidos(caminho)
