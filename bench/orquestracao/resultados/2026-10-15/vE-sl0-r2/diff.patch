+
+    def test_converte_cada_linha_e_arredonda(self):
+        # 3 × 1.01 × 5.0125 = 15.188... -> 15.19 ; 1 × 0.10 × 5.0125 = 0.50125 -> 0.50
+        r = calcular(pedido_moeda("USD", ("A", 3, D("1.01"), "livros"), ("B", 1, D("0.10"), "livros")), self.tabela)
+        self.assertEqual(r.subtotal, D("15.69"))
