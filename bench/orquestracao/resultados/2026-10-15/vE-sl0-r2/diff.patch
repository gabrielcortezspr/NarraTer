@@ -0,0 +1,55 @@
+"""Tabela de câmbio (docs/PEDIDO-MULTIMOEDA.md): quantos reais vale 1 unidade da moeda."""
+
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+COLUNAS = ("data", "moeda", "taxa")
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+class TabelaCambio:
+    def __init__(self, taxas=None):
+        """`taxas`: iterável de (data, moeda, taxa)."""
+        self._por_moeda: dict[str, list[tuple[date, Decimal]]] = {}
+        for data, moeda, taxa in taxas or ():
+            self._por_moeda.setdefault(moeda.strip().upper(), []).append((data, Decimal(taxa)))
+        for lista in self._por_moeda.values():
+            lista.sort(key=lambda t: t[0])
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        taxas = []
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            faltando = [c for c in COLUNAS if c not in (leitor.fieldnames or [])]
+            if faltando:
+                raise ErroCambio(f"câmbio: colunas ausentes: {', '.join(faltando)}")
+            for n, l in enumerate(leitor, start=2):
+                try:
+                    data = datetime.strptime((l["data"] or "").strip(), "%d/%m/%Y").date()
+                except ValueError:
+                    raise ErroCambio(f"câmbio, linha {n}: data inválida '{l['data']}'") from None
+                texto = (l["taxa"] or "").strip()
+                try:
+                    taxa = Decimal(texto.replace(",", "."))
+                except InvalidOperation:
+                    raise ErroCambio(f"câmbio, linha {n}: taxa inválida '{texto}'") from None
+                if not taxa.is_finite() or taxa <= 0:
+                    raise ErroCambio(f"câmbio, linha {n}: taxa inválida '{texto}'")
+                taxas.append((data, (l["moeda"] or "").strip().upper(), taxa))
+        return cls(taxas)
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        moeda = moeda.strip().upper()
+        if moeda == "BRL":
+            return Decimal(1)
+        lista = self._por_moeda.get(moeda, [])
+        i = bisect_right(lista, data, key=lambda t: t[0])
+        if i == 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} em {data:%d/%m/%Y}")
+        return lista[i - 1][1]
