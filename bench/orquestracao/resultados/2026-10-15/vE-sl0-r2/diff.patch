@@ -0,0 +1,67 @@
+import os
+import tempfile
+import unittest
+from datetime import date
+from decimal import Decimal as D
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+
+
+def tabela_temp(conteudo, cabecalho="data,moeda,taxa\n"):
+    fd, caminho = tempfile.mkstemp(suffix=".csv")
+    with os.fdopen(fd, "w", encoding="utf-8") as f:
+        f.write(cabecalho + conteudo)
+    return caminho
+
+
+class TestCambio(unittest.TestCase):
+    def setUp(self):
+        self.t = TabelaCambio.carregar(tabela_temp(
+            '05/03/2026,USD,"5,0870"\n'
+            '02/03/2026,USD,"5,0125"\n'   # fora de ordem de propósito
+            '02/03/2026,EUR,"5,4410"\n'
+        ))
+
+    def test_taxa_da_propria_data(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 2)), D("5.0125"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 5)), D("5.0870"))
+
+    def test_usa_data_anterior_mais_recente(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 4)), D("5.0125"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 12, 31)), D("5.0870"))
+
+    def test_moeda_sem_diferenciar_maiusculas(self):
+        self.assertEqual(self.t.taxa("eur", date(2026, 3, 3)), D("5.4410"))
+
+    def test_brl_sempre_um(self):
+        self.assertEqual(self.t.taxa("BRL", date(1990, 1, 1)), D(1))
+        self.assertEqual(TabelaCambio().taxa("BRL", date(2026, 1, 1)), D(1))
+
+    def test_sem_taxa_ate_a_data(self):
+        with self.assertRaises(ErroCambio) as c:
+            self.t.taxa("USD", date(2026, 3, 1))
+        self.assertIn("USD", str(c.exception))
+
+    def test_moeda_ausente_na_tabela(self):
+        with self.assertRaises(ErroCambio) as c:
+            TabelaCambio().taxa("EUR", date(2026, 3, 1))
+        self.assertIn("EUR", str(c.exception))
+
+    def test_erro_cambio_e_value_error(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+    def test_arquivo_exemplo(self):
+        t = TabelaCambio.carregar(os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv"))
+        self.assertEqual(t.taxa("EUR", date(2026, 3, 8)), D("5.4410"))
+
+    def test_arquivo_invalido(self):
+        with self.assertRaises(ErroCambio):
+            TabelaCambio.carregar(tabela_temp("2026-03-02,USD,5\n"))
+        with self.assertRaises(ErroCambio):
+            TabelaCambio.carregar(tabela_temp('02/03/2026,USD,"abc"\n'))
+        with self.assertRaises(ErroCambio):
+            TabelaCambio.carregar(tabela_temp("x\n", cabecalho="data,moeda\n"))
+
+
+if __name__ == "__main__":
+    unittest.main()
