+
+    def test_sem_tabela(self):
+        with self.assertRaises(ErroCambio):
+            calcular(self.pedido("USD", [(1, "10", "x")]))
+
+    def test_brl_sem_tabela(self):
+        self.assertEqual(calcular(self.pedido("BRL", [(1, "100", "x")])).subtotal, Decimal("100.00"))
+
+    def test_conversao_por_linha_arredondada(self):
+        # 3 x 1,10 x 5,0870 = 16,7871 -> 16,79 ; 1 x 0,10 x 5,0870 = 0,5087 -> 0,51
+        r = calcular(self.pedido("USD", [(3, "1.10", "x"), (1, "0.10", "x")]), tabela())
+        self.assertEqual(r.subtotal, Decimal("17.30"))
+
+    def test_meio_para_par(self):
+        # 1 x 1 x 5,0125 = 5,0125 -> 5,01 ; 0,5 x 5 = 2,5 em câmbio exato
+        t = TabelaCambio({"USD": {date(2026, 1, 1): Decimal("2.5")}})
+        r = calcular(self.pedido("USD", [(1, "0.01", "x")]), t)  # 0,025 -> 0,02
+        self.assertEqual(r.subtotal, Decimal("0.02"))
+
+    def test_regras_em_reais(self):
+        # 200 USD x 5,0870 = 1017,40 BRL -> desconto 25 + 8% x 17,40 = 26,39
+        r = calcular(self.pedido("USD", [(1, "200", "livros")]), tabela())
+        self.assertEqual(r.subtotal, Decimal("1017.40"))
+        self.assertEqual(r.desconto, Decimal("26.39"))
+        self.assertEqual(r.imposto, Decimal("0.00"))
+        self.assertEqual(r.frete, Decimal("0.00"))
+
+    def test_frete_com_valor_convertido(self):
+        # 70 USD = 356,09 BRL (>= 300 -> frete grátis); 70 BRL pagaria frete
+        self.assertEqual(calcular(self.pedido("USD", [(1, "70", "livros")]), tabela()).frete, Decimal("0.00"))
+        self.assertEqual(calcular(self.pedido("BRL", [(1, "70", "livros")])).frete, Decimal("25.00"))
+
+    def test_taxa_pela_data_do_pedido(self):
+        r = calcular(self.pedido("USD", [(1, "10", "livros")], dia=3), tabela())
+        self.assertEqual(r.subtotal, Decimal("50.12"))  # 50,125 -> par
+
+    def test_faixas_de_desconto_sobre_valor_convertido(self):
+        # 240 USD x 5,0125 = 1203,00 BRL -> 0 + 5% x 500 + 8% x 203 = 25 + 16,24 = 41,24
+        r = calcular(self.pedido("USD", [(1, "240", "x")], dia=2), tabela())
+        self.assertEqual(r.subtotal, Decimal("1203.00"))
+        self.assertEqual(r.desconto, Decimal("41.24"))
+
+
+class TestRelatorioMoedaIntercalado(unittest.TestCase):
+    def test_pedido_estrangeiro_intercalado_vira_um_pedido(self):
+        # Mesmo problema da reclamação de Bruna Reis, agora com moeda: linhas de P-1 separadas
+        c = csv_temp(
+            'P-1,A,02/03/2026,X,1,"120,00",papelaria,USD\n'
+            'P-2,B,02/03/2026,Y,1,"50,00",papelaria,\n'
+            'P-1,A,02/03/2026,Z,1,"120,00",papelaria,usd\n',
+            CAB_MOEDA,
+        )
+        cambio = csv_temp(CAMBIO, "data,moeda,taxa\n")
+        codigo, out, _ = rodar(c, "--cambio", cambio, "--json")
+        self.assertEqual(codigo, 0)
+        d = json.loads(out)
+        self.assertEqual([x["id"] for x in d], ["P-1", "P-2"])
+        self.assertEqual((d[0]["itens"], d[0]["moeda"], d[0]["subtotal_original"]), (2, "USD", "240.00"))
+        # 1203,00 BRL: faixas de desconto (41,24) e frete zero (>= 300)
+        self.assertEqual((d[0]["subtotal"], d[0]["desconto"], d[0]["frete"]), ("1203.00", "41.24", "0.00"))
+        self.assertEqual(d[1]["frete"], "25.00")
+
+
+class TestRelatorioMoeda(unittest.TestCase):
+    def setUp(self):
+        self.csv = csv_temp(
+            'P-1,A,05/03/2026,X,3,"1,10",papelaria,USD\n'
+            'P-2,B,05/03/2026,Y,1,"100,00",livros,\n',
+            CAB_MOEDA,
+        )
+        self.cambio = csv_temp(CAMBIO, "data,moeda,taxa\n")
+
+    def test_json(self):
+        codigo, out, _ = rodar(self.csv, "--cambio", self.cambio, "--json")
+        self.assertEqual(codigo, 0)
+        d = json.loads(out)
+        self.assertEqual((d[0]["moeda"], d[0]["subtotal_original"], d[0]["subtotal"]), ("USD", "3.30", "16.79"))
+        self.assertEqual((d[1]["moeda"], d[1]["subtotal_original"], d[1]["subtotal"]), ("BRL", "100.00", "100.00"))
+
+    def test_texto_tem_moeda(self):
+        codigo, out, _ = rodar(self.csv, "--cambio", self.cambio)
+        self.assertEqual(codigo, 0)
+        self.assertIn("moeda", out.splitlines()[0])
+        self.assertIn("USD", out.splitlines()[1])
+
+    def test_sem_cambio(self):
+        codigo, out, err = rodar(self.csv)
+        self.assertEqual(codigo, 2)
+        self.assertTrue(err.startswith("erro:"))
+
+    def test_taxa_inexistente(self):
+        c = csv_temp('P-1,A,01/03/2026,X,1,"1,00",x,USD\n', CAB_MOEDA)
+        codigo, _, err = rodar(c, "--cambio", self.cambio)
+        self.assertEqual(codigo, 2)
+        self.assertIn("USD", err)
+
+    def test_moeda_invalida_sai_com_2(self):
+        c = csv_temp('P-1,A,01/03/2026,X,1,"1,00",x,GBP\n', CAB_MOEDA)
+        codigo, _, err = rodar(c, "--cambio", self.cambio)
+        self.assertEqual(codigo, 2)
+        self.assertIn("linha 2", err)
+
+    def test_moedas_misturadas_no_pedido_sai_com_2(self):
+        c = csv_temp(
+            'P-1,A,01/03/2026,X,1,"1,00",x,USD\n'
+            'P-1,A,01/03/2026,Y,1,"1,00",x,EUR\n',
+            CAB_MOEDA,
+        )
+        codigo, _, err = rodar(c, "--cambio", self.cambio)
+        self.assertEqual(codigo, 2)
+        self.assertIn("P-1", err)
+
+    def test_so_brl_sem_cambio(self):
+        c = csv_temp('P-1,A,01/03/2026,X,1,"1,00",x\n')
+        self.assertEqual(rodar(c)[0], 0)
+
+    def test_cambio_ausente_ou_invalido(self):
+        self.assertEqual(rodar(self.csv, "--cambio", "/nao/existe.csv")[0], 2)
+        ruim = csv_temp('xx,USD,"1,0"\n', "data,moeda,taxa\n")
+        self.assertEqual(rodar(self.csv, "--cambio", ruim)[0], 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
