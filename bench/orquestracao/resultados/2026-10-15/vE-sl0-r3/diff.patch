+from pedidos.modelo import Item, Pedido
+from pedidos.preco import calcular
+
+from .test_relatorio import rodar
+from .util import csv_temp
+
+CAB_MOEDA = "id,cliente,data,sku,qtd,preco_unit,categoria,moeda\n"
+CAMBIO = (
+    '02/03/2026,USD,"5,0125"\n'
+    '02/03/2026,EUR,"5,4410"\n'
+    '05/03/2026,USD,"5,0870"\n'
+)
+
+
+def tabela():
+    return TabelaCambio.carregar(csv_temp(CAMBIO, "data,moeda,taxa\n"))
+
+
+class TestImportacaoMoeda(unittest.TestCase):
+    def test_sem_coluna_e_brl(self):
+        p = ler_pedidos(csv_temp('P-1,A,01/03/2026,X,1,"10,00",papelaria\n'))[0]
+        self.assertEqual(p.moeda, "BRL")
+
+    def test_celula_vazia_e_minuscula(self):
+        c = csv_temp(
+            'P-1,A,01/03/2026,X,1,"10,00",papelaria,\n'
+            'P-2,A,01/03/2026,X,1,"10,00",papelaria,usd\n',
+            CAB_MOEDA,
+        )
+        p1, p2 = ler_pedidos(c)
+        self.assertEqual((p1.moeda, p2.moeda), ("BRL", "USD"))
+
+    def test_moeda_invalida_com_linha(self):
+        c = csv_temp(
+            'P-1,A,01/03/2026,X,1,"10,00",papelaria,BRL\n'
+            'P-2,A,01/03/2026,X,1,"10,00",papelaria,GBP\n',
+            CAB_MOEDA,
+        )
+        with self.assertRaisesRegex(ErroImportacao, "linha 3"):
+            ler_pedidos(c)
+
+    def test_moedas_misturadas_no_pedido(self):
+        c = csv_temp(
+            'P-9,A,01/03/2026,X,1,"10,00",papelaria,USD\n'
+            'P-9,A,01/03/2026,Y,1,"10,00",papelaria,EUR\n',
+            CAB_MOEDA,
+        )
+        with self.assertRaisesRegex(ErroImportacao, "P-9"):
+            ler_pedidos(c)
+
+    def test_vazia_e_brl_explicita_misturadas_sao_iguais(self):
+        c = csv_temp(
+            'P-1,A,01/03/2026,X,1,"10,00",papelaria,\n'
+            'P-1,A,01/03/2026,Y,1,"10,00",papelaria,BRL\n',
+            CAB_MOEDA,
+        )
+        self.assertEqual(ler_pedidos(c)[0].moeda, "BRL")
+
+
+class TestIntercaladoMoeda(unittest.TestCase):
+    def test_linhas_intercaladas_usam_data_e_moeda_do_pedido(self):
+        c = csv_temp(
+            'P-1,A,02/03/2026,X,1,"10,00",livros,USD\n'
+            'P-2,B,09/03/2026,Y,1,"10,00",livros,\n'
+            'P-1,A,09/03/2026,Z,1,"10,00",livros,usd\n',
