@@ -0,0 +1,58 @@
+"""Tabela de câmbio (docs/PEDIDO-MULTIMOEDA.md): quantos reais vale 1 unidade da moeda, por data."""
+
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+COLUNAS = ("data", "moeda", "taxa")
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+class TabelaCambio:
+    def __init__(self, taxas: dict[str, dict[date, Decimal]] | None = None):
+        self._datas: dict[str, list[date]] = {}
+        self._taxas: dict[str, dict[date, Decimal]] = {}
+        for moeda, por_data in (taxas or {}).items():
+            self._taxas[moeda.upper()] = dict(por_data)
+            self._datas[moeda.upper()] = sorted(por_data)
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        taxas: dict[str, dict[date, Decimal]] = {}
+        try:
+            with open(caminho, newline="", encoding="utf-8-sig") as f:
+                leitor = csv.DictReader(f)
+                faltando = [c for c in COLUNAS if c not in (leitor.fieldnames or [])]
+                if faltando:
+                    raise ErroCambio(f"câmbio: colunas ausentes: {', '.join(faltando)}")
+                for n, l in enumerate(leitor, start=2):
+                    try:
+                        data = datetime.strptime((l["data"] or "").strip(), "%d/%m/%Y").date()
+                    except ValueError:
+                        raise ErroCambio(f"câmbio, linha {n}: data inválida '{l['data']}'") from None
+                    moeda = (l["moeda"] or "").strip().upper()
+                    texto = (l["taxa"] or "").strip()
+                    try:
+                        taxa = Decimal(texto.replace(",", ".")) if "." not in texto else None
+                    except InvalidOperation:
+                        taxa = None
+                    if not moeda or taxa is None or not taxa.is_finite() or taxa <= 0:
+                        raise ErroCambio(f"câmbio, linha {n}: moeda ou taxa inválida ('{l['moeda']}', '{l['taxa']}')")
+                    taxas.setdefault(moeda, {})[data] = taxa
+        except UnicodeDecodeError as e:
+            raise ErroCambio(f"câmbio: arquivo não está em UTF-8: {e}") from None
+        return cls(taxas)
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        moeda = moeda.strip().upper()
+        if moeda == "BRL":
+            return Decimal(1)
+        datas = self._datas.get(moeda, [])
+        i = bisect_right(datas, data)
+        if i == 0:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} até {data:%d/%m/%Y}")
+        return self._taxas[moeda][datas[i - 1]]
