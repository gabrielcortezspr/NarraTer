@@ -0,0 +1,79 @@
+import os
+import tempfile
+import unittest
+from datetime import date
+from decimal import Decimal
+from pathlib import Path
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+
+from .util import csv_temp
+
+EXEMPLO = Path(__file__).resolve().parent.parent / "dados" / "cambio.csv"
+
+
+class TestCambio(unittest.TestCase):
+    def setUp(self):
+        self.t = TabelaCambio.carregar(EXEMPLO)
+
+    def test_data_exata(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 5)), Decimal("5.0870"))
+        self.assertEqual(self.t.taxa("EUR", date(2026, 3, 2)), Decimal("5.4410"))
+
+    def test_data_anterior_mais_recente(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 4)), Decimal("5.0125"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 12, 31)), Decimal("5.0870"))
+        self.assertEqual(self.t.taxa("EUR", date(2026, 3, 8)), Decimal("5.4410"))
+
+    def test_brl_sempre_um(self):
+        self.assertEqual(self.t.taxa("BRL", date(1990, 1, 1)), Decimal(1))
+        self.assertEqual(TabelaCambio().taxa("brl", date(2026, 3, 1)), Decimal(1))
+
+    def test_moeda_sem_caixa(self):
+        self.assertEqual(self.t.taxa("usd", date(2026, 3, 2)), Decimal("5.0125"))
+
+    def test_antes_da_primeira_data(self):
+        with self.assertRaisesRegex(ErroCambio, "USD"):
+            self.t.taxa("USD", date(2026, 3, 1))
+
+    def test_moeda_sem_nenhuma_taxa(self):
+        with self.assertRaisesRegex(ErroCambio, "EUR"):
+            TabelaCambio.carregar(csv_temp('02/03/2026,USD,"5,00"\n', cabecalho="data,moeda,taxa\n")).taxa(
+                "EUR", date(2026, 3, 2)
+            )
+
+    def test_erro_cambio_e_value_error(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+    def test_arquivo_temporario_fora_de_ordem(self):
+        c = csv_temp('09/03/2026,USD,"6,00"\n02/03/2026,USD,"5,00"\n', cabecalho="data,moeda,taxa\n")
+        t = TabelaCambio.carregar(c)
+        self.assertEqual(t.taxa("USD", date(2026, 3, 8)), Decimal("5.00"))
+        self.assertEqual(t.taxa("USD", date(2026, 3, 9)), Decimal("6.00"))
+
+    def test_arquivo_invalido(self):
+        with self.assertRaisesRegex(ErroCambio, "linha 2"):
+            TabelaCambio.carregar(csv_temp('xx,USD,"5,00"\n', cabecalho="data,moeda,taxa\n"))
+        with self.assertRaises(ErroCambio):
+            TabelaCambio.carregar(csv_temp('02/03/2026,USD,"abc"\n', cabecalho="data,moeda,taxa\n"))
+        with self.assertRaisesRegex(ErroCambio, "colunas"):
+            TabelaCambio.carregar(csv_temp("1,2\n", cabecalho="a,b\n"))
+
+    def test_bom_no_inicio_do_arquivo(self):
+        c = csv_temp('02/03/2026,USD,"5,00"\n', cabecalho="\ufeffdata,moeda,taxa\n")
+        self.assertEqual(TabelaCambio.carregar(c).taxa("USD", date(2026, 3, 2)), Decimal("5.00"))
+
+    def test_arquivo_nao_utf8_vira_erro_cambio(self):
+        fd, c = tempfile.mkstemp(suffix=".csv")
+        with os.fdopen(fd, "wb") as f:
+            f.write("data,moeda,taxa\n02/03/2026,USD,\"5,00\"\xff\n".encode("latin-1"))
+        with self.assertRaisesRegex(ErroCambio, "UTF-8"):
+            TabelaCambio.carregar(c)
+
+    def test_arquivo_inexistente(self):
+        with self.assertRaises(OSError):
+            TabelaCambio.carregar("/nao/existe.csv")
+
