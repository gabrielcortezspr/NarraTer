+"""Tabela de câmbio (docs/PEDIDO-MULTIMOEDA.md). Taxa = quantos reais vale 1 unidade da moeda."""
+
+import csv
+from dataclasses import dataclass, field
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+MOEDA_BASE = "BRL"
+COLUNAS_CAMBIO = ("data", "moeda", "taxa")
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+def _data(texto: str, linha: int) -> date:
+    try:
+        return datetime.strptime(texto.strip(), "%d/%m/%Y").date()
+    except ValueError:
+        raise ErroCambio(f"linha {linha}: data inválida {texto!r}") from None
+
+
+def _taxa(texto: str, linha: int) -> Decimal:
+    try:
+        valor = Decimal(texto.strip().replace(",", "."))
+    except InvalidOperation:
+        raise ErroCambio(f"linha {linha}: taxa inválida {texto!r}") from None
+    if not valor.is_finite() or valor <= 0:
+        raise ErroCambio(f"linha {linha}: taxa deve ser positiva, veio {texto!r}")
+    return valor
+
+
+@dataclass
+class TabelaCambio:
+    # moeda -> [(data, taxa)] ordenado por data
+    _taxas: dict[str, list[tuple[date, Decimal]]] = field(default_factory=dict)
+
+    @classmethod
+    def carregar(cls, caminho) -> "TabelaCambio":
+        taxas: dict[str, list[tuple[date, Decimal]]] = {}
+        with open(caminho, newline="", encoding="utf-8") as f:
+            leitor = csv.DictReader(f)
+            faltando = [c for c in COLUNAS_CAMBIO if c not in (leitor.fieldnames or [])]
+            if faltando:
+                raise ErroCambio(f"colunas ausentes: {', '.join(faltando)}")
+            for linha, registro in enumerate(leitor, start=2):
+                moeda = registro["moeda"].strip().upper()
+                taxas.setdefault(moeda, []).append(
+                    (_data(registro["data"], linha), _taxa(registro["taxa"], linha))
+                )
+        for lista in taxas.values():
+            lista.sort(key=lambda par: par[0])
+        return cls(taxas)
+
+    def taxa(self, moeda: str, data: date) -> Decimal:
+        moeda = moeda.strip().upper()
+        if moeda == MOEDA_BASE:
+            return Decimal(1)
+        # a taxa mais recente que não seja posterior à data pedida
+        candidatas = [t for d, t in self._taxas.get(moeda, []) if d <= data]
+        if not candidatas:
+            raise ErroCambio(f"sem taxa de câmbio para {moeda} até {data:%d/%m/%Y}")
+        return candidatas[-1]
