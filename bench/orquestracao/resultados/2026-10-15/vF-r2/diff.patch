@@ -0,0 +1,80 @@
+import unittest
+from datetime import date
+from decimal import Decimal as D
+from pathlib import Path
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+
+from .util import csv_temp
+
+CAMBIO_CSV = Path(__file__).resolve().parent.parent / "dados" / "cambio.csv"
+CABECALHO = "data,moeda,taxa\n"
+
+
+class TestCarregar(unittest.TestCase):
+    def test_le_arquivo_de_exemplo(self):
+        t = TabelaCambio.carregar(CAMBIO_CSV)
+        self.assertEqual(t.taxa("USD", date(2026, 3, 2)), D("5.0125"))
+        self.assertEqual(t.taxa("EUR", date(2026, 3, 9)), D("5.5005"))
+
+    def test_taxa_com_virgula_decimal(self):
+        t = TabelaCambio.carregar(csv_temp('01/03/2026,USD,"5,0125"\n', CABECALHO))
+        self.assertIsInstance(t.taxa("USD", date(2026, 3, 1)), D)
+        self.assertEqual(t.taxa("USD", date(2026, 3, 1)), D("5.0125"))
+
+    def test_linhas_fora_de_ordem(self):
+        t = TabelaCambio.carregar(csv_temp(
+            '05/03/2026,USD,"5,0870"\n02/03/2026,USD,"5,0125"\n', CABECALHO
+        ))
+        self.assertEqual(t.taxa("USD", date(2026, 3, 4)), D("5.0125"))
+        self.assertEqual(t.taxa("USD", date(2026, 3, 5)), D("5.0870"))
+
+    def test_data_invalida_da_erro_com_linha(self):
+        with self.assertRaises(ErroCambio) as cm:
+            TabelaCambio.carregar(csv_temp('2026-03-02,USD,"5,0125"\n', CABECALHO))
+        self.assertIn("linha 2", str(cm.exception))
+
+    def test_coluna_ausente_da_erro_claro(self):
+        with self.assertRaisesRegex(ErroCambio, "colunas ausentes: taxa"):
+            TabelaCambio.carregar(csv_temp("02/03/2026,USD\n", "data,moeda\n"))
+
+    def test_taxa_invalida_ou_nao_positiva_da_erro(self):
+        for ruim in ['"abc"', '"0,00"', '"-1,5"']:
+            with self.subTest(taxa=ruim):
+                with self.assertRaises(ErroCambio):
+                    TabelaCambio.carregar(csv_temp(f"02/03/2026,USD,{ruim}\n", CABECALHO))
+
+
+class TestTaxa(unittest.TestCase):
+    def setUp(self):
+        self.t = TabelaCambio.carregar(CAMBIO_CSV)
+
+    def test_mesma_data(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 5)), D("5.0870"))
+
+    def test_data_anterior_mais_recente(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 3)), D("5.0125"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 8)), D("5.0870"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 12, 31)), D("5.0870"))
+
+    def test_brl_sempre_um(self):
+        self.assertEqual(self.t.taxa("BRL", date(2026, 3, 2)), D("1"))
+        self.assertEqual(TabelaCambio().taxa("BRL", date(2020, 1, 1)), D("1"))
+
+    def test_moeda_sem_diferenciar_maiusculas(self):
+        self.assertEqual(self.t.taxa("usd", date(2026, 3, 5)), D("5.0870"))
+
+    def test_antes_da_primeira_taxa_da_erro_com_moeda(self):
+        with self.assertRaises(ErroCambio) as cm:
+            self.t.taxa("USD", date(2026, 3, 1))
+        self.assertIn("USD", str(cm.exception))
+        self.assertIsInstance(cm.exception, ValueError)
+
+    def test_moeda_desconhecida_da_erro_com_moeda(self):
+        with self.assertRaises(ErroCambio) as cm:
+            self.t.taxa("GBP", date(2026, 3, 5))
+        self.assertIn("GBP", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
