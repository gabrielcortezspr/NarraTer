+import os
+import tempfile
+import unittest
+from datetime import date
+from decimal import Decimal
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+from pedidos.importa import ErroImportacao, ler_pedidos
+from pedidos.modelo import Item, Pedido
+from pedidos.preco import calcular
+
+from .test_relatorio import rodar
+from .util import csv_temp
+
+CAB = "id,cliente,data,sku,qtd,preco_unit,categoria,moeda\n"
+
+
+def tabela_temp(conteudo):
+    fd, c = tempfile.mkstemp(suffix=".csv")
+    with os.fdopen(fd, "w", encoding="utf-8") as f:
+        f.write("data,moeda,taxa\n" + conteudo)
+    return c
+
+
+CAMBIO = '02/03/2026,USD,"5,0125"\n05/03/2026,USD,"5,0870"\n09/03/2026,EUR,"5,5005"\n'
+
+
+class TestTabela(unittest.TestCase):
+    def setUp(self):
+        self.t = TabelaCambio.carregar(tabela_temp(CAMBIO))
+
+    def test_data_exata_e_anterior(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 2)), Decimal("5.0125"))
+        self.assertEqual(self.t.taxa("usd", date(2026, 3, 4)), Decimal("5.0125"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 20)), Decimal("5.0870"))
+
+    def test_brl_sempre_um(self):
+        self.assertEqual(self.t.taxa("BRL", date(1990, 1, 1)), Decimal(1))
+
+    def test_sem_taxa(self):
+        with self.assertRaises(ErroCambio) as c:
+            self.t.taxa("USD", date(2026, 3, 1))
+        self.assertIn("USD", str(c.exception))
+        with self.assertRaises(ErroCambio):
+            self.t.taxa("EUR", date(2026, 3, 8))
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+
+class TestImportacao(unittest.TestCase):
+    def test_padrao_brl_sem_coluna(self):
+        p = ler_pedidos(csv_temp('P-1,A,01/03/2026,x,1,"1,00",l\n'))
+        self.assertEqual(p[0].moeda, "BRL")
+
+    def test_celula_vazia_e_minuscula(self):
+        c = csv_temp('P-1,A,01/03/2026,x,1,"1,00",l,\nP-2,A,01/03/2026,x,1,"1,00",l,usd\n', CAB)
+        p = ler_pedidos(c)
+        self.assertEqual([x.moeda for x in p], ["BRL", "USD"])
+
+    def test_moeda_invalida(self):
+        c = csv_temp('P-1,A,01/03/2026,x,1,"1,00",l,\nP-2,A,01/03/2026,x,1,"1,00",l,GBP\n', CAB)
+        with self.assertRaises(ErroImportacao) as e:
+            ler_pedidos(c)
+        self.assertIn("3", str(e.exception))
+
+    def test_moedas_misturadas_no_pedido(self):
+        c = csv_temp('P-9,A,01/03/2026,x,1,"1,00",l,USD\nP-9,A,01/03/2026,y,1,"1,00",l,EUR\n', CAB)
+        with self.assertRaises(ErroImportacao) as e:
+            ler_pedidos(c)
+        self.assertIn("P-9", str(e.exception))
+
+    def test_vazia_difere_de_usd(self):
+        c = csv_temp('P-9,A,01/03/2026,x,1,"1,00",l,USD\nP-9,A,01/03/2026,y,1,"1,00",l,\n', CAB)
+        with self.assertRaises(ErroImportacao):
+            ler_pedidos(c)
+
+
+class TestCalculo(unittest.TestCase):
+    def setUp(self):
+        self.t = TabelaCambio.carregar(tabela_temp(CAMBIO))
+
+    def pedido(self, moeda="USD", itens=None):
+        itens = itens or [Item("a", 1, Decimal("100.00"), "x")]
+        return Pedido("P", "c", date(2026, 3, 5), itens, moeda)
+
+    def test_sem_tabela(self):
+        with self.assertRaises(ErroCambio):
+            calcular(self.pedido())
+        self.assertEqual(calcular(self.pedido("BRL")).subtotal, Decimal("100.00"))
+
+    def test_converte_por_linha(self):
+        # 3 x 0,10 x 5,0870 = 1,5261 -> 1,53 ; duas linhas iguais -> 3,06
+        it = [Item("a", 3, Decimal("0.10"), "x")] * 2
+        self.assertEqual(calcular(self.pedido(itens=it), self.t).subtotal, Decimal("3.06"))
+
+    def test_meio_para_par(self):
+        t = TabelaCambio({"USD": {date(2026, 1, 1): Decimal("0.5")}})
+        it = [Item("a", 1, Decimal("0.05"), "x")]  # 0,025 -> 0,02
+        self.assertEqual(calcular(self.pedido(itens=it), t).subtotal, Decimal("0.02"))
+
+    def test_regras_em_reais(self):
+        # 100 USD x 5,0870 = 508,70 -> desconto sobre o excedente de 500 e frete grátis
+        r = calcular(self.pedido(), self.t)
+        self.assertEqual(r.subtotal, Decimal("508.70"))
+        self.assertEqual(r.desconto, Decimal("0.44"))  # 5% x 8,70 = 0,435 -> 0,44 (meio-para-par)
+        self.assertEqual(r.frete, Decimal("0.00"))
+        self.assertEqual(r.imposto, Decimal("60.99"))
+
+
+class TestRelatorio(unittest.TestCase):
+    def setUp(self):
+        self.csv = csv_temp('P-1,A,05/03/2026,x,2,"10,00",l,USD\nP-2,B,05/03/2026,y,1,"10,00",l,\n', CAB)
+        self.cambio = tabela_temp(CAMBIO)
+
+    def test_json(self):
+        codigo, out, _ = rodar(self.csv, "--cambio", self.cambio, "--json")
+        self.assertEqual(codigo, 0)
+        import json
+        d = json.loads(out)
+        self.assertEqual(d[0]["moeda"], "USD")
+        self.assertEqual(d[0]["subtotal_original"], "20.00")
+        self.assertEqual(d[0]["subtotal"], "101.74")
+        self.assertEqual(d[1]["moeda"], "BRL")
+        self.assertEqual(d[1]["subtotal_original"], "10.00")
+
+    def test_texto_tem_moeda(self):
+        codigo, out, _ = rodar(self.csv, "--cambio", self.cambio)
+        self.assertEqual(codigo, 0)
+        self.assertIn("moeda", out.splitlines()[0])
+        self.assertIn("USD", out)
+
+    def test_sem_cambio(self):
+        codigo, _, err = rodar(self.csv)
+        self.assertEqual(codigo, 2)
+        self.assertTrue(err.startswith("erro:"))
+
+    def test_taxa_inexistente(self):
+        c2 = tabela_temp('10/03/2026,USD,"5,00"\n')
+        codigo, _, err = rodar(self.csv, "--cambio", c2)
+        self.assertEqual(codigo, 2)
+        self.assertIn("USD", err)
+
+    def test_so_brl_sem_cambio(self):
+        codigo, _, _ = rodar(csv_temp('P-1,A,01/03/2026,x,1,"1,00",l\n'))
+        self.assertEqual(codigo, 0)
