+import os
+import unittest
+from datetime import date
+from decimal import Decimal
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+
+CAMINHO = os.path.join(os.path.dirname(__file__), "..", "dados", "cambio.csv")
+
+
+class TestCambio(unittest.TestCase):
+    def setUp(self):
+        self.t = TabelaCambio.carregar(CAMINHO)
+
+    def test_data_exata(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 5)), Decimal("5.0870"))
+        self.assertIsInstance(self.t.taxa("USD", date(2026, 3, 5)), Decimal)
+
+    def test_data_anterior(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 4)), Decimal("5.0125"))
+        self.assertEqual(self.t.taxa("EUR", date(2026, 3, 8)), Decimal("5.4410"))
+        self.assertEqual(self.t.taxa("EUR", date(2027, 1, 1)), Decimal("5.5005"))
+
+    def test_antes_de_qualquer_taxa(self):
+        with self.assertRaises(ErroCambio) as c:
+            self.t.taxa("USD", date(2026, 3, 1))
+        self.assertIn("USD", str(c.exception))
+
+    def test_brl(self):
+        self.assertEqual(self.t.taxa("BRL", date(1990, 1, 1)), Decimal(1))
+        self.assertEqual(self.t.taxa("brl", date(2026, 3, 5)), Decimal(1))
+
+    def test_moeda_desconhecida(self):
+        with self.assertRaises(ErroCambio) as c:
+            self.t.taxa("JPY", date(2026, 3, 5))
+        self.assertIn("JPY", str(c.exception))
+        self.assertIsInstance(c.exception, ValueError)
+
+    def test_case_insensitive(self):
+        self.assertEqual(self.t.taxa("usd", date(2026, 3, 5)), Decimal("5.0870"))
+
+
+if __name__ == "__main__":
+    unittest.main()
