+"""Tabela de câmbio: taxas diárias de moedas estrangeiras para reais."""
+import csv
+from bisect import bisect_right
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+
+class ErroCambio(ValueError):
+    pass
+
+
+class TabelaCambio:
+    def __init__(self, taxas=None):
+        # taxas: {MOEDA: [(data, Decimal), ...]} ordenado por data
+        self._taxas = {}
+        for moeda, lista in (taxas or {}).items():
+            self._taxas[moeda.strip().upper()] = sorted(lista)
+
+    @classmethod
+    def carregar(cls, caminho):
+        taxas = {}
+        with open(caminho, newline="", encoding="utf-8") as f:
+            for n, linha in enumerate(csv.DictReader(f), start=2):
+                try:
+                    data = datetime.strptime(linha["data"].strip(), "%d/%m/%Y").date()
+                    moeda = linha["moeda"].strip().upper()
+                    taxa = Decimal(linha["taxa"].strip().replace(",", "."))
+                except (KeyError, AttributeError, ValueError, InvalidOperation):
+                    raise ErroCambio(f"linha {n}: câmbio inválido em {caminho}")
+                if not moeda or not taxa.is_finite() or taxa <= 0:
+                    raise ErroCambio(f"linha {n}: câmbio inválido em {caminho}")
+                taxas.setdefault(moeda, {})[data] = taxa
+        return cls({m: list(d.items()) for m, d in taxas.items()})
+
+    def taxa(self, moeda, data):
+        moeda = moeda.strip().upper()
+        if moeda == "BRL":
+            return Decimal(1)
+        lista = self._taxas.get(moeda)
+        if not lista:
+            raise ErroCambio(f"moeda sem taxa de câmbio: {moeda}")
+        if isinstance(data, datetime):
+            data = data.date()
+        i = bisect_right([d for d, _ in lista], data)
+        if i == 0:
+            raise ErroCambio(f"sem taxa de {moeda} até {data.strftime('%d/%m/%Y')}")
+        return lista[i - 1][1]
