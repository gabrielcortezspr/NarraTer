+import contextlib
+import io
+import json
+import unittest
+from datetime import date
+from decimal import Decimal
+
+from pedidos.cambio import ErroCambio, TabelaCambio
+from pedidos.importa import ErroImportacao, ler_pedidos
+from pedidos.modelo import Item, Pedido
+from pedidos.preco import calcular, subtotal_original
+from pedidos.relatorio import main
+
+from .util import csv_temp
+
+CAB_MOEDA = "id,cliente,data,sku,qtd,preco_unit,categoria,moeda\n"
+CAMBIO = (
+    '02/03/2026,USD,"5,0125"\n02/03/2026,EUR,"5,4410"\n'
+    '05/03/2026,USD,"5,0870"\n09/03/2026,EUR,"5,5005"\n'
+)
+
+
+def tabela():
+    return TabelaCambio.carregar(csv_temp(CAMBIO, "data,moeda,taxa\n"))
+
+
+def rodar(*args):
+    out, err = io.StringIO(), io.StringIO()
+    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+        codigo = main(list(args))
+    return codigo, out.getvalue(), err.getvalue()
+
+
+class TestImportaMoeda(unittest.TestCase):
+    def test_sem_coluna_e_brl(self):
+        p = ler_pedidos(csv_temp('P-1,A,01/03/2026,X,1,"1,00",livros\n'))[0]
+        self.assertEqual(p.moeda, "BRL")
+
+    def test_celula_vazia_e_brl_e_minuscula_vale(self):
+        c = csv_temp('P-1,A,01/03/2026,X,1,"1,00",livros,\nP-2,A,01/03/2026,X,1,"1,00",livros,usd\n', CAB_MOEDA)
+        p1, p2 = ler_pedidos(c)
+        self.assertEqual((p1.moeda, p2.moeda), ("BRL", "USD"))
+
+    def test_moeda_invalida_cita_linha(self):
+        c = csv_temp('P-1,A,01/03/2026,X,1,"1,00",livros,GBP\n', CAB_MOEDA)
+        with self.assertRaisesRegex(ErroImportacao, "linha 2"):
+            ler_pedidos(c)
+
+    def test_moedas_misturadas_no_pedido_citam_id(self):
+        c = csv_temp(
+            'P-9,A,01/03/2026,X,1,"1,00",livros,USD\nP-9,A,01/03/2026,Y,1,"1,00",livros,EUR\n', CAB_MOEDA
+        )
+        with self.assertRaisesRegex(ErroImportacao, "P-9"):
+            ler_pedidos(c)
+
+    def test_brl_explicito_e_vazio_no_mesmo_pedido_sao_iguais(self):
+        c = csv_temp(
+            'P-9,A,01/03/2026,X,1,"1,00",livros,BRL\nP-9,A,01/03/2026,Y,1,"1,00",livros,\n', CAB_MOEDA
+        )
+        self.assertEqual(ler_pedidos(c)[0].moeda, "BRL")
+
+
+class TestTabelaCambio(unittest.TestCase):
+    def test_data_exata_e_anterior_mais_recente(self):
+        t = tabela()
+        self.assertEqual(t.taxa("USD", date(2026, 3, 2)), Decimal("5.0125"))
+        self.assertEqual(t.taxa("USD", date(2026, 3, 4)), Decimal("5.0125"))
+        self.assertEqual(t.taxa("USD", date(2026, 3, 5)), Decimal("5.0870"))
+        self.assertEqual(t.taxa("usd", date(2026, 4, 1)), Decimal("5.0870"))
+        self.assertEqual(t.taxa("EUR", date(2026, 3, 8)), Decimal("5.4410"))
+
+    def test_brl_e_sempre_um(self):
+        self.assertEqual(tabela().taxa("BRL", date(1990, 1, 1)), Decimal(1))
+
+    def test_sem_taxa_ate_a_data(self):
+        with self.assertRaisesRegex(ErroCambio, "USD"):
+            tabela().taxa("USD", date(2026, 3, 1))
+
+    def test_moeda_sem_nenhuma_taxa(self):
+        with self.assertRaisesRegex(ErroCambio, "JPY"):
+            tabela().taxa("JPY", date(2026, 3, 9))
+
+    def test_erro_cambio_e_value_error(self):
+        self.assertTrue(issubclass(ErroCambio, ValueError))
+
+    def test_arquivo_exemplo(self):
+        self.assertEqual(TabelaCambio.carregar("dados/cambio.csv").taxa("EUR", date(2026, 3, 9)), Decimal("5.5005"))
+
+    def test_taxa_invalida(self):
+        with self.assertRaises(ErroCambio):
+            TabelaCambio.carregar(csv_temp('02/03/2026,USD,"abc"\n', "data,moeda,taxa\n"))
+
+
+def pedido(moeda, itens, d=date(2026, 3, 5)):
+    return Pedido("P", "A", d, [Item(*i) for i in itens], moeda)
+
+
+class TestPrecoMoeda(unittest.TestCase):
+    def test_conversao_por_linha(self):
+        # 3 x 10,01 x 5,0870 = 152,7... ; 1 x 0,10 x 5,0870 = 0,51 (arredondada por linha)
+        p = pedido("USD", [("A", 3, Decimal("10.01"), "papelaria"), ("B", 1, Decimal("0.10"), "livros")])
+        r = calcular(p, tabela())
+        self.assertEqual(r.subtotal, Decimal("152.76") + Decimal("0.51"))
+
+    def test_meio_para_par_na_conversao(self):
+        t = TabelaCambio({"USD": [(date(2026, 1, 1), Decimal("2.5"))]})
+        # 0,01 x 2,5 = 0,025 -> 0,02 ; 0,03 x 2,5 = 0,075 -> 0,08
+        r = calcular(pedido("USD", [("A", 1, Decimal("0.01"), "livros"), ("B", 1, Decimal("0.03"), "livros")]), t)
+        self.assertEqual(r.subtotal, Decimal("0.10"))
+
+    def test_regras_em_reais_sobre_valor_convertido(self):
+        # 200 USD x 5,0870 = 1017,40 BRL: desconto 25 + 8% x 17,40 = 26,39 (1,392 -> 1,39)
+        r = calcular(pedido("USD", [("A", 1, Decimal("200"), "papelaria")]), tabela())
+        self.assertEqual(r.subtotal, Decimal("1017.40"))
+        self.assertEqual(r.desconto, Decimal("26.39"))
+        self.assertEqual(r.frete, Decimal("0.00"))  # 991,01 >= 300
+
+    def test_frete_cobrado_abaixo_de_300_reais(self):
+        # 50 USD = 254,35 BRL (< 300 em reais, apesar de 50 < 300 em dólares tambem)
+        r = calcular(pedido("USD", [("A", 1, Decimal("50"), "papelaria")]), tabela())
+        self.assertEqual(r.frete, Decimal("25.00"))
+        # 60 USD = 305,22 BRL: frete grátis só porque está em reais
+        r = calcular(pedido("USD", [("A", 1, Decimal("60"), "papelaria")]), tabela())
+        self.assertEqual(r.frete, Decimal("0.00"))
+
+    def test_estrangeiro_sem_tabela(self):
+        with self.assertRaises(ErroCambio):
+            calcular(pedido("EUR", [("A", 1, Decimal("1"), "livros")]))
+
+    def test_brl_sem_tabela(self):
+        r = calcular(pedido("BRL", [("A", 1, Decimal("100"), "papelaria")]))
+        self.assertEqual(r.total, Decimal("137.00"))
