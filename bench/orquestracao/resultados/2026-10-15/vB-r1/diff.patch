+
+CAB = "id,cliente,data,sku,qtd,preco_unit,categoria,moeda\n"
+CAMBIO = csv_temp(
+    '02/03/2026,USD,"5,0125"\n02/03/2026,EUR,"5,4410"\n05/03/2026,USD,"5,0870"\n',
+    "data,moeda,taxa\n",
+)
+
+
+class TestCambio(unittest.TestCase):
+    def setUp(self):
+        self.t = TabelaCambio.carregar(CAMBIO)
+
+    def test_data_exata_e_anterior(self):
+        self.assertEqual(self.t.taxa("USD", date(2026, 3, 2)), Decimal("5.0125"))
+        self.assertEqual(self.t.taxa("usd", date(2026, 3, 4)), Decimal("5.0125"))
+        self.assertEqual(self.t.taxa("USD", date(2026, 4, 1)), Decimal("5.0870"))
+
+    def test_brl_sempre_1(self):
+        self.assertEqual(self.t.taxa("BRL", date(2000, 1, 1)), Decimal(1))
+
+    def test_sem_taxa(self):
+        with self.assertRaises(ErroCambio) as c:
+            self.t.taxa("USD", date(2026, 3, 1))
+        self.assertIn("USD", str(c.exception))
+        with self.assertRaises(ErroCambio):
+            self.t.taxa("EUR", date(2026, 3, 1))
+
+
+class TestImportaMoeda(unittest.TestCase):
+    def test_padrao_brl_sem_coluna(self):
+        c = csv_temp('P,A,01/03/2026,x,1,"1,00",l\n')
+        self.assertEqual(ler_pedidos(c)[0].moeda, "BRL")
+
+    def test_celula_vazia_e_minuscula(self):
+        c = csv_temp('P,A,01/03/2026,x,1,"1,00",l,\nQ,A,01/03/2026,x,1,"1,00",l,usd\n', CAB)
+        self.assertEqual([p.moeda for p in ler_pedidos(c)], ["BRL", "USD"])
+
+    def test_moeda_invalida_com_linha(self):
+        c = csv_temp('P,A,01/03/2026,x,1,"1,00",l,GBP\n', CAB)
+        with self.assertRaisesRegex(ErroImportacao, "linha 2"):
+            ler_pedidos(c)
+
+    def test_moedas_misturadas_intercaladas(self):
+        c = csv_temp(
+            'P-9,A,01/03/2026,x,1,"1,00",l,USD\nQ,A,01/03/2026,x,1,"1,00",l,BRL\n'
+            'P-9,A,01/03/2026,y,1,"1,00",l,EUR\n',
+            CAB,
+        )
+        with self.assertRaisesRegex(ErroImportacao, "P-9"):
+            ler_pedidos(c)
+
+    def test_linhas_intercaladas_formam_um_pedido(self):
+        c = csv_temp(
+            'P,A,01/03/2026,x,1,"1,00",l,USD\nQ,A,01/03/2026,x,1,"1,00",l\n'
+            'P,A,01/03/2026,y,1,"1,00",l,usd\n',
+            CAB,
+        )
+        ps = ler_pedidos(c)
+        self.assertEqual([(p.id, len(p.itens)) for p in ps], [("P", 2), ("Q", 1)])
+
+
+class TestPrecoMoeda(unittest.TestCase):
