+        d = json.loads(out)[0]
+        self.assertEqual(d["moeda"], "USD")
+        self.assertEqual(d["subtotal_original"], "200.00")
+        self.assertEqual(d["subtotal"], "1002.50")
+
+    def test_texto_mostra_moeda(self):
+        _, out, _ = rodar(self.csv, "--cambio", CAMBIO)
+        self.assertIn("USD", out)
+
+    def test_sem_cambio(self):
+        codigo, _, err = rodar(self.csv)
+        self.assertEqual(codigo, 2)
+        self.assertTrue(err.startswith("erro: "))
+
+    def test_taxa_inexistente(self):
+        c = csv_temp('P,A,01/01/2026,x,1,"1,00",l,USD\n', CAB)
+        codigo, _, err = rodar(c, "--cambio", CAMBIO)
+        self.assertEqual(codigo, 2)
+        self.assertIn("USD", err)
+
+    def test_cambio_ausente(self):
+        self.assertEqual(rodar(self.csv, "--cambio", "/nao/existe.csv")[0], 2)
+
+    def test_brl_sem_cambio(self):
+        c = csv_temp('P,A,03/03/2026,x,1,"10,00",l\n')
+        self.assertEqual(rodar(c, "--json")[0], 0)
+
+
+def cambio_temp(conteudo):
+    return csv_temp(conteudo, "data,moeda,taxa\n")
+
+
+class TestRegressoesRevisao(unittest.TestCase):
+    """Revisão cruzada: valores não finitos, taxa com ponto e taxa duplicada."""
+
+    def test_taxa_com_ponto_recusada(self):
+        with self.assertRaisesRegex(ErroCambio, "vírgula"):
+            TabelaCambio.carregar(cambio_temp('02/03/2026,USD,"5.0125"\n'))
+
+    def test_taxa_nan_e_infinita_recusadas(self):
+        for taxa in ("NaN", "Infinity", "-Infinity"):
+            with self.subTest(taxa=taxa):
+                with self.assertRaises(ErroCambio):
